From 737330889997f3782619e909b1226958d49115b4 Mon Sep 17 00:00:00 2001
From: scada <scada@noreply.codeberg.org>
Date: Wed, 28 Oct 2026 22:04:26 +0400
Subject: [PATCH 51/53] net: qrtr: look up nodes without the global node mutex

Broadcasts hold qrtr_node_lock while calling into transports that can
sleep waiting for a remote processor, which stalled unicast lookups (and
Wi-Fi bring-up) behind it. The radix tree is protected by its spinlock and
release removes every entry under it, so use kref_get_unless_zero instead.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0144VMKxYe33NKa3LLPZNivr
---
 net/qrtr/af_qrtr.c | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/net/qrtr/af_qrtr.c b/net/qrtr/af_qrtr.c
index b703e4c64585..224dd939cef0 100644
--- a/net/qrtr/af_qrtr.c
+++ b/net/qrtr/af_qrtr.c
@@ -199,8 +199,8 @@ static void __qrtr_node_release(struct kref *kref)
 /* Increment reference to node. */
 static struct qrtr_node *qrtr_node_acquire(struct qrtr_node *node)
 {
-	if (node)
-		kref_get(&node->ref);
+	if (node && !kref_get_unless_zero(&node->ref))
+		return NULL;
 	return node;
 }
 
@@ -391,12 +391,16 @@ static struct qrtr_node *qrtr_node_lookup(unsigned int nid)
 	struct qrtr_node *node;
 	unsigned long flags;
 
-	mutex_lock(&qrtr_node_lock);
+	/* Broadcasts hold qrtr_node_lock while calling endpoint transports,
+	 * which may sleep waiting for a remote processor. Unicast lookups only
+	 * need the radix-tree lock: release removes every entry under this lock
+	 * before freeing the node. Do not resurrect a node whose final release
+	 * has already started.
+	 */
 	spin_lock_irqsave(&qrtr_nodes_lock, flags);
 	node = radix_tree_lookup(&qrtr_nodes, nid);
 	node = qrtr_node_acquire(node);
 	spin_unlock_irqrestore(&qrtr_nodes_lock, flags);
-	mutex_unlock(&qrtr_node_lock);
 
 	return node;
 }
