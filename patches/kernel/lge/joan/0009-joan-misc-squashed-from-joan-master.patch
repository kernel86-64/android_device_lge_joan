From cefe7e05a8b8fb7fc0d3831b5df99a9b68ad7d20 Mon Sep 17 00:00:00 2001
From: scada <scada@noreply.codeberg.org>
Date: Thu, 22 Oct 2026 16:57:03 +0000
Subject: [PATCH 09/53] joan: misc (squashed from joan/master)

---
 drivers/mmc/core/queue.c     |  1 +
 drivers/mmc/host/sdhci-msm.c | 11 +++++++++++
 include/linux/input/stmfts.h | 20 ++++++++++++++++++++
 include/linux/phy/phy-dp.h   | 10 ++++++++++
 4 files changed, 42 insertions(+)
 create mode 100644 include/linux/input/stmfts.h

diff --git a/drivers/mmc/core/queue.c b/drivers/mmc/core/queue.c
index eb1053d8cae7..b7c5ee85302f 100644
--- a/drivers/mmc/core/queue.c
+++ b/drivers/mmc/core/queue.c
@@ -295,6 +295,7 @@ static blk_status_t mmc_mq_queue_rq(struct blk_mq_hw_ctx *hctx,
 
 	if (!(req->rq_flags & RQF_DONTPREP)) {
 		req_to_mmc_queue_req(req)->retries = 0;
+		req_to_mmc_queue_req(req)->flags = 0;
 		req->rq_flags |= RQF_DONTPREP;
 	}
 
diff --git a/drivers/mmc/host/sdhci-msm.c b/drivers/mmc/host/sdhci-msm.c
index 3b85233131b3..e75af59deac3 100644
--- a/drivers/mmc/host/sdhci-msm.c
+++ b/drivers/mmc/host/sdhci-msm.c
@@ -2424,6 +2424,16 @@ static const struct sdhci_msm_variant_info sdhci_msm_mci_var = {
 	.offset = &sdhci_msm_mci_offset,
 };
 
+/*
+ * MSM8998 loses the SDR DLL configuration when runtime PM gates the core
+ * clock, the same as SDM845, so the tuned phase has to be put back on resume.
+ */
+static const struct sdhci_msm_variant_info msm8998_sdhci_var = {
+	.restore_dll_config = true,
+	.var_ops = &mci_var_ops,
+	.offset = &sdhci_msm_mci_offset,
+};
+
 static const struct sdhci_msm_variant_info sdhci_msm_v5_var = {
 	.mci_removed = true,
 	.var_ops = &v5_var_ops,
@@ -2444,6 +2454,7 @@ static const struct of_device_id sdhci_msm_dt_match[] = {
 	 */
 	{.compatible = "qcom,sdhci-msm-v4", .data = &sdhci_msm_mci_var},
 	{.compatible = "qcom,sdhci-msm-v5", .data = &sdhci_msm_v5_var},
+	{.compatible = "qcom,msm8998-sdhci", .data = &msm8998_sdhci_var},
 	{.compatible = "qcom,sdm670-sdhci", .data = &sdm845_sdhci_var},
 	{.compatible = "qcom,sdm845-sdhci", .data = &sdm845_sdhci_var},
 	{.compatible = "qcom,sc7180-sdhci", .data = &sdm845_sdhci_var},
diff --git a/include/linux/input/stmfts.h b/include/linux/input/stmfts.h
new file mode 100644
index 000000000000..83cf785a4ce4
--- /dev/null
+++ b/include/linux/input/stmfts.h
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Interface the LG SW43402 panel driver uses to power the ST FTS touch
+ * controller together with the display (see stmfts_set_power()).
+ */
+#ifndef _LINUX_INPUT_STMFTS_H
+#define _LINUX_INPUT_STMFTS_H
+
+#include <linux/kconfig.h>
+#include <linux/types.h>
+
+struct i2c_client;
+
+#if IS_REACHABLE(CONFIG_TOUCHSCREEN_STMFTS)
+void stmfts_set_power(struct i2c_client *client, bool on);
+#else
+static inline void stmfts_set_power(struct i2c_client *client, bool on) { }
+#endif
+
+#endif /* _LINUX_INPUT_STMFTS_H */
diff --git a/include/linux/phy/phy-dp.h b/include/linux/phy/phy-dp.h
index 9cce5766bc0b..8a40630651d4 100644
--- a/include/linux/phy/phy-dp.h
+++ b/include/linux/phy/phy-dp.h
@@ -93,6 +93,16 @@ struct phy_configure_opts_dp {
 	 *
 	 */
 	u8 set_voltages : 1;
+
+	/**
+	 * @lanes_reversed:
+	 *
+	 * The Type-C plug is flipped and the PHY leaves the lane swap to
+	 * the controller, which must mirror its logical lane map. Output
+	 * of phy_validate(); PHYs that swap lanes themselves leave it
+	 * clear.
+	 */
+	u8 lanes_reversed : 1;
 };
 
 #endif /* __PHY_DP_H_ */
-- 
2.55.0

