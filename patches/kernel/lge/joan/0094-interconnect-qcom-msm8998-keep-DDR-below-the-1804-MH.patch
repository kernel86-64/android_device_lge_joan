From 6c03379ae2177516b69866aa5bb9b35cf3c6ad38 Mon Sep 17 00:00:00 2001
From: Lance <Gero3977@gmail.com>
Date: Tue, 3 Nov 2026 01:16:48 -0800
Subject: [PATCH 14/22] interconnect: qcom: msm8998: keep DDR below the 1804
 MHz step

The CPU bandwidth monitor made that step part of every boot. Until
sync_state() the provider holds the INT_MAX initial vote, i.e. DDR at
its top step; with the monitor node in the DT, sync_state() waits for
icc-bwmon, which loads as a module about 11.5 s in, after ten seconds of
boot traffic at 1804 MHz, and then drops DDR to the real votes. With the
monitor, 2 of 14 boots died right there (journald's last entries at
9.8 s, then a panic or reset into the bootloader's default OS); with the
monitor blocked, 20 of 20 came up, but DDR then stayed at INT_MAX
because sync_state() never ran.

Let an RPM provider cap the bus clock it requests, applied after the
INT_MAX clamp so the initial votes are covered too, and cap msm8998's
BIMC at 1555000 kHz: the 1555 MHz step that the per-OPP GPU votes
(12440 MB/s over the 8-byte EBI) already ask for. That is also the
highest step any voter here uses; the vendor GPU table's 1804 MHz entries
are held at 1555 MHz in the GPU OPP table for the same reason.

Signed-off-by: Lance <Gero3977@gmail.com>
Assisted-by: Claude-Code:claude-opus-5-5
---
 drivers/interconnect/qcom/icc-rpm.c | 6 ++++++
 drivers/interconnect/qcom/icc-rpm.h | 7 +++++++
 drivers/interconnect/qcom/msm8998.c | 7 +++++++
 3 files changed, 20 insertions(+)

diff --git a/drivers/interconnect/qcom/icc-rpm.c b/drivers/interconnect/qcom/icc-rpm.c
index ea1042d38..f0377259a 100644
--- a/drivers/interconnect/qcom/icc-rpm.c
+++ b/drivers/interconnect/qcom/icc-rpm.c
@@ -394,6 +394,11 @@ static int qcom_icc_set(struct icc_node *src, struct icc_node *dst)
 	active_rate = min_t(u64, active_rate, INT_MAX);
 	sleep_rate = min_t(u64, sleep_rate, INT_MAX);
 
+	if (qp->bus_clk_max_rate) {
+		active_rate = min_t(u64, active_rate, qp->bus_clk_max_rate);
+		sleep_rate = min_t(u64, sleep_rate, qp->bus_clk_max_rate);
+	}
+
 	if (active_rate != qp->bus_clk_rate[QCOM_SMD_RPM_ACTIVE_STATE]) {
 		ret = qcom_icc_rpm_set_bus_rate(qp->bus_clk_desc, QCOM_SMD_RPM_ACTIVE_STATE,
 						active_rate);
@@ -482,6 +487,7 @@ int qnoc_probe(struct platform_device *pdev)
 		return -ENOMEM;
 
 	qp->intf_clks = devm_kcalloc(dev, cd_num, sizeof(*qp->intf_clks), GFP_KERNEL);
+	qp->bus_clk_max_rate = desc->bus_clk_max_rate;
 	if (!qp->intf_clks)
 		return -ENOMEM;
 
diff --git a/drivers/interconnect/qcom/icc-rpm.h b/drivers/interconnect/qcom/icc-rpm.h
index 94fcae403..b8e346659 100644
--- a/drivers/interconnect/qcom/icc-rpm.h
+++ b/drivers/interconnect/qcom/icc-rpm.h
@@ -62,6 +62,7 @@ struct qcom_icc_provider {
 	u16 ab_coeff;
 	u16 ib_coeff;
 	u32 bus_clk_rate[QCOM_SMD_RPM_STATE_NUM];
+	u32 bus_clk_max_rate;
 	const struct rpm_clk_resource *bus_clk_desc;
 	struct clk *bus_clk;
 	struct clk_bulk_data *intf_clks;
@@ -133,6 +134,12 @@ struct qcom_icc_desc {
 	size_t num_intf_clocks;
 	bool keep_alive;
 	enum qcom_icc_type type;
+	/*
+	 * Highest bus clock (kHz) to request from the RPM, 0 for no limit:
+	 * keeps an unstable top step out of reach, including the INT_MAX
+	 * initial vote held until sync_state().
+	 */
+	u32 bus_clk_max_rate;
 	const struct regmap_config *regmap_cfg;
 	unsigned int qos_offset;
 	u16 ab_coeff;
diff --git a/drivers/interconnect/qcom/msm8998.c b/drivers/interconnect/qcom/msm8998.c
index 178927e69..e39842db7 100644
--- a/drivers/interconnect/qcom/msm8998.c
+++ b/drivers/interconnect/qcom/msm8998.c
@@ -1758,6 +1758,13 @@ static const struct regmap_config msm8998_bimc_regmap_config = {
 static const struct qcom_icc_desc msm8998_bimc = {
 	.regmap_cfg = &msm8998_bimc_regmap_config,
 	.qos_offset = 0x8000,
+	/*
+	 * DDR at the 1804 MHz step cannot be left reliably: stepping down from
+	 * it after sustained traffic hangs the SoC. Stop at the 1555 MHz step
+	 * (12440 MB/s over the 8-byte EBI), which also covers the INT_MAX
+	 * initial vote held until sync_state().
+	 */
+	.bus_clk_max_rate = 1555000,
 	.type = QCOM_ICC_BIMC,
 	.nodes = bimc_nodes,
 	.num_nodes = ARRAY_SIZE(bimc_nodes),
-- 
