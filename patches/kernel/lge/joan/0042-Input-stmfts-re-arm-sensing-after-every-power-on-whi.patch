From f10abc4df3761cbc5ed6790ecae6bdde2ddacbce Mon Sep 17 00:00:00 2001
From: scada <scada@noreply.codeberg.org>
Date: Sat, 24 Oct 2026 08:40:34 +0000
Subject: [PATCH 42/80] Input: stmfts - re-arm sensing after every power-on
 while open

stmfts_power_on() ends with SLEEP_IN and relies on input open to send
MS_MT_SENSE_ON. On Android the evdev is opened once and stays open, while
the panel driver powers the controller off at blank and on at unblank
(24252fe550c3), so after the first screen-off the controller came back
asleep and touch stayed dead with the rest of the phone working. The
same applied to system resume.

Factor the sensing commands out of input open and issue them after the
panel-driven power-on and after system resume whenever the device is
open.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0144VMKxYe33NKa3LLPZNivr
---
 drivers/input/touchscreen/stmfts.c | 65 +++++++++++++++++++-----------
 1 file changed, 41 insertions(+), 24 deletions(-)

diff --git a/drivers/input/touchscreen/stmfts.c b/drivers/input/touchscreen/stmfts.c
index 2df159f300e1..1a9cecfbf669 100644
--- a/drivers/input/touchscreen/stmfts.c
+++ b/drivers/input/touchscreen/stmfts.c
@@ -459,6 +459,33 @@ static int stmfts_command(struct stmfts_data *sdata, const u8 cmd)
 	return 0;
 }
 
+/*
+ * Turn on the sensing the controller needs for an open input device. The
+ * power-on sequence ends with SLEEP_IN, so this has to follow every power-on
+ * while the device is open, not just the first open: on Android the evdev
+ * stays open across blank/unblank, and the panel driver repowers the
+ * controller at each unblank.
+ */
+static int stmfts_start_sensing(struct stmfts_data *sdata)
+{
+	int err;
+
+	err = i2c_smbus_write_byte(sdata->client, STMFTS_MS_MT_SENSE_ON);
+	if (err)
+		return err;
+
+	if (sdata->hover_enabled &&
+	    i2c_smbus_write_byte(sdata->client, STMFTS_SS_HOVER_SENSE_ON))
+		dev_warn(&sdata->client->dev, "failed to enable hover\n");
+
+	/* I can still use only the touch screen */
+	if (sdata->use_key &&
+	    i2c_smbus_write_byte(sdata->client, STMFTS_MS_KEY_SENSE_ON))
+		dev_warn(&sdata->client->dev, "failed to enable touchkey\n");
+
+	return 0;
+}
+
 static int stmfts_input_open(struct input_dev *dev)
 {
 	struct stmfts_data *sdata = input_get_drvdata(dev);
@@ -468,33 +495,15 @@ static int stmfts_input_open(struct input_dev *dev)
 	if (err)
 		return err;
 
-	err = i2c_smbus_write_byte(sdata->client, STMFTS_MS_MT_SENSE_ON);
+	err = stmfts_start_sensing(sdata);
 	if (err) {
 		pm_runtime_put_sync(&sdata->client->dev);
 		return err;
 	}
 
-	scoped_guard(mutex, &sdata->mutex) {
+	scoped_guard(mutex, &sdata->mutex)
 		sdata->running = true;
 
-		if (sdata->hover_enabled) {
-			err = i2c_smbus_write_byte(sdata->client,
-						   STMFTS_SS_HOVER_SENSE_ON);
-			if (err)
-				dev_warn(&sdata->client->dev,
-					 "failed to enable hover\n");
-		}
-	}
-
-	if (sdata->use_key) {
-		err = i2c_smbus_write_byte(sdata->client,
-					   STMFTS_MS_KEY_SENSE_ON);
-		if (err)
-			/* I can still use only the touch screen */
-			dev_warn(&sdata->client->dev,
-				 "failed to enable touchkey\n");
-	}
-
 	return 0;
 }
 
@@ -970,10 +979,13 @@ void stmfts_set_power(struct i2c_client *client, bool on)
 	if (!sdata)
 		return;
 
-	if (on)
-		stmfts_power_on(sdata);
-	else
+	if (!on) {
 		stmfts_power_off(sdata);
+		return;
+	}
+
+	if (!stmfts_power_on(sdata) && sdata->running)
+		stmfts_start_sensing(sdata);
 }
 EXPORT_SYMBOL_GPL(stmfts_set_power);
 
@@ -1180,8 +1192,13 @@ static int stmfts_suspend(struct device *dev)
 static int stmfts_resume(struct device *dev)
 {
 	struct stmfts_data *sdata = dev_get_drvdata(dev);
+	int err;
 
-	return stmfts_power_on(sdata);
+	err = stmfts_power_on(sdata);
+	if (!err && sdata->running)
+		err = stmfts_start_sensing(sdata);
+
+	return err;
 }
 
 static const struct dev_pm_ops stmfts_pm_ops = {
