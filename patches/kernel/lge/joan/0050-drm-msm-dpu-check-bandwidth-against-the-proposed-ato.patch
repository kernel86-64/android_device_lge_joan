From ed4ba0aeecae568e013eeff10dbbd3b7c596d5bb Mon Sep 17 00:00:00 2001
From: scada <scada@noreply.codeberg.org>
Date: Wed, 28 Oct 2026 22:04:25 +0400
Subject: [PATCH 50/80] drm/msm/dpu: check bandwidth against the proposed
 atomic state

Compute plane fetch bandwidth and clock in atomic_check from the new plane
state, sum the proposed states of all active CRTCs under their locks, and
take the bandwidth reference at kickoff rather than in atomic_check, which
TEST_ONLY commits leaked. Also skip dev_pm_opp_set_rate(0) on CRTC
disable (upstream 811c38907eab).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0144VMKxYe33NKa3LLPZNivr
---
 drivers/gpu/drm/msm/disp/dpu1/dpu_core_perf.c | 51 ++++++++++++++-----
 drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c      |  5 +-
 drivers/gpu/drm/msm/disp/dpu1/dpu_plane.c     | 36 ++++++++-----
 3 files changed, 64 insertions(+), 28 deletions(-)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_core_perf.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_core_perf.c
index 13cc658065c5..3e536020157b 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_core_perf.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_core_perf.c
@@ -54,21 +54,22 @@ u64 dpu_core_perf_adjusted_mode_clk(u64 mode_clk_rate,
 /**
  * _dpu_core_perf_calc_bw() - to calculate BW per crtc
  * @perf_cfg: performance configuration
- * @crtc: pointer to a crtc
+ * @state: proposed crtc state
  * Return: returns aggregated BW for all planes in crtc.
  */
 static u64 _dpu_core_perf_calc_bw(const struct dpu_perf_cfg *perf_cfg,
-		struct drm_crtc *crtc)
+		struct drm_crtc_state *state)
 {
 	struct drm_plane *plane;
+	const struct drm_plane_state *plane_state;
 	struct dpu_plane_state *pstate;
 	u64 crtc_plane_bw = 0;
 	u32 bw_factor;
 
-	drm_atomic_crtc_for_each_plane(plane, crtc) {
-		pstate = to_dpu_plane_state(plane->state);
-		if (!pstate)
+	drm_atomic_crtc_state_for_each_plane_state(plane, plane_state, state) {
+		if (!plane_state->visible)
 			continue;
+		pstate = to_dpu_plane_state(plane_state);
 
 		crtc_plane_bw += pstate->plane_fetch_bw;
 	}
@@ -93,6 +94,7 @@ static u64 _dpu_core_perf_calc_clk(const struct dpu_perf_cfg *perf_cfg,
 		struct drm_crtc *crtc, struct drm_crtc_state *state)
 {
 	struct drm_plane *plane;
+	const struct drm_plane_state *plane_state;
 	struct dpu_plane_state *pstate;
 	struct drm_display_mode *mode;
 	u64 mode_clk;
@@ -101,10 +103,10 @@ static u64 _dpu_core_perf_calc_clk(const struct dpu_perf_cfg *perf_cfg,
 
 	mode_clk = (u64)mode->vtotal * mode->hdisplay * drm_mode_vrefresh(mode);
 
-	drm_atomic_crtc_for_each_plane(plane, crtc) {
-		pstate = to_dpu_plane_state(plane->state);
-		if (!pstate)
+	drm_atomic_crtc_state_for_each_plane_state(plane, plane_state, state) {
+		if (!plane_state->visible)
 			continue;
+		pstate = to_dpu_plane_state(plane_state);
 
 		mode_clk = max(pstate->plane_clk, mode_clk);
 	}
@@ -131,7 +133,7 @@ static void _dpu_core_perf_calc_crtc(const struct dpu_core_perf *core_perf,
 		return;
 	}
 
-	perf->bw_ctl = _dpu_core_perf_calc_bw(perf_cfg, crtc);
+	perf->bw_ctl = _dpu_core_perf_calc_bw(perf_cfg, state);
 	perf->max_per_pipe_ib = perf_cfg->min_dram_ib;
 	perf->core_clk_rate = _dpu_core_perf_calc_clk(perf_cfg, crtc, state);
 	DRM_DEBUG_ATOMIC(
@@ -177,7 +179,9 @@ int dpu_core_perf_crtc_check(struct drm_crtc *crtc,
 	u32 bw, threshold;
 	struct dpu_crtc_state *dpu_cstate;
 	struct dpu_kms *kms;
-	struct dpu_core_perf_params perf = { 0 };
+	struct drm_crtc *tmp_crtc;
+	struct drm_crtc_state *tmp_state;
+	u64 total_bw = 0;
 
 	if (!crtc || !state) {
 		DPU_ERROR("invalid crtc\n");
@@ -195,10 +199,27 @@ int dpu_core_perf_crtc_check(struct drm_crtc *crtc,
 	/* obtain new values */
 	_dpu_core_perf_calc_crtc(&kms->perf, crtc, state, &dpu_cstate->new_perf);
 
-	dpu_core_perf_aggregate(crtc->dev, dpu_crtc_get_client_type(crtc), &perf);
+	/*
+	 * Check the proposed composition, not the currently scanned out frame.
+	 * Checking crtc->state lets an over-budget composition through and then
+	 * rejects every subsequent commit, including a single-plane fallback.
+	 * Lock the other CRTCs too so concurrent commits cannot both consume
+	 * the same remaining bandwidth. Propagate -EDEADLK to the atomic helper.
+	 */
+	drm_for_each_crtc(tmp_crtc, crtc->dev) {
+		tmp_state = drm_atomic_get_crtc_state(state->state, tmp_crtc);
+		if (IS_ERR(tmp_state))
+			return PTR_ERR(tmp_state);
+
+		if (!drm_atomic_crtc_effectively_active(tmp_state) ||
+		    dpu_crtc_get_client_type(tmp_crtc) != dpu_crtc_get_client_type(crtc))
+			continue;
+
+		total_bw += _dpu_core_perf_calc_bw(kms->perf.perf_cfg, tmp_state);
+	}
 
 	/* convert bandwidth to kb */
-	bw = DIV_ROUND_UP_ULL(perf.bw_ctl, 1000);
+	bw = DIV_ROUND_UP_ULL(total_bw, 1000);
 	DRM_DEBUG_ATOMIC("calculated bandwidth=%uk\n", bw);
 
 	threshold = kms->perf.perf_cfg->max_bw_high;
@@ -209,7 +230,7 @@ int dpu_core_perf_crtc_check(struct drm_crtc *crtc,
 		DPU_ERROR("no bandwidth limits specified\n");
 		return -E2BIG;
 	} else if (bw > threshold) {
-		DPU_ERROR("exceeds bandwidth: %ukb > %ukb\n", bw,
+		DRM_DEBUG_ATOMIC("exceeds bandwidth: %ukb > %ukb\n", bw,
 				threshold);
 		return -E2BIG;
 	}
@@ -394,6 +415,10 @@ int dpu_core_perf_crtc_update(struct drm_crtc *crtc,
 
 		trace_dpu_core_perf_update_clk(kms->dev, !crtc->enabled, clk_rate);
 
+		/* If we're going offline, PM callbacks will disable the clocks instead */
+		if (!clk_rate)
+			return 0;
+
 		clk_rate = min(clk_rate, kms->perf.max_core_clk_rate);
 		ret = dev_pm_opp_set_rate(&kms->pdev->dev, clk_rate);
 		if (ret) {
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
index eb78a4940e03..e38180fc002d 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
@@ -1088,6 +1088,7 @@ void dpu_crtc_commit_kickoff(struct drm_crtc *crtc)
 
 	if (atomic_inc_return(&dpu_crtc->frame_pending) == 1) {
 		/* acquire bandwidth and other resources */
+		atomic_inc(&dpu_kms->bandwidth_ref);
 		DRM_DEBUG_ATOMIC("crtc%d first commit\n", crtc->base.id);
 	} else
 		DRM_DEBUG_ATOMIC("crtc%d commit\n", crtc->base.id);
@@ -1530,11 +1531,9 @@ static int dpu_crtc_atomic_check(struct drm_crtc *crtc,
 		dpu_pstate->needs_dirtyfb = needs_dirtyfb;
 	}
 
-	atomic_inc(&_dpu_crtc_get_kms(crtc)->bandwidth_ref);
-
 	rc = dpu_core_perf_crtc_check(crtc, crtc_state);
 	if (rc) {
-		DPU_ERROR("crtc%d failed performance check %d\n",
+		DRM_DEBUG_ATOMIC("crtc%d failed performance check %d\n",
 				crtc->base.id, rc);
 		return rc;
 	}
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_plane.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_plane.c
index 905524ceeb1f..0e114301a991 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_plane.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_plane.c
@@ -825,6 +825,8 @@ static int dpu_plane_atomic_check_nosspp(struct drm_plane *plane,
 	struct dpu_sw_pipe_cfg *pipe_cfg = &pstate->pipe_cfg;
 	struct dpu_sw_pipe_cfg *r_pipe_cfg = &pstate->r_pipe_cfg;
 	struct drm_rect fb_rect = { 0 };
+	const struct msm_format *fmt;
+	const struct drm_display_mode *mode;
 	uint32_t max_linewidth;
 
 	min_scale = FRAC_16_16(1, MAX_UPSCALE_RATIO);
@@ -838,8 +840,11 @@ static int dpu_plane_atomic_check_nosspp(struct drm_plane *plane,
 		DPU_DEBUG_PLANE(pdpu, "Check plane state failed (%d)\n", ret);
 		return ret;
 	}
-	if (!new_plane_state->visible)
+	if (!new_plane_state->visible) {
+		pstate->plane_fetch_bw = 0;
+		pstate->plane_clk = 0;
 		return 0;
+	}
 
 	pstate->stage = DPU_STAGE_0 + pstate->base.normalized_zpos;
 	if (pstate->stage >= pdpu->catalog->caps->max_mixer_blendstages) {
@@ -907,6 +912,24 @@ static int dpu_plane_atomic_check_nosspp(struct drm_plane *plane,
 
 	pstate->needs_qos_remap = drm_atomic_crtc_needs_modeset(crtc_state);
 
+	/*
+	 * CRTC bandwidth validation must use the proposed geometry and mode.
+	 * Computing these in atomic_update leaves the duplicated plane state
+	 * with the previous frame's costs during atomic_check (zero on first
+	 * enable). Resource assignment later only selects SSPPs; both physical
+	 * and virtual planes have their final rectangles here.
+	 */
+	fmt = msm_framebuffer_format(new_plane_state->fb);
+	mode = &crtc_state->adjusted_mode;
+	pstate->plane_fetch_bw = _dpu_plane_calc_bw(pdpu->catalog, fmt, mode, pipe_cfg);
+	pstate->plane_clk = _dpu_plane_calc_clk(mode, pipe_cfg);
+	if (drm_rect_width(&r_pipe_cfg->src_rect) != 0) {
+		pstate->plane_fetch_bw += _dpu_plane_calc_bw(pdpu->catalog, fmt, mode,
+							  r_pipe_cfg);
+		pstate->plane_clk = max(pstate->plane_clk,
+				       _dpu_plane_calc_clk(mode, r_pipe_cfg));
+	}
+
 	return 0;
 }
 
@@ -1475,17 +1498,6 @@ static void dpu_plane_sspp_atomic_update(struct drm_plane *plane,
 
 	if (pstate->needs_qos_remap)
 		pstate->needs_qos_remap = false;
-
-	pstate->plane_fetch_bw = _dpu_plane_calc_bw(pdpu->catalog, fmt,
-						    &crtc->mode, pipe_cfg);
-
-	pstate->plane_clk = _dpu_plane_calc_clk(&crtc->mode, pipe_cfg);
-
-	if (r_pipe->sspp) {
-		pstate->plane_fetch_bw += _dpu_plane_calc_bw(pdpu->catalog, fmt, &crtc->mode, r_pipe_cfg);
-
-		pstate->plane_clk = max(pstate->plane_clk, _dpu_plane_calc_clk(&crtc->mode, r_pipe_cfg));
-	}
 }
 
 static void _dpu_plane_atomic_disable(struct drm_plane *plane)
