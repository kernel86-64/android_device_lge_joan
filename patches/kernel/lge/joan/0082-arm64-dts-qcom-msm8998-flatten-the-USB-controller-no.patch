From ff709c106d77fc777def14eb680eb5f704944800 Mon Sep 17 00:00:00 2001
From: Lance <Gero3977@gmail.com>
Date: Wed, 4 Nov 2026 00:48:54 -0800
Subject: [PATCH 02/22] arm64: dts: qcom: msm8998: flatten the USB controller
 node

Unplugging the cable never reached the controller. The legacy dwc3 glue
forces the VBUS override on at probe and only extcon can clear it, so a
board whose USB role comes from a Type-C port, like the LG V30, has no
way to drop it. The UDC stayed "configured" with the link in Suspend
after the cable was gone (the charger reported offline, the battery
discharging), dwc->connected stayed true, the controller could not
runtime-suspend, and its 2.5 GB/s interconnect vote held DDR at the 412
MHz step on battery for as long as the phone was up.

The flattened dwc3-qcom driver hooks the role switch instead: a detach
clears the override, the controller sees a disconnect, and a runtime
suspend then releases the interconnect vote. The qcom,snps-dwc3 binding
already lists qcom,msm8998-dwc3, with this interrupt order.

Merge the core node into the wrapper and map the whole 0xa800000 block
(QSCRATCH sits at the 0xf8800 offset the driver expects: 0xa8f8800). The
usb3_dwc3 label moves onto the merged node alongside usb3, so the
existing board overrides keep working unchanged.

Signed-off-by: Lance <Gero3977@gmail.com>
Assisted-by: Claude-Code:claude-opus-5-5
---
 arch/arm64/boot/dts/qcom/msm8998.dtsi | 56 ++++++++++++---------------
 1 file changed, 25 insertions(+), 31 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/msm8998.dtsi b/arch/arm64/boot/dts/qcom/msm8998.dtsi
index 052170457..da8c0aa0a 100644
--- a/arch/arm64/boot/dts/qcom/msm8998.dtsi
+++ b/arch/arm64/boot/dts/qcom/msm8998.dtsi
@@ -3677,13 +3677,10 @@ spmi_bus: spmi@800f000 {
 			#interrupt-cells = <4>;
 		};
 
-		usb3: usb@a8f8800 {
-			compatible = "qcom,msm8998-dwc3", "qcom,dwc3";
-			reg = <0x0a8f8800 0x400>;
+		usb3: usb3_dwc3: usb@a800000 {
+			compatible = "qcom,msm8998-dwc3", "qcom,snps-dwc3";
+			reg = <0x0a800000 0xfc100>;
 			status = "disabled";
-			#address-cells = <1>;
-			#size-cells = <1>;
-			ranges;
 
 			clocks = <&gcc GCC_CFG_NOC_USB3_AXI_CLK>,
 				 <&gcc GCC_USB30_MASTER_CLK>,
@@ -3700,10 +3697,12 @@ usb3: usb@a8f8800 {
 					  <&gcc GCC_USB30_MASTER_CLK>;
 			assigned-clock-rates = <19200000>, <120000000>;
 
-			interrupts = <GIC_SPI 180 IRQ_TYPE_LEVEL_HIGH>,
+			interrupts = <GIC_SPI 131 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 180 IRQ_TYPE_LEVEL_HIGH>,
 				     <GIC_SPI 347 IRQ_TYPE_LEVEL_HIGH>,
 				     <GIC_SPI 243 IRQ_TYPE_LEVEL_HIGH>;
-			interrupt-names = "pwr_event",
+			interrupt-names = "dwc_usb3",
+					  "pwr_event",
 					  "qusb2_phy",
 					  "ss_phy_irq";
 
@@ -3715,35 +3714,30 @@ usb3: usb@a8f8800 {
 					<&gnoc MAS_APSS_PROC &cnoc SLV_USB3_0>;
 			interconnect-names = "usb-ddr", "apps-usb";
 
-			usb3_dwc3: usb@a800000 {
-				compatible = "snps,dwc3";
-				reg = <0x0a800000 0xcd00>;
-				interrupts = <GIC_SPI 131 IRQ_TYPE_LEVEL_HIGH>;
-				snps,dis_u2_susphy_quirk;
-				snps,dis_enblslpm_quirk;
-				snps,parkmode-disable-ss-quirk;
-				phys = <&qusb2phy>, <&usb3phy>;
-				phy-names = "usb2-phy", "usb3-phy";
-				snps,has-lpm-erratum;
-				snps,hird-threshold = /bits/ 8 <0x10>;
+			snps,dis_u2_susphy_quirk;
+			snps,dis_enblslpm_quirk;
+			snps,parkmode-disable-ss-quirk;
+			phys = <&qusb2phy>, <&usb3phy>;
+			phy-names = "usb2-phy", "usb3-phy";
+			snps,has-lpm-erratum;
+			snps,hird-threshold = /bits/ 8 <0x10>;
 
-				ports {
-					#address-cells = <1>;
-					#size-cells = <0>;
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
 
-					port@0 {
-						reg = <0>;
+				port@0 {
+					reg = <0>;
 
-						usb3_dwc3_hs: endpoint {
-						};
+					usb3_dwc3_hs: endpoint {
 					};
+				};
 
-					port@1 {
-						reg = <1>;
+				port@1 {
+					reg = <1>;
 
-						usb3_dwc3_ss: endpoint {
-							remote-endpoint = <&usb3phy_usb_ss_in>;
-						};
+					usb3_dwc3_ss: endpoint {
+						remote-endpoint = <&usb3phy_usb_ss_in>;
 					};
 				};
 			};
