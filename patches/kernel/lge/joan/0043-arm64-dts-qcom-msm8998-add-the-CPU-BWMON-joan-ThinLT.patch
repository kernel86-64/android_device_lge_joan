diff --git a/drivers/interconnect/qcom/icc-rpm.c b/drivers/interconnect/qcom/icc-rpm.c
index ea1042d38128..1137d58188c0 100644
--- a/drivers/interconnect/qcom/icc-rpm.c
+++ b/drivers/interconnect/qcom/icc-rpm.c
@@ -526,9 +526,14 @@ int qnoc_probe(struct platform_device *pdev)
 			return -ENODEV;
 		}
 
-		mmio = devm_ioremap_resource(dev, res);
-		if (IS_ERR(mmio))
-			return PTR_ERR(mmio);
+		/*
+		 * Map without claiming the region: on MSM8998 the BIMC block
+		 * also contains the CPU bandwidth monitor (master port 0 at
+		 * +0x8000), which icc-bwmon maps on its own.
+		 */
+		mmio = devm_ioremap(dev, res->start, resource_size(res));
+		if (!mmio)
+			return -ENOMEM;
 
 		qp->regmap = devm_regmap_init_mmio(dev, mmio, desc->regmap_cfg);
 		if (IS_ERR(qp->regmap)) {
