+		chip->fcc_max_ua = min(chip->fcc_max_ua, CHGR_FCC_MAX_UA);
+		rc = regmap_write(chip->regmap, chip->base + CHGR_FCC_CFG,
+				  chip->fcc_max_ua / CHGR_FCC_STEP_UA);
+		if (rc < 0)
