From 29871388f7339be653e7fe50bd70cc1ce107a314 Mon Sep 17 00:00:00 2001
From: scada <scada@noreply.codeberg.org>
Date: Thu, 29 Oct 2026 21:31:38 +0400
Subject: [PATCH 75/80] iio: qcom-smgr: place the timestamp where the scan
 layout puts it

The driver pushed its fixed three-value sample struct to every IIO
device. Proximity, pressure and light scans have a single 32-bit value,
so IIO expects the timestamp at offset 8, where the struct holds the
unused third value: userspace read a timestamp of 0. Let
iio_push_to_buffers_with_ts() put it in the right place.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0144VMKxYe33NKa3LLPZNivr
---
 drivers/iio/common/qcom_smgr/qcom_smgr.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/drivers/iio/common/qcom_smgr/qcom_smgr.c b/drivers/iio/common/qcom_smgr/qcom_smgr.c
index ffb777ba29db..723ac2c638a1 100644
--- a/drivers/iio/common/qcom_smgr/qcom_smgr.c
+++ b/drivers/iio/common/qcom_smgr/qcom_smgr.c
@@ -294,7 +294,6 @@ static void qcom_smgr_buffering_report_handler(struct qmi_handle *hdl,
 	 */
 	for (j = 0; j < ARRAY_SIZE(ind->samples[0].values); ++j)
 		iio_data.values[j] = ind->samples[0].values[j];
-	iio_data.timestamp = iio_get_time_ns(sensor->iio_dev);
 
 	/*
 	 * SMGR reports sensor data in 32-bit fixed-point values, with 16 bits
@@ -324,7 +323,12 @@ static void qcom_smgr_buffering_report_handler(struct qmi_handle *hdl,
 
 	complete(&sensor->sample_ready);
 
-	iio_push_to_buffers(sensor->iio_dev, &iio_data);
+	/*
+	 * Single-value sensors have their timestamp right after the value,
+	 * not after three of them; let IIO place it for the scan layout.
+	 */
+	iio_push_to_buffers_with_ts(sensor->iio_dev, &iio_data, sizeof(iio_data),
+				    iio_get_time_ns(sensor->iio_dev));
 }
 
 static const struct qmi_msg_handler qcom_smgr_msg_handlers[] = {
