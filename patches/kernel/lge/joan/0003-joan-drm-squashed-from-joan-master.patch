+	    !msm_dsi->dev || !msm_dsi->encoder)
+		return 0;
+
+	priv = msm_dsi->dev->dev_private;
+	kms = priv->kms;
+
+	if (!kms || !kms->funcs->acquire_link || !kms->funcs->release_link)
+		return 0;
