+# SPDX-License-Identifier: GPL-2.0 OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/qcom,q6voice.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm ADSP Core Voice services (MVM, CVS, CVP)
+
+maintainers:
+  - Lance <Gero3977@gmail.com>
+
+description:
+  The Core Voice Driver services of the ADSP carry circuit-switched and VoLTE
+  calls.  The Multimode Voice Manager (MVM) owns a voice session, the Core
+  Voice Stream (CVS) runs the vocoder, and the Core Voice Processor (CVP)
+  applies the voice topology and connects the session to AFE ports.
+
+allOf:
+  - $ref: /schemas/soc/qcom/qcom,apr-services.yaml#
+
+properties:
+  compatible:
+    enum:
+      - qcom,q6mvm
+      - qcom,q6cvs
+      - qcom,q6cvp
+
+required:
+  - compatible
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/soc/qcom,apr.h>
+
+    apr {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        service@9 {
+            compatible = "qcom,q6mvm";
+            reg = <APR_SVC_ADSP_MVM>;
+        };
+
+        service@a {
+            compatible = "qcom,q6cvs";
+            reg = <APR_SVC_ADSP_CVS>;
+        };
+
+        service@b {
+            compatible = "qcom,q6cvp";
+            reg = <APR_SVC_ADSP_CVP>;
+        };
+    };
diff --git a/Documentation/devicetree/bindings/sound/qcom,wcn3990-btfm.yaml b/Documentation/devicetree/bindings/sound/qcom,wcn3990-btfm.yaml
new file mode 100644
index 000000000000..3b8bfa9abb73
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/qcom,wcn3990-btfm.yaml
@@ -0,0 +1,63 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/qcom,wcn3990-btfm.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm WCN399x Bluetooth/FM SLIMbus audio
+
+maintainers:
+  - Lance <Gero3977@gmail.com>
+
+description: |
+  The Qualcomm WCN399x Bluetooth combination chip exposes a SLIMbus
+  ported generic device (device index 1) holding the FM receiver and
+  SCO audio slave ports, plus its interface device (device index 0)
+  carrying the port configuration registers.  The FM receiver streams
+  digitised analogue baseband at 48 kHz over a two-channel group on the
+  second msm8998 SLIMbus engine, which the ADSP receives on its
+  SLIMBUS_8_TX AFE port.  Ported from the Qualcomm/LG downstream
+  btfm_slim drivers.
+
+properties:
+  compatible:
+    const: slim217,220
+
+  reg:
+    maxItems: 1
+
+  slim-ifc-dev:
+    description: Phandle to the interface device (device index 0)
+    $ref: /schemas/types.yaml#/definitions/phandle
+
+  "#sound-dai-cells":
+    const: 1
+
+required:
+  - compatible
+  - reg
+
+allOf:
+  - if:
+      required:
+        - slim-ifc-dev
+    then:
+      required:
+        - "#sound-dai-cells"
+
+additionalProperties: true
+
+examples:
+  - |
+    slim@3 {
+        reg = <3>;
+        #address-cells = <2>;
+        #size-cells = <0>;
+
+        codec@1,0 {
+            compatible = "slim217,220";
+            reg = <1 0>;
+            slim-ifc-dev = <&wcn3990_ifd>;
+            #sound-dai-cells = <1>;
+        };
+    };
