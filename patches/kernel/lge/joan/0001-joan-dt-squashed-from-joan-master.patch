+/*
+ * Front (VT) camera: a fixed-focus Hynix HI553 with a BRCF016GWZ EEPROM
+ * beside it.  Downstream (msm8998-joan-camera_rev_0.dtsi) hangs both on
+ * the bus LG calls i2c_8, which is BLSP2 I2C2 (GPIOs 6/7); the pixel
+ * data leaves on CSIPHY2 and the sensor is
+ * clocked from MCLK2 (GPIO 15).  VT_RESET is GPIO 9; the module rails
+ * are cam_vio = PM8998 L14 (1.88 V I/O) and cam_vana = PM8998 L22, and
+ * VT_VDIG is a module LDO switched by PM8998 GPIO 9 whose voltage
+ * downstream never sets, so the sensor-nominal 1.05 V is modelled here,
+ * like the CAM0_VDIG rail.
+ *
+ * The sensor answers at 0x20.  Downstream's reg = <0x28> is never used:
+ * LG's camera stack takes the address from libmmcamera_hi553.so, whose
+ * sensor_slave_info gives the 8-bit slave address 0x40 (chip ID 0x0553
+ * at 0x0f16); the same table gives 0x20 for the IMX351, i.e. the 0x10
+ * that node already uses.
+ *
+ * LG counts the mount angle clockwise (qcom,mount-angle = <270>); the DT
+ * rotation counts the other way.
+ */
+&blsp2_i2c2 {
+	status = "okay";
+
+	camera@20 {
+		compatible = "hynix,hi553";
+		reg = <0x20>;
+
+		clocks = <&mmcc CAMSS_MCLK2_CLK>;
+		assigned-clocks = <&mmcc CAMSS_MCLK2_CLK>;
+		assigned-clock-rates = <24000000>;
+
+		reset-gpios = <&tlmm 9 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&cam2_mclk_default>;
+		pinctrl-names = "default";
+
+		dovdd-supply = <&vreg_l14a_1p88>;
+		avdd-supply = <&vreg_l22a_2p85>;
+		dvdd-supply = <&cam2_dvdd_1p05>;
+
+		orientation = <0>;
+		rotation = <90>;
+
+		port {
+			hi553_ep: endpoint {
+				data-lanes = <1 2>;
+				link-frequencies = /bits/ 64 <440000000 220000000>;
+				remote-endpoint = <&csiphy2_ep>;
+			};
+		};
+	};
+};
+
+/ {
+	cam2_dvdd_1p05: regulator-cam2-dvdd {
+		compatible = "regulator-fixed";
+		regulator-name = "cam2_dvdd_1p05";
+		regulator-min-microvolt = <1050000>;
+		regulator-max-microvolt = <1050000>;
+		gpio = <&pm8998_gpios 9 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+};
+
+/*
+ * Display: SW43402 DSC command-mode panel.
+ * Validated on device — the panel lights up and GPU rendering works. The
+ * mmss SMMU (cd00000.iommu) deferred-probe -110 that once blocked this
+ * chain is resolved; see the MDSS BCR reset note below for the remaining
+ * bootloader-handoff workaround.
+ * Panel rails are board GPIO-enabled fixed supplies (downstream uses
+ * lge,gpio-vddio = TLMM 92, lge,gpio-vpnl = TLMM 69).
+ */
+/ {
+	vreg_panel_vddio: regulator-panel-vddio {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_vddio";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&tlmm 92 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+	};
+
+	vreg_panel_vpnl: regulator-panel-vpnl {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_vpnl";
+		regulator-min-microvolt = <3000000>;
+		regulator-max-microvolt = <3000000>;
+		gpio = <&tlmm 69 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+	};
+};
+
+&mdss {
+	status = "okay";
+	/*
+	 * Hard-reset the whole MDSS complex at probe: the bootloader
+	 * leaves the display pipeline live (splash/fastboot screen), and
+	 * programming the first modeset onto running hardware wedges the
+	 * HS pixel path until a full disable/enable cycle. The BCR pulse
+	 * gives the kernel cold silicon instead.
+	 */
+	resets = <&mmcc MDSS_BCR>;
+};
+
+&mdss_mdp {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	vdd-supply = <&vreg_l1a_0p875>;
+	vdda-supply = <&vreg_l2a_1p2>;
+	status = "okay";
+
+	panel@0 {
+		compatible = "lg,sw43402";
+		reg = <0>;
+
+		vddio-supply = <&vreg_panel_vddio>;
+		vpnl-supply = <&vreg_panel_vpnl>;
+
+		reset-gpios = <&tlmm 35 GPIO_ACTIVE_LOW>;
+
+		pinctrl-0 = <&mdss_te_default>;
+		pinctrl-names = "default";
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	data-lanes = <0 1 2 3>;
+	remote-endpoint = <&panel_in>;
+	qcom,te-source = "mdp_vsync_p";
+};
+
+&mdss_dsi0_phy {
+	vdds-supply = <&vreg_l1a_0p875>;
+	status = "okay";
+};
+
+/*
+ * Touch: STMicro FingerTipS on blsp1_i2c5 at 0x49. Downstream binds its
+ * own "stm,ftm4" driver (lge_touch); mainline's stmfts speaks the same
+ * FingerTipS command set, so try it first. The controller keeps its
+ * firmware in on-chip flash — downstream only pushes L0S59P1_1_11.ftb
+ * for updates — so no firmware file is needed to bring it up.
+ *
+ * Both rails are GPIO load switches, not programmable regulators, so
+ * the voltages below are nominal descriptors only. Downstream names
+ * them vdd-gpio (TLMM 85) and vio-gpio (TLMM 86); the mapping onto
+ * stmfts's "avdd" (analog) and "vdd" (digital I/O) is inferred from the
+ * usual FingerTipS wiring and is unverified on this board.
+ */
+/ {
+	vreg_touch_avdd: regulator-touch-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "touch_avdd";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&tlmm 85 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	vreg_touch_vdd: regulator-touch-vdd {
+		compatible = "regulator-fixed";
+		regulator-name = "touch_vdd";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&tlmm 86 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+};
+
+/*
+ * BLSP1 QUP1: the ES9218P "Quad DAC" that drives joan's headphone jack.
+ * The WCD9340's own HPHL/HPHR reach the jack only through this part, so
+ * nothing is audible on the headphone path until it is driven.
+ *
+ * LG's es9218p.c documents the mode pins:
+ *   reset=H && hifi_mode2=L  -> HiFi mode          (driver's power-on state)
+ *   reset=L && hifi_mode2=H  -> Low Power Bypass   (WCD analog passes through)
+ *   reset=L && hifi_mode2=L  -> Standby / shutdown
+ *   reset=H && hifi_mode2=H  -> LowFi mode
+ *
+ * Polarity: RESETb is asserted low, so reset-gpios is ACTIVE_LOW and the
+ * driver's deassert leaves it physically high. power and hph-sw are plain
+ * active-high. PMIC DT numbering is 1-based and matches downstream, because
+ * pinctrl-spmi-gpio's of_xlate subtracts PMIC_GPIO_PHYSICAL_OFFSET.
+ */
+&blsp1_i2c1 {
+	status = "okay";
+
+	es9218p: headphone-dac@48 {
+		compatible = "ess,es9218p";
+		reg = <0x48>;
+
+		power-gpios = <&pm8998_gpios 10 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&pmi8998_gpios 2 GPIO_ACTIVE_LOW>;
+		hph-sw-gpios = <&pm8998_gpios 12 GPIO_ACTIVE_HIGH>;
+
+		/* US998 ships dac,use-internal-ldo; SEL1V stays clear. */
+		ess,internal-ldo;
+
+		#sound-dai-cells = <0>;
+	};
+
+	/* Vibration motor driver, as in LG's joan device tree */
+	haptics@59 {
+		compatible = "dongwoon,dw7800";
+		reg = <0x59>;
+	};
+};
+
+/*
+ * BLSP2 QUP1: the TFA9872 smart amplifier driving joan's loudspeaker.
+ * Downstream names it tfa98xx.7-0034, i.e. this bus at 0x34, fed by tertiary
+ * MI2S.  mainline's tfa989x drives it with the CoolFlux DSP bypassed, so there
+ * is no speaker protection: keep the gain conservative until the vendor
+ * firmware container is loaded.
+ */
+/* NFC: NXP PN547 on LG's i2c_6 (BLSP1 QUP6) */
+&blsp1_i2c6 {
+	status = "okay";
+
+	nfc@28 {
+		compatible = "nxp,pn547", "nxp,nxp-nci-i2c";
+		reg = <0x28>;
+
+		interrupts-extended = <&tlmm 116 IRQ_TYPE_EDGE_RISING>;
+		enable-gpios = <&tlmm 12 GPIO_ACTIVE_HIGH>;
+		firmware-gpios = <&tlmm 129 GPIO_ACTIVE_HIGH>;
+
+		pinctrl-0 = <&nfc_default>;
+		pinctrl-names = "default";
+	};
+};
+
+&blsp2_i2c1 {
+	status = "okay";
+
+	/*
+	 * SAR sensor. The SX9320 has the SX9324's register map; the properties
+	 * below reproduce the corresponding registers of LG's reg-init for it
+	 * (msm8998-joan-sensor.dtsi).
+	 *
+	 * Disabled: no production joan described here has the part.  LG's
+	 * msm8998-joan-sensor.dtsi is not included by any build target, and
+	 * none of the twenty DTBs in LG's final US998 and H932 boot.imgs
+	 * (US99830b_00_0902, H93230d_00_0902) carries a SAR node.  On the
+	 * US998 the address NACKs ("Unable to initialize sensor", -ENXIO).
+	 * Kept for a variant that turns out to populate it.
+	 */
+	proximity@28 {
+		compatible = "semtech,sx9320", "semtech,sx9324";
+		reg = <0x28>;
+		status = "disabled";
+
+		interrupt-parent = <&tlmm>;
+		interrupts = <62 IRQ_TYPE_LEVEL_LOW>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&capsensor_default>;
+
+		#io-channel-cells = <1>;
+
+		semtech,ph0-pin = <1 0 0>;
+		semtech,ph1-pin = <0 0 1>;
+		semtech,ph2-pin = <0 1 0>;
+		semtech,ph3-pin = <0 0 0>;
+
+		semtech,ph01-resolution = <128>;
+		semtech,ph23-resolution = <128>;
+		semtech,ph01-proxraw-strength = <1>;
+		semtech,ph23-proxraw-strength = <1>;
+		semtech,avg-pos-strength = <256>;
+
+		semtech,int-comp-resistor = "lowest";
+		semtech,input-precharge-resistor-ohms = <4000>;
+		semtech,input-analog-gain = <1>;
+		semtech,cs-idle-sleep = "hi-z";
+		semtech,startup-sensor = <1>;
+	};
+
+	speaker_amp: audio-codec@34 {
+		compatible = "nxp,tfa9872";
+		reg = <0x34>;
+		#sound-dai-cells = <0>;
+	};
+
+	/*
+	 * Parallel charger. LG drives it as a slave to the PMI8998 charger: its
+	 * driver disables charging at probe and enables it only when the main
+	 * charger hands over part of the current. bq25890_charger instead turns
+	 * charging on by itself at probe, outside the PMI8998's battery
+	 * temperature and current control, so keep it off until something
+	 * coordinates the two. Voltage and currents are LG's; LG leaves the
+	 * precharge, SYS_MIN and boost settings at their defaults, and the
+	 * values here only satisfy the binding.
+	 */
+	charger@6b {
+		compatible = "ti,bq25898s", "ti,bq25890";
+		reg = <0x6b>;
+
+		interrupt-parent = <&tlmm>;
+		interrupts = <119 IRQ_TYPE_EDGE_FALLING>;
+
+		ti,battery-regulation-voltage = <4200000>;
+		ti,charge-current = <2250000>;
+		ti,termination-current = <512000>;
+		ti,precharge-current = <128000>;
+		ti,minimum-sys-voltage = <3600000>;
+		ti,boost-voltage = <5000000>;
+		ti,boost-max-current = <1000000>;
+
+		status = "disabled";
+	};
+};
+
+&blsp1_i2c5 {
+	status = "okay";
+
+	touchscreen@49 {
+		compatible = "st,fts3670";
+		reg = <0x49>;
+
+		interrupt-parent = <&tlmm>;
+		interrupts = <125 IRQ_TYPE_LEVEL_LOW>;
+
+		vdd-supply = <&vreg_touch_vdd>;
+		avdd-supply = <&vreg_touch_avdd>;
+
+		reset-gpios = <&tlmm 89 GPIO_ACTIVE_LOW>;
+
+		touchscreen-size-x = <1440>;
+		touchscreen-size-y = <2880>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&touch_int_default &touch_reset_default>;
+	};
+};
+
+&spss_mem {
+	/* LG: spss_region 0x8ab00000 + 6 MiB (generic msm8998.dtsi: 7 MiB) */
+	reg = <0x0 0x8ab00000 0x0 0x600000>;
+};
+
+/*
+ * GPU (Adreno 540).
+ *
+ * The a540 zap blob is relocatable (QCOM_MDT_RELOCATABLE) and loads into
+ * gpu_mem, which sits in LG's pil_ipa_gpu block (see /reserved-memory).
+ *
+ * A540 reuses the redistributable A530 PM4/PFP command firmware supplied by
+ * linux-firmware. The A540 GPMU and signed LG ZAP payload remain
+ * owner-extracted, device-specific inputs. All four firmware roles must be
+ * available under qcom/ in the firmware search path (the initramfs for the
+ * early-probe images used here).
+ */
+&adreno_gpu {
+	status = "okay";
+
+	vdd-supply = <&pm8005_s1>;
+
+	/*
+	 * The GPU scales VDD_GFX itself, so it also does what the downstream
+	 * GFX CPR did for the rail (a540_gfx_rail.c): take each part's fused
+	 * open-loop voltages instead of the table below, and drive the GFX
+	 * MEM-ACC select (TCSR 0x1fcf004, bit 0).
+	 */
+	nvmem-cells = <&gpu_cpr_init>, <&gpu_cpr_rev>,
+		      <&gpu_cpr_limit>, <&gpu_cpr_force>;
+	nvmem-cell-names = "gfx_cpr_init", "gfx_cpr_rev",
+			   "gfx_cpr_limit", "gfx_cpr_force";
+	qcom,mem-acc = <&tcsr_regs_2 0xf004>;
+
+	zap-shader {
+		memory-region = <&gpu_mem>;
+		firmware-name = "qcom/a540_zap.mdt";
+	};
+};
+
+/*
+ * GPU OPP levels and voltages.
+ *
+ * msm_gpu's enable_clk() sets the core clock to gpu->fast_rate -- the
+ * HIGHEST OPP -- as part of every resume, before any register access.
+ * The original bring-up capped the table at 257 MHz (MIN_SVS) because
+ * VDD_GFX (pm8005_s1) sat at the boot voltage (~752 mV) with no scaling
+ * in place, and turbo on a low-SVS voltage is not survivable.
+ *
+ * adreno_get_pwrlevels() registers the vdd supply with the OPP framework,
+ * so every dev_pm_opp_set_rate() scales the rail before raising the core
+ * clock. Only the voltages are set here; each OPP's VDD_MX vote comes
+ * from its required-opps in msm8998.dtsi.
+ *
+ * The voltages below are only a fallback. At probe a540_gfx_rail.c
+ * replaces them with this part's fused open-loop voltages, the value the
+ * stock GFX CPR uses as each corner's ceiling. The fallback is the stock
+ * ceiling for fusing revision 1 and later (msm8998-v2.dtsi gfx_vreg),
+ * which is safe for any part. It is deliberately not the curve measured
+ * on the bench phone (2026-08-04, 628..936 mV): that was the stock CPR
+ * sitting on its floor (open-loop - 40/50 mV) on a fast part, and a part
+ * fused up to 150 mV higher would not survive it.
+ */
+&gpu_opp_table {
+	opp-710000097 {
+		opp-microvolt = <1088000>;
+	};
+
+	opp-670000048 {
+		opp-microvolt = <1024000>;
+	};
+
+	opp-596000097 {
+		opp-microvolt = <968000>;
+	};
+
+	opp-515000097 {
+		opp-microvolt = <916000>;
+	};
+
+	opp-414000000 {
+		opp-microvolt = <832000>;
+	};
+
+	opp-342000000 {
+		opp-microvolt = <772000>;
+	};
+
+	opp-257000000 {
+		opp-microvolt = <724000>;
+	};
+};
+
+
+
+
+
+/*
+ * SLIMbus to the WCD9340. The NGD is managed by the ADSP, so the bus comes up
+ * only once remoteproc adsp is running.
+ */
+&slimbam {
+	status = "okay";
+};
+
+&slim {
+	status = "okay";
+
+	/*
+	 * WCD9340 (tavil). Downstream declares it as qcom,tavil-slim-pgd with
+	 * elemental-addr [00 01 50 02 17 02] -- manufacturer 0x217, product
+	 * 0x250 -- which is exactly mainline's "slim217,250", so the sdm845
+	 * node shape applies directly.
+	 *
+	 * joan specifics taken from downstream msm8998-audio.dtsi:
+	 *   interrupt  tlmm 54   (wcd9xxx_intc: qcom,gpio-connect = <&tlmm 54 0>)
+	 *   mclk       LN_BB from the PMIC (clock_audio_lnbb / wcd_clk); on
+	 *              msm8998 that is rpmcc RPM_SMD_LN_BB_CLK1, which is in the
+	 *              msm8998 rpm clk table and already used elsewhere here.
+	 */
+	slim@1 {
+		reg = <1>;
+		#address-cells = <2>;
+		#size-cells = <0>;
+
+		wcd9340_ifd: ifd@0,0 {
+			compatible = "slim217,250";
+			reg = <0 0>;
+		};
+
+		wcd9340: codec@1,0 {
+			compatible = "slim217,250";
+			reg = <1 0>;
+			slim-ifc-dev = <&wcd9340_ifd>;
+
+			/*
+			 * All five rails come off PM8998 S4 at 1.8 V. Downstream
+			 * feeds cdc-vdd-buck / cdc-buck-sido / cdc-vdd-tx-h /
+			 * cdc-vdd-rx-h / cdc-vddpx-1 all from <&pm8998_s4> at
+			 * 1800000, which is vreg_s4a_1p8 here. Without these the
+			 * codec runs on dummy regulators and SLIMbus logical-address
+			 * assignment fails ("Failed to get logical address").
+			 */
+			vdd-buck-supply = <&vreg_s4a_1p8>;
+			vdd-buck-sido-supply = <&vreg_s4a_1p8>;
+			vdd-tx-supply = <&vreg_s4a_1p8>;
+			vdd-rx-supply = <&vreg_s4a_1p8>;
+			vdd-io-supply = <&vreg_s4a_1p8>;
+
+			#sound-dai-cells = <1>;
+
+			interrupts-extended = <&tlmm 54 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-controller;
+			#interrupt-cells = <1>;
+
+			/*
+			 * Codec reset. Downstream: wcd_rst_gpio msm_cdc_pinctrl@64
+			 * with qcom,cdc-rst-n-gpio = <&tlmm 64 0>. The mainline
+			 * wcd934x mfd takes this as an optional "reset" gpio and
+			 * asserts it before SLIMbus enumeration.
+			 */
+			reset-gpios = <&tlmm 64 GPIO_ACTIVE_HIGH>;
+
+			clock-names = "extclk";
+			clocks = <&rpmcc RPM_SMD_LN_BB_CLK1>;
+
+			#clock-cells = <0>;
+			clock-frequency = <9600000>;
+			clock-output-names = "mclk";
+
+			pinctrl-0 = <&wcd_intr_default>;
+			pinctrl-names = "default";
+
+			/*
+			 * Micbias levels read out of the stock LG device tree,
+			 * decompiled from the DTBs appended to the retail
+			 * boot.img (qcom,cdc-micbiasN-mv, in mV): MICBIAS1/3/4
+			 * = 0xabe = 2750, MICBIAS2 = 0x7d0 = 2000.  All ten
+			 * board revisions LG ships agree on these.
+			 *
+			 * These were previously all 1800000, which is
+			 * wcd-common.c's WCD_DEF_MICBIAS_MV fallback rather than
+			 * a measured value; it underbiases the analog mics.
+			 * MICBIAS2 additionally feeds MBHC -- wcd934x uses
+			 * common.micb_mv[1] as cfg->micb_mv -- so a wrong value
+			 * skews the jack-type and button comparator maths too.
+			 */
+			qcom,micbias1-microvolt = <2750000>;
+			qcom,micbias2-microvolt = <2000000>;
+			qcom,micbias3-microvolt = <2750000>;
+			qcom,micbias4-microvolt = <2750000>;
+
+			/*
+			 * Headset (MBHC) jack detection and in-line remote.
+			 * The jack is qcom,mbhc-audio-jack-type = "4-pole-jack"
+			 * downstream, i.e. it carries a mic and a remote.
+			 *
+			 * Switch types, from the stock DTB:
+			 *   qcom,msm-mbhc-hphl-swh = <1>  normally open
+			 *   qcom,msm-mbhc-gnd-swh  = <0>  normally closed
+			 *
+			 * Qualcomm's encoding is 1 = normally open, 0 = normally
+			 * closed, so HPHL wants mainline's default (property
+			 * absent leaves hphl_swh true) and ground needs telling
+			 * explicitly.  An earlier revision of this node had that
+			 * mapping inverted in a comment and left gnd_swh at its
+			 * default true, which writes the wrong value into
+			 * WCD_MBHC_GND_PLUG_TYPE; that is a candidate cause of
+			 * the live insert/remove IRQ never behaving.
+			 *
+			 * Without the button ladder, wcd_dt_parse_mbhc_data()
+			 * defaults btn_high[0..7] to 500000, so every button on
+			 * an in-line remote compares equal and decodes as BTN_0.
+			 * The thresholds are LG's own calibration for joan
+			 * (def_tavil_mbhc_cal() in its msm8998 machine driver,
+			 * for the models with the ES9218P): a 1.5 V headset
+			 * threshold, and 80/130/240/450 mV for media, assistant,
+			 * volume up and volume down.
+			 */
+			qcom,ground-jack-type-normally-closed;
+			qcom,mbhc-headset-vthreshold-microvolt = <1500000>;
+			qcom,mbhc-headphone-vthreshold-microvolt = <50000>;
+			qcom,mbhc-buttons-vthreshold-microvolt = <80000 130000 240000 450000
+								 450000 450000 450000 450000>;
+
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			wcdgpio: gpio-controller@42 {
+				compatible = "qcom,wcd9340-gpio";
+				gpio-controller;
+				#gpio-cells = <2>;
+				reg = <0x42 0x2>;
+			};
+
+			/*
+			 * The WCD934x SoundWire master only serves WSA881x
+			 * speaker amplifiers. joan has none: LG disables all
+			 * four wsa881x nodes and drives the loudspeaker with a
+			 * TFA9890 on I2C. The node must exist, because the
+			 * wcd934x MFD matches its soundwire cell by compatible
+			 * and warns "Failed to locate of_node" without one, but
+			 * mfd-core skips a disabled node without error, so the
+			 * controller never probes or clocks an empty bus.
+			 *
+			 * The port layout is the codec's own (same as
+			 * sdm845-wcd9340.dtsi). The regmap-irq table indexes
+			 * sources by WCD934X_IRQ_* (designated initializers),
+			 * so the domain has 21 slots and SoundWire is hwirq 20,
+			 * as on sdm845. hwirq 8 is WCD934X_IRQ_MBHC_SW_DET: it
+			 * collided with the MBHC jack-switch interrupt.
+			 */
+			swm: soundwire@c85 {
+				compatible = "qcom,soundwire-v1.3.0";
+				reg = <0xc85 0x40>;
+				interrupts-extended = <&wcd9340 20>;
+				status = "disabled";
+
+				qcom,dout-ports = <6>;
+				qcom,din-ports = <2>;
+				qcom,ports-sinterval-low = /bits/ 8 <0x07 0x1f 0x3f 0x7 0x1f 0x3f 0x0f 0x0f>;
+				qcom,ports-offset1 = /bits/ 8 <0x01 0x02 0x0c 0x6 0x12 0x0d 0x07 0x0a>;
+				qcom,ports-offset2 = /bits/ 8 <0x00 0x00 0x1f 0x00 0x00 0x1f 0x00 0x00>;
+
+				#sound-dai-cells = <1>;
+				clocks = <&wcd9340>;
+				clock-names = "iface";
+				#address-cells = <2>;
+				#size-cells = <0>;
+			};
+		};
+	};
+};
+
+&remoteproc_adsp {
+	firmware-name = "qcom/msm8998/joan/adsp.mdt";
+	status = "okay";
+};
+
+/*
+ * The ADSP's own IOMMU.  q6asmdai (msm8998.dtsi) takes its audio context
+ * bank from here, so the PCM buffer handed to the DSP is an IOVA the Q6 can
+ * translate rather than a bare physical address.
+ */
+&lpass_q6_smmu {
+	status = "okay";
+};
+
+/*
+ * Sensor DSP (SLPI/SSC). LG boots the same image as "slpi" through PIL with
+ * pas-id 12; the signed v2-silicon image ships as qcom/msm8998/joan/slpi_v2.mdt
+ * (firmware-lg-joan) and spans exactly the 15 MiB of slpi_mem.
+ */
+&remoteproc_slpi {
+	firmware-name = "qcom/msm8998/joan/slpi_v2.mdt";
+	status = "okay";
+};
+
+&remoteproc_mss {
+	firmware-name = "qcom/msm8998/joan/mba.mbn",
+			"qcom/msm8998/joan/modem.mdt";
+	status = "okay";
+};
+
+/*
+ * IPA. Needed by ModemManager: it reads the QMI bus over QRTR fine but
+ * will not instantiate a modem without IPA's rmnet/wwan netdevs
+ * (pmaports !3531 reports the same on OnePlus 5/5T). The modem itself
+ * works without this -- it boots, authenticates and advertises its full
+ * QMI service set -- but nothing consumes it.
+ */
+&ipa {
+	memory-region = <&ipa_fw_mem>;
+	qcom,gsi-loader = "self";
+	status = "okay";
+};
