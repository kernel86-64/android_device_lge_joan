diff --git a/arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts b/arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts
new file mode 100644
index 000000000000..df8b91a4d926
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts
@@ -0,0 +1,2644 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * LG V30 (US998, joan) device tree source based on msm8998-oneplus-common.dtsi
+ * and the downstream LG msm8998-joan device trees (LineageOS kernel/lge/msm8998).
+ *
+ * Copyright (c) 2026, Lance <Gero3977@gmail.com>
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/sound/qcom,q6afe.h>
+#include <dt-bindings/sound/qcom,q6asm.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/iio/qcom,spmi-vadc.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
+#include <dt-bindings/usb/pd.h>
+#include <dt-bindings/phy/phy-qcom-qmp.h>
+#include "msm8998.dtsi"
+#include "pm8005.dtsi"
+#include "pm8998.dtsi"
+#include "pmi8998.dtsi"
+
+/*
+ * Firmware carve-outs that sit somewhere else on joan than in the generic
+ * msm8998.dtsi map; they are re-created at their joan addresses in
+ * /reserved-memory below.
+ */
+/delete-node/ &adsp_mem;
+/delete-node/ &gpu_mem;
+/delete-node/ &ipa_fw_mem;
+/delete-node/ &ipa_gsi_mem;
+/delete-node/ &mba_mem;
+/delete-node/ &mpss_mem;
+/delete-node/ &slpi_mem;
+/delete-node/ &venus_mem;
+/delete-node/ &wlan_msa_mem;
+
+/ {
+	model = "LG V30 (US998)";
+	compatible = "lg,joan", "qcom,msm8998";
+	chassis-type = "handset";
+
+	/* Required for bootloader to select correct board */
+	qcom,msm-id = <292 0x20001>; /* 8998 v2.1 */
+	/*
+	 * LG aboot matches the appended DTB against the unit's hardware
+	 * revision. Downstream ships one DTB per rev (rev_a .. rev_1_3);
+	 * list every US998 (joan_nao_us) board id so a single DTB matches
+	 * any revision. The stock DTBs for all ten revisions differ only in
+	 * battery, charging, USB-C SBU select and the Quad DAC LDO, none of
+	 * which this tree depends on.
+	 */
+	qcom,board-id = <0x308 0>, <0x608 0>, <0x708 0>,
+			<0x808 0>, <0x908 0>, <0xa08 0>,
+			<0xc08 0>, <0xd08 0>, <0xe08 0>,
+			<0xf08 0>;
+
+	/*
+	 * No chosen/simple-framebuffer node: the SW43402 panel runs DSI
+	 * command mode with DSC, so the splash image persists in panel
+	 * GRAM but CPU writes to the splash buffer are never scanned out
+	 * again after the bootloader stops kicking off frames. A simplefb
+	 * console would be silently invisible; USB gadget + ramoops are
+	 * the bring-up debug channels instead.
+	 */
+
+	reserved-memory {
+		/*
+		 * joan's memory map, transcribed from LG's last stock builds:
+		 * US99830b_00_0902 (US998) and H93230d_00_0902 (H932).  All
+		 * twenty DTBs those two boot.imgs carry (ten board revisions
+		 * each) declare the identical reserved-memory, so one map
+		 * serves every joan variant.  Regions that keep their generic
+		 * msm8998.dtsi address (hyp, xbl, smem, tz, rmtfs) are not
+		 * repeated here.
+		 *
+		 * LG declares 0x85800000-0x88f00000 as one removed region;
+		 * the SoC dtsi covers it except for this 1 MiB.
+		 */
+		memory@85f00000 {
+			reg = <0x0 0x85f00000 0x0 0x100000>;
+			no-map;
+		};
+
+		/*
+		 * The modem image and the MBA are signed for these physical
+		 * addresses, and the MBA authenticates the modem in place, so
+		 * this chain cannot move.  ADSP is 30 MiB on joan
+		 * (msm8998-joan-common-pm.dtsi), which shifts everything
+		 * after it relative to the generic layout.
+		 */
+		mpss_mem: memory@8b400000 {
+			reg = <0x0 0x8b400000 0x0 0x7700000>;
+			no-map;
+		};
+
+		adsp_mem: memory@92b00000 {
+			reg = <0x0 0x92b00000 0x0 0x1e00000>;
+			no-map;
+		};
+
+		venus_mem: memory@94900000 {
+			reg = <0x0 0x94900000 0x0 0x500000>;
+			no-map;
+		};
+
+		mba_mem: memory@94e00000 {
+			reg = <0x0 0x94e00000 0x0 0x200000>;
+			no-map;
+		};
+
+		/* slpi_v2.mdt spans exactly 0xf00000 */
+		slpi_mem: memory@95000000 {
+			reg = <0x0 0x95000000 0x0 0xf00000>;
+			no-map;
+		};
+
+		/*
+		 * LG reserves 0x95f00000-0x96000000 as pil_ipa_gpu and loads
+		 * the IPA firmware and the GPU zap shader there; the three
+		 * mainline consumers tile that block.
+		 */
+		ipa_fw_mem: memory@95f00000 {
+			reg = <0x0 0x95f00000 0x0 0x10000>;
+			no-map;
+		};
+
+		ipa_gsi_mem: memory@95f10000 {
+			reg = <0x0 0x95f10000 0x0 0x10000>;
+			no-map;
+		};
+
+		gpu_mem: memory@95f20000 {
+			reg = <0x0 0x95f20000 0x0 0xe0000>;
+			no-map;
+		};
+
+		/*
+		 * Downstream icnss allocates the 1 MiB WLAN MSA region at run
+		 * time; mainline needs it fixed.  Take the first RAM LG leaves
+		 * unreserved after the firmware carve-outs.
+		 */
+		wlan_msa_mem: memory@96000000 {
+			reg = <0x0 0x96000000 0x0 0x100000>;
+			no-map;
+		};
+
+		/* Bootloader display framebuffer region, same as downstream */
+		cont_splash_mem: memory@9d400000 {
+			reg = <0x0 0x9d400000 0x0 0x2400000>;
+			no-map;
+		};
+
+		/*
+		 * Byte-compatible with the downstream ramoops layout
+		 * (msm8998-joan_*.dtsi: mem-size 0x80000, console @0,
+		 * ftrace @0x40000, no dump/pmsg space): after a crashed
+		 * mainline boot falls back to the LG 4.4 kernel, Android
+		 * parses our console log and drops it in
+		 * /data/system/dropbox as SYSTEM_LAST_KMSG. Any other
+		 * split leaves the log invisible to downstream.
+		 */
+		ramoops@b0000000 {
+			compatible = "ramoops";
+			reg = <0x0 0xb0000000 0x0 0x80000>;
+			record-size = <0x1000>;
+			console-size = <0x40000>;
+			ftrace-size = <0x40000>;
+		};
+
+		/* rest of downstream's 1 MiB ramoops carve-out */
+		memory@b0080000 {
+			reg = <0x0 0xb0080000 0x0 0x80000>;
+			no-map;
+		};
+
+		/* LG's crash handler framebuffer (crash_fb_mem) */
+		crash_fb_mem: memory@b0100000 {
+			reg = <0x0 0xb0100000 0x0 0x1800000>;
+			no-map;
+		};
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+		label = "Volume up";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&vol_up_default>;
+
+		button-vol-up {
+			label = "Volume up";
+			gpios = <&pm8998_gpios 6 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEUP>;
+			debounce-interval = <15>;
+			wakeup-source;
+		};
+	};
+
+	/*
+	 * Main camera rails: external LDOs switched by PM8998 GPIOs, LG's
+	 * CAM0_AVDD (GPIO 8) and CAM0_VDIG (GPIO 20).  The voltages are the
+	 * sensor's nominal ones; nothing sets them.
+	 */
+	cam0_avdd_2p8: cam0-avdd-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "cam0_avdd_2p8";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&pm8998_gpios 8 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		pinctrl-0 = <&cam0_avdd_en>;
+		pinctrl-names = "default";
+	};
+
+	cam0_dvdd_1p05: cam0-dvdd-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "cam0_dvdd_1p05";
+		regulator-min-microvolt = <1050000>;
+		regulator-max-microvolt = <1050000>;
+		gpio = <&pm8998_gpios 20 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		pinctrl-0 = <&cam0_dvdd_en>;
+		pinctrl-names = "default";
+	};
+
+	/* Stock names this external actuator rail CAM0_VAF (PM8998 GPIO 7). */
+	cam0_vaf: cam0-vaf-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "cam0_vaf";
+		gpio = <&pm8998_gpios 7 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		pinctrl-0 = <&cam0_vaf_en>;
+		pinctrl-names = "default";
+	};
+
+	/*
+	 * Wide camera rails: external LDOs switched by TLMM GPIOs, LG's
+	 * CAM1_VANA (GPIO 39) and CAM1_DVDD (GPIO 21).  As for the main
+	 * camera, the voltages are the sensor's nominal ones; nothing sets
+	 * them.
+	 */
+	cam1_avdd_2p8: cam1-avdd-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "cam1_avdd_2p8";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&tlmm 39 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		pinctrl-0 = <&cam1_avdd_en>;
+		pinctrl-names = "default";
+	};
+
+	cam1_dvdd_1p05: cam1-dvdd-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "cam1_dvdd_1p05";
+		regulator-min-microvolt = <1050000>;
+		regulator-max-microvolt = <1050000>;
+		gpio = <&tlmm 21 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		pinctrl-0 = <&cam1_dvdd_en>;
+		pinctrl-names = "default";
+	};
+
+	/*
+	 * DP AUX to the SBU pins, driven by LG's mdss_dp_config_gpios().
+	 * TLMM 100 (qcom,aux-en-gpio) is an active-low output enable that
+	 * sits high while DP is off. TLMM 80 (qcom,aux-sel-gpio) picks the
+	 * side: Qualcomm's variant sets it for a CC2 (flipped) plug, LG's
+	 * copies the TLMM 38 orientation input, which TCPM replaces here.
+	 */
+	usb-sbu-mux {
+		compatible = "lg,joan-sbu-mux", "gpio-sbu-mux";
+
+		enable-gpios = <&tlmm 100 GPIO_ACTIVE_LOW>;
+		select-gpios = <&tlmm 80 GPIO_ACTIVE_HIGH>;
+
+		pinctrl-0 = <&dp_aux_sw_default>;
+		pinctrl-names = "default";
+
+		mode-switch;
+		orientation-switch;
+
+		port {
+			sbu_mux_in: endpoint {
+				remote-endpoint = <&pmi8998_sbu_out>;
+			};
+		};
+	};
+
+	vph_pwr: vph-pwr-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vph_pwr";
+		regulator-always-on;
+		regulator-boot-on;
+	};
+};
+
+&blsp2_uart1 {
+	status = "okay";
+};
+
+&blsp1_uart3 {
+	status = "okay";
+	assigned-clocks = <&gcc GCC_BLSP1_UART3_APPS_CLK>;
+	assigned-clock-rates = <48000000>;
+
+	bluetooth {
+		compatible = "qcom,wcn3990-bt";
+		firmware-name = "crnv21.bin";
+		vddio-supply = <&vreg_s3a_1p35>;
+		vddxo-supply = <&vreg_s5a_2p04>;
+		vddrf-supply = <&vreg_l17a_1p3>;
+		vddch0-supply = <&vreg_l25a_3p3>;
+		max-speed = <3000000>;
+
+		/*
+		 * joan has no factory BD address: the NVM's address TLV is
+		 * all zeroes and the vendor stack generates a random address
+		 * on first use. The all-zero placeholder is rejected by the
+		 * core, which leaves the controller HCI_UNCONFIGURED so that
+		 * userspace can supply one (MGMT_OP_SET_PUBLIC_ADDRESS).
+		 */
+		local-bd-address = [ 00 00 00 00 00 00 ];
+
+		/* LG's FM radio app runs on this receiver */
+		qcom,fm-receiver;
+	};
+};
+
+/*
+ * Camera.  The main IMX351 is wired to CSIPHY0 and the wide S5K3M3 to
+ * CSIPHY1; the front HI553 (CSIPHY2) has no driver here yet, so its node,
+ * rails and MCLK pin come with that driver.  The CSID supplies are LG's:
+ * mipi-csi-vdd is L2 at 1.2 V and vdd_sec is L1.
+ */
+&camss {
+	vdda-supply = <&vreg_l2a_1p2>;
+	vdd_sec-supply = <&vreg_l1a_0p875>;
+
+	status = "okay";
+
+	ports {
+		port@0 {
+			reg = <0>;
+
+			csiphy0_ep: endpoint {
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&imx351_ep>;
+			};
+		};
+
+		port@1 {
+			reg = <1>;
+
+			csiphy1_ep: endpoint {
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&s5k3m3_ep>;
+			};
+		};
+
+		port@2 {
+			reg = <2>;
+
+			csiphy2_ep: endpoint {
+				data-lanes = <0 1>;
+				remote-endpoint = <&hi553_ep>;
+			};
+		};
+	};
+};
+
+&cci {
+	status = "okay";
+};
+
+&cci_i2c0 {
+	/*
+	 * Main camera: LG's camera@0 on CSIPHY0. LG gives qcom,mount-angle =
+	 * <90>, which Android counts clockwise; rotation counts the other way.
+	 */
+	camera@10 {
+		compatible = "sony,imx351";
+		reg = <0x10>;
+
+		clocks = <&mmcc CAMSS_MCLK0_CLK>;
+		assigned-clocks = <&mmcc CAMSS_MCLK0_CLK>;
+		assigned-clock-rates = <24000000>;
+
+		reset-gpios = <&tlmm 30 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&cam0_mclk_default>;
+		pinctrl-names = "default";
+
+		avdd-supply = <&cam0_avdd_2p8>;
+		dvdd-supply = <&cam0_dvdd_1p05>;
+		dovdd-supply = <&vreg_lvs1a_1p8>;
+
+		orientation = <1>;
+		rotation = <270>;
+
+		/*
+		 * The module is dual-sourced: the ROHM BU24235 or a Renesas
+		 * controller sits at 0x3e/0x24, chosen per unit by the module
+		 * EEPROM.  bu24235.c reads the EEPROM map version and declines
+		 * the bus on Renesas units.  Both actuators take their power
+		 * from the module, so chip access waits for the first focus
+		 * request while the sensor streams.
+		 */
+		lens-focus = <&bu24235>;
+
+		port {
+			imx351_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <660000000 330000000>;
+				remote-endpoint = <&csiphy0_ep>;
+			};
+		};
+	};
+
+	/*
+	 * Laser autofocus (LG's "proxy", VL53L0), on the same bus as the main
+	 * camera.  LDAF_EN (GPIO 25) drives its XSHUT.  LG lists no supply
+	 * for it; it is taken to share the main camera module's analog rail.
+	 */
+	proximity@29 {
+		compatible = "st,vl53l0x";
+		reg = <0x29>;
+		reset-gpios = <&tlmm 25 GPIO_ACTIVE_LOW>;
+		vdd-supply = <&cam0_avdd_2p8>;
+	};
+
+	/*
+	 * ROHM BU24235 AF/OIS controller of the rear camera module (the
+	 * Renesas variant of the module uses 0x24 and has no driver yet).
+	 * Stock controls its dedicated CAM0_VAF rail with PM8998 GPIO 7 and
+	 * releases CAM0_OIS_RESET with TLMM GPIO 23 after VAF is enabled.
+	 */
+	bu24235: lens@3e {
+		compatible = "rohm,bu24235";
+		reg = <0x3e>;
+
+		vaf-supply = <&cam0_vaf>;
+		reset-gpios = <&tlmm 23 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&cam0_ois_reset>;
+		pinctrl-names = "default";
+	};
+};
+
+&cci_i2c1 {
+	/*
+	 * Wide camera: LG's camera@2 on CSIPHY1, fixed focus, no actuator.
+	 * LG gives qcom,mount-angle = <90> like the main camera, but its
+	 * S5K3M3 library streams with both flips set (0x0100 = 0x0103) and
+	 * the driver does not, so the unflipped image needs another 180
+	 * degrees: Android's 270 clockwise is 90 here.
+	 */
+	camera@2d {
+		compatible = "samsung,s5k3m3";
+		reg = <0x2d>;
+
+		clocks = <&mmcc CAMSS_MCLK1_CLK>;
+		assigned-clocks = <&mmcc CAMSS_MCLK1_CLK>;
+		assigned-clock-rates = <24000000>;
+
+		reset-gpios = <&tlmm 28 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&cam1_mclk_default &cam1_reset_default>;
+		pinctrl-names = "default";
+
+		vdda-supply = <&cam1_avdd_2p8>;
+		vddd-supply = <&cam1_dvdd_1p05>;
+		vddio-supply = <&vreg_l6a_1p8>;
+
+		orientation = <1>;
+		rotation = <90>;
+
+		port {
+			s5k3m3_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <594000000 306000000>;
+				remote-endpoint = <&csiphy1_ep>;
+			};
+		};
+	};
+};
+
+/*
+ * Video codec (Venus): hardware H.264/HEVC decode for the browser and
+ * video players.  The firmware is packaged on the device as
+ * qcom/msm8998/joan/venus.mdt + .b00-.b04 (firmware-lge-joan); memory
+ * comes from venus_mem reserved in msm8998.dtsi.
+ *
+ * Kept disabled: a full venus_core probe wedges the SoC into a watchdog
+ * reset on joan (lg-v30-port docs/evidence/2026-09-26-venus, and again
+ * on the r38 bench boot 2026-10-03).  A probe stopped before firmware
+ * boot (stop_at=5) survives; the failing stage is still being bisected.
+ */
+&venus {
+	/*
+	 * Three PM domains, attached by the driver via devm_pm_domain_attach_list
+	 * ("venus", "vcodec0", "vcodec1" in the msm8998 resources). The single
+	 * VIDEO_TOP_GDSC from the dtsi made the driver core attach it first, and
+	 * the driver's own multi-domain attach then failed with -EEXIST before
+	 * venus_probe ever ran (2026-10-05 bench).
+	 */
+	power-domains = <&mmcc VIDEO_TOP_GDSC>,
+			<&mmcc VIDEO_SUBCORE0_GDSC>,
+			<&mmcc VIDEO_SUBCORE1_GDSC>;
+	power-domain-names = "venus", "vcodec0", "vcodec1";
+	clocks = <&mmcc VIDEO_CORE_CLK>,
+		 <&mmcc VIDEO_AHB_CLK>,
+		 <&mmcc VIDEO_AXI_CLK>,
+		 <&mmcc VIDEO_MAXI_CLK>,
+		 <&mmcc MNOC_AHB_CLK>,
+		 <&gcc GCC_MMSS_SYS_NOC_AXI_CLK>,
+		 <&mmcc VIDEO_SUBCORE0_CLK>,
+		 <&mmcc VIDEO_SUBCORE1_CLK>;
+	clock-names = "core", "iface", "bus", "mbus", "mnoc_ahb", "noc_axi",
+		      "vcodec0_core", "vcodec1_core";
+	firmware-name = "qcom/msm8998/joan/venus.mdt";
+	status = "okay";
+};
+
+&pm8005_regulators {
+	/* VDD_GFX supply; managed by the OPP framework + msm_gpu (vdd) */
+	pm8005_s1: s1 {
+		regulator-min-microvolt = <524000>;
+		regulator-max-microvolt = <1088000>;
+		regulator-enable-ramp-delay = <500>;
+		/*
+		 * No always-on: the GPU_GX GDSC now owns this rail via
+		 * vdd-gfx-supply, so it is enabled and disabled together with
+		 * the GX domain. Holding it on unconditionally kept VDD_GFX
+		 * powered even with the GPU idle.
+		 */
+	};
+};
+
+&pm8998_gpios {
+	cam0_avdd_en: cam0-avdd-en-state {
+		pins = "gpio8";
+		function = "normal";
+		output-low;
+	};
+
+	cam0_dvdd_en: cam0-dvdd-en-state {
+		pins = "gpio20";
+		function = "normal";
+		output-low;
+	};
+
+	cam0_vaf_en: cam0-vaf-en-state {
+		pins = "gpio7";
+		function = "normal";
+		output-low;
+	};
+
+	vol_up_default: vol-up-state {
+		pins = "gpio6";
+		function = "normal";
+		bias-pull-up;
+		input-enable;
+		qcom,drive-strength = <PMIC_GPIO_STRENGTH_NO>;
+	};
+};
+
+&pm8998_pwrkey {
+	/*
+	 * joan's power switch chatters. A single press produces extra
+	 * press/release pairs with hold times as short as 3 ms, and the gaps
+	 * between them measure 17-19 ms -- just wide enough to clear the
+	 * 15.625 ms debounce inherited from pm8998.dtsi. The stray edge
+	 * arrives while the screen is blanking, so the display locks and
+	 * immediately wakes again as though the key had been pressed twice.
+	 *
+	 * Use the value the vendor ships for this PMIC: downstream's
+	 * msm-pm8998.dtsi sets qcom,pon-dbc-delay = <31250>, twice the
+	 * generic mainline figure, and the observed chatter falls in the
+	 * window between the two. Hold-to-power-off is measured in seconds
+	 * and is unaffected.
+	 */
+	debounce = <31250>;
+};
+
+&pm8998_resin {
+	linux,code = <KEY_VOLUMEDOWN>;
+	status = "okay";
+};
+
+/*
+ * USB-C.  PMI8998 runs the Type-C port and PD; LG's kernel limits the OTG
+ * boost to 1.25 A on joan (qcom,otg-cl-ua) and prefers the sink role.  The
+ * port driver has the hardware do that Try.SNK itself, so there is no
+ * try-power-role here: TCPM cannot move this port's terminations, and its
+ * own Try.SNK would only stall each attach.  Only a 5 V contract is offered
+ * or requested until the charger is known to handle higher input voltages.
+ */
+&pmi8998_vbus {
+	regulator-min-microamp = <1250000>;
+	regulator-max-microamp = <1250000>;
+	status = "okay";
+};
+
+&pmi8998_typec {
+	vdd-pdphy-supply = <&vreg_l24a_3p075>;
+	status = "okay";
+
+	connector {
+		compatible = "usb-c-connector";
+		label = "USB-C";
+
+		power-role = "dual";
+		data-role = "dual";
+		self-powered;
+
+		vbus-supply = <&pmi8998_vbus>;
+
+		source-pdos = <PDO_FIXED(5000, 1250,
+					 PDO_FIXED_DUAL_ROLE |
+					 PDO_FIXED_USB_COMM |
+					 PDO_FIXED_DATA_SWAP)>;
+		sink-pdos = <PDO_FIXED(5000, 3000,
+				       PDO_FIXED_DUAL_ROLE |
+				       PDO_FIXED_USB_COMM |
+				       PDO_FIXED_DATA_SWAP)>;
+		op-sink-microwatt = <15000000>;
+
+		/*
+		 * DFP_D, DP signalling, receptacle, pins C/D/E. The PHY
+		 * carries USB3 or DP, so every pin assignment parks USB3;
+		 * with D the DP link uses two lanes and USB falls back to
+		 * the USB 2.0 pair, as on LG's kernel.
+		 */
+		altmodes {
+			displayport {
+				svid = /bits/ 16 <0xff01>;
+				vdo = <0x1c46>;
+			};
+		};
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+
+				pmi8998_hs_in: endpoint {
+					remote-endpoint = <&usb3_dwc3_hs>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+
+				pmi8998_ss_in: endpoint {
+					remote-endpoint = <&usb3phy_out>;
+				};
+			};
+
+			port@2 {
+				reg = <2>;
+
+				pmi8998_sbu_out: endpoint {
+					remote-endpoint = <&sbu_mux_in>;
+				};
+			};
+		};
+	};
+};
+
+/*
+ * Rear flash: LG drives both flash channels together into the one LED,
+ * 800 mA each for at most 500 ms.
+ */
+&pmi8998_flash {
+	status = "okay";
+
+	led-0 {
+		function = LED_FUNCTION_FLASH;
+		color = <LED_COLOR_ID_WHITE>;
+		led-sources = <1>, <2>;
+		led-max-microamp = <200000>;
+		flash-max-microamp = <1600000>;
+		flash-max-timeout-us = <500000>;
+	};
+};
+
+&pmi8998_charger {
+	qcom,usb-icl-ua = <1800000>;
+	qcom,fcc-max-ua = <3300000>;
+	/* LG CHG_MONITOR steps, see the skin-thermal charge trips */
+	qcom,fcc-thermal-limits-ua = <2600000 1500000 800000 600000>;
+	#cooling-cells = <2>;
+	monitored-battery = <&battery>;
+	status = "okay";
+};
+
+&pmi8998_fg {
+	power-supplies = <&pmi8998_charger>;
+	monitored-battery = <&battery>;
+	status = "okay";
+};
+
+/ {
+	battery: battery {
+		compatible = "simple-battery";
+		voltage-min-design-microvolt = <3200000>;
+		voltage-max-design-microvolt = <4400000>;
+		charge-full-design-microamp-hours = <3312000>;
+	};
+};
+
+&soc {
+	/*
+	 * APSS watchdog, missing from mainline msm8998.dtsi (address
+	 * from downstream qcom,wdt@17817000). LG's boot chain leaves
+	 * it armed, so a kernel that never pets it resets ~30s in
+	 * even when otherwise healthy.
+	 */
+	watchdog@17817000 {
+		compatible = "qcom,apss-wdt-msm8998", "qcom,kpss-wdt";
+		reg = <0x17817000 0x1000>;
+		clocks = <&sleep_clk>;
+	};
+};
+
+&gpucc {
+	/* The GX GDSC gates VDD_GFX with the GPU's own power domain. */
+	vdd-gfx-supply = <&pm8005_s1>;
+};
+
+/* LG's msm-4.4 kernel (CONFIG_LGE_PM) has LMh throttle at 85 C, not 95 C */
+&lmh_cluster0 {
+	qcom,lmh-temp-low-millicelsius = <84500>;
+	qcom,lmh-temp-high-millicelsius = <85000>;
+};
+
