+ * LG's sensor there, "skin_pmic", is resolved by its thermal-engine to the
+ * vts virtual sensor (thermal_zone34) -- the one skin-thermal models -- plus
+ * a thermistor offset while a charger is attached, which is not carried
+ * over.
+ */
+/ {
+	thermal-zones {
+		skin-thermal {
+			trips {
+				skin_chg_2600: trip-point9 {
+					temperature = <10000>;
+					hysteresis = <1000>;
+					type = "passive";
+				};
