+&tlmm {
+	/*
+	 * <0 4> came in as msm8998 boilerplate -- every mainline board carries it,
+	 * inherited from the MTP reference -- and it covers the whole BLSP1 QUP1
+	 * pin block (gpio0-3, SPI1/UART1/I2C1 muxed). joan actually uses QUP1 as
+	 * I2C for the ES9218P headphone DAC, and downstream drives gpio2/gpio3 with
+	 * function = "blsp_i2c1" under the same TZ firmware we boot, so AP access is
+	 * permitted. Reserving them made pinctrl reject the controller outright:
+	 *   msm8998-pinctrl: error -EINVAL: pin-2 (c175000.i2c)
+	 *   i2c_qup c175000.i2c: error -EINVAL: Error applying setting
