+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/qcom,msm8998-camss.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm MSM8998 CAMSS ISP
+
+maintainers:
+  - Giuseppe Maggio <jertlok@proton.me>
+
+description: |
+  The CAMSS IP is a CSI decoder and ISP present on Qualcomm platforms
+
+properties:
+  compatible:
+    const: qcom,msm8998-camss
+
+  clocks:
+    minItems: 43
+    maxItems: 43
+
+  clock-names:
+    items:
+      - const: ahb
