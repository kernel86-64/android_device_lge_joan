+/*
+ * Sound card. Two MultiMedia frontends feed four backends: SLIMBUS_0 to and
+ * from the WCD9340 (earpiece, analog headphone path and the analog mics),
+ * tertiary MI2S to the TFA9872 loudspeaker amplifier and quaternary MI2S to
+ * the ES9218P headphone DAC.
+ *
+ * compatible is "qcom,sdm845-sndcard" deliberately. sound/soc/qcom/sdm845.c
+ * implements exactly this topology (q6 frontends + wcd934x over SLIMbus) and
+ * its match table says "Do not grow the list for compatible devices", which is
+ * why db845c and yoga-c630 reuse it too. joan has the same codec and the same
+ * DAI shape. If msm8998 later needs behaviour sdm845.c does not provide, this
+ * is the thing to revisit.
+ */
+/ {
+	sound {
+		compatible = "qcom,sdm845-sndcard";
+		model = "LG-V30";
+		status = "okay";
+
+		pinctrl-0 = <&quat_mi2s_default>, <&tert_mi2s_default>;
+		pinctrl-1 = <&quat_mi2s_sleep>;
+		pinctrl-names = "default", "sleep";
+
+		/*
+		 * "Left Spk"/"SPK1 OUT" was copied from db845c, which drives
+		 * WSA881x amps off the codec's SoundWire speaker output.  joan
+		 * has no WSA parts -- its loudspeaker is a TFA98xx on i2c_7 --
+		 * so that route named a widget nothing declares.  Dropped.
+		 *
+		 * The codec's own analog outputs (EAR, HPHL, HPHR) are
+		 * SND_SOC_DAPM_OUTPUT endpoints and need no board route to be
+		 * usable; they are reached by the RX INTn chain kcontrols.
+		 */
+		/*
+		 * joan has three built-in analog mics plus the headset mic; LG's
+		 * own factory test path ("mictest-allmic" in the stock
+		 * mixer_paths_tavil.xml) captures ADC1, ADC2, ADC3 and ADC4
+		 * together, and the camcorder paths use ADC1+ADC3+ADC4.  AMIC4
+		 * reaches ADC4 through the codec's AMIC4_5 SEL mux.
+		 *
+		 * No DMIC route is added.  Every path LG names "*-dmic-*"
+		 * selects analog mics despite the name, and the factory all-mic
+		 * test -- which one would expect to exercise every fitted mic --
+		 * uses only the four analog inputs.  Against that, the camcorder
+		 * paths do select DMIC0 on TX8, and qcom,cdc-dmic-sample-rate is
+		 * set to 4800000 in the stock DTB, so a digital mic cannot be
+		 * ruled out; both of those also appear in Qualcomm's generic
+		 * 8998 configuration, which is the likelier explanation.  Left
+		 * out until something can actually be captured from it.
+		 *
+		 * The mic biases also need the codec MCLK.  Nothing else on the
+		 * capture path depends on it, so without these routes a capture
+		 * with no WCD playback running leaves ANA_BIAS and the codec clock
+		 * off, and the decimators deliver exact zeros.  LG's msm8998
+		 * machine driver adds the same four routes (wcd_audio_paths).
+		 */
+		audio-routing =
+			"RX_BIAS", "MCLK",
+			"MIC BIAS1", "MCLK",
+			"MIC BIAS2", "MCLK",
+			"MIC BIAS3", "MCLK",
+			"MIC BIAS4", "MCLK",
+			"AMIC1", "MIC BIAS1",
+			"AMIC2", "MIC BIAS2",
+			"AMIC3", "MIC BIAS3",
+			"AMIC4", "MIC BIAS4";
+
+		mm1-dai-link {
+			link-name = "MultiMedia1";
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
+			};
+		};
+
+		mm2-dai-link {
+			link-name = "MultiMedia2";
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA2>;
+			};
+		};
+
+		mm3-dai-link {
+			link-name = "MultiMedia3";
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA3>;
+			};
+		};
+
+		mm4-dai-link {
+			link-name = "MultiMedia4";
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA4>;
+			};
+		};
+
+		mm5-dai-link {
+			link-name = "MultiMedia5";
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA5>;
+			};
+		};
+
+		mm6-dai-link {
+			link-name = "MultiMedia6";
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA6>;
+			};
+		};
+
+		mm7-dai-link {
+			link-name = "MultiMedia7";
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA7>;
+			};
+		};
+
+		slim-playback-dai-link {
+			link-name = "SLIM Playback";
+			cpu {
+				sound-dai = <&q6afedai SLIMBUS_0_RX>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+
+			codec {
+				sound-dai = <&wcd9340 0>;
+			};
+		};
+
+		tert-mi2s-dai-link {
+			link-name = "Tertiary MI2S Playback";
+
+			cpu {
+				sound-dai = <&q6afedai TERTIARY_MI2S_RX>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+
+			codec {
+				sound-dai = <&speaker_amp>;
+			};
+		};
+
+		quat-mi2s-dai-link {
+			link-name = "Quaternary MI2S Playback";
+
+			cpu {
+				sound-dai = <&q6afedai QUATERNARY_MI2S_RX>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+
+			codec {
+				sound-dai = <&es9218p>;
+			};
+		};
+
+		slim-capture-dai-link {
+			link-name = "SLIM Capture";
+			cpu {
+				sound-dai = <&q6afedai SLIMBUS_0_TX>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+
+			codec {
+				sound-dai = <&wcd9340 1>;
+			};
+		};
+
+		slim2-playback-dai-link {
+			link-name = "SLIM Playback 2";
+			cpu {
+				sound-dai = <&q6afedai SLIMBUS_1_RX>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+
+			codec {
+				sound-dai = <&wcd9340 2>; /* AIF2_PB */
+			};
+		};
+
+		slim2-capture-dai-link {
+			link-name = "SLIM Capture 2";
+			cpu {
+				sound-dai = <&q6afedai SLIMBUS_1_TX>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+
+			codec {
+				sound-dai = <&wcd9340 3>; /* AIF2_CAP */
+			};
+		};
+
+		slim3-capture-dai-link {
+			link-name = "SLIM Capture 3";
+			cpu {
+				sound-dai = <&q6afedai SLIMBUS_2_TX>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+
+			codec {
+				sound-dai = <&wcd9340 5>; /* AIF3_CAP */
+			};
+		};
+
+		/*
+		 * The SLIMBUS_8_TX "FM Capture" backend comes back together with
+		 * the WCN3990 slim2 wiring below; without the codec dai it would
+		 * defer the whole sound card forever.
+		 */
+	};
+};
+
+/*
+ * q6asm/q6afe DAI children. Both drivers count child nodes at probe --
+ * q6asm-dai fails with "No dais found in DT" / -EINVAL without them -- so the
+ * frontends and backends actually in use have to be declared here.
+ */
+&q6asmdai {
+	dai@0 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA1>;
+	};
+
+	dai@1 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA2>;
+	};
+
+	dai@2 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA3>;
+	};
+
+	dai@3 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA4>;
+	};
+
+	dai@4 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA5>;
+	};
+
+	dai@5 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA6>;
+	};
+
+	dai@6 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA7>;
+	};
+};
+
+/*
+ * WCN3990 (Bluetooth/FM): the second NGD engine stays OFF for now.
+ *
+ * Downstream declares the FM/BT slave under the second engine
+ * (slim@17240000, cell-index 3) on elemental address [00 01 20 02 17 02]
+ * -- manufacturer 0x217, product 0x220 -- which is the mainline form
+ * "slim217,220", and the interface device on [00 00 20 02 17 02]
+ * (device index 0).  The chip is powered by the Bluetooth stack, not by
+ * a DT regulator, like downstream.
+ *
+ * Enabling slim2/slimbam2 hard-hung the phone ~10 s into boot (r34):
+ * the first read of the engine register block stalls the bus even though
+ * the ADSP ACKed the SLIMBUS QMI select-instance(1) and power-on
+ * requests the driver completes before its first MMIO (bisect branch
+ * joan/ngd-bisect-oldbase: reverting only the register-base change
+ * restores boot).  Nothing in the mainline flow proves the engine is
+ * clocked before that read, so slim2 and slimbam2 keep the
+ * msm8998.dtsi status = "disabled" until an engine bring-up sequence
+ * is found.  Bench candidates to sequence the engine: the per-engine
+ * PDR client name downstream registers ("appsngd%d", slim-msm.c
+ * ngd_dom_init) instead of the shared audio-PD lookup, its power-request
+ * retries (ngd_slim_power_up), or a delayed enable once the audio PD
+ * has quiesced.  Re-enabling means: status "okay" for slim2 and
+ * slimbam2, the slim@3 bus with the two slim217,220 devices as before,
+ * and the SLIMBUS_8_TX "FM Capture" dai-link restored in the sound
+ * node.
+ */
+
+/* Match the downstream WCD934x CDC SLIMbus slave configuration. */
+&q6afe {
+	qcom,cdc-slimbus-slave-config = <0x02500100 0x00000217 0 16>;
+};
+
+&q6afedai {
+	dai@2 {
+		reg = <SLIMBUS_0_RX>;
+	};
+
+	dai@3 {
+		reg = <SLIMBUS_0_TX>;
+	};
+
+	dai@4 {
+		reg = <SLIMBUS_1_RX>;
+	};
+
+	dai@5 {
+		reg = <SLIMBUS_1_TX>;
+	};
+
+	dai@7 {
+		reg = <SLIMBUS_2_TX>;
+	};
+
+	dai@152 {
+		reg = <SLIMBUS_8_TX>;
+	};
+
+	dai@20 {
+		reg = <TERTIARY_MI2S_RX>;
+		qcom,sd-lines = <1>;
+	};
+
+	dai@22 {
+		reg = <QUATERNARY_MI2S_RX>;
+		qcom,sd-lines = <1>;
+	};
+};
+
+/*
+ * Thermal policy, following LG's stock thermal-engine-8998.conf (LG joan
+ * vendor blobs) and msm_thermal DT, as far as kernel thermal zones can.
+ *
+ * Skin: the stock policy throttles on "vts", LG's virtual skin sensor
+ * 0.37 * xo_therm + 0.48 * bd_therm_2 + 3.83 C (LG kernel lge,vts). The caps
+ * and clear points below are the stock SKIN-*-FLOOR and GPU_MONITOR entries.
+ * Cooling states index each policy's frequency table from the top: gold
+ * 2457.6 MHz (the one-core boost row) is state 0, 2361.6 is 1, 1958.4 is 8,
+ * 1728 is 11, 1056 is 20, 729.6 is 24;
+ * silver 1555.2 is state 4; GPU 670 MHz is 1, 515 is 3, 414 is 4, 342 is 5.
+ * The stock SKIN-MID-FLOOR reads "skin_ap", which has no mainline
+ * counterpart, so it uses vts here.
+ */
+&pm8998_adc {
+	channel@4c {
+		reg = <ADC5_XO_THERM_100K_PU>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		label = "xo_therm";
+	};
+
+	channel@4f {
+		reg = <ADC5_AMUX_THM3_100K_PU>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		label = "pa_therm0";
+	};
+
+	channel@50 {
+		reg = <ADC5_AMUX_THM4_100K_PU>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		label = "pa_therm1";
+	};
+
+	channel@51 {
+		reg = <ADC5_AMUX_THM5_100K_PU>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		label = "bd_therm_2";
+	};
+};
+
+/ {
+	skin_vts: thermal-sensor-vts {
+		compatible = "weighted-adc-thermal";
+		io-channels = <&pm8998_adc ADC5_XO_THERM_100K_PU>,
+			      <&pm8998_adc ADC5_AMUX_THM5_100K_PU>;
+		weights-milli = <370 480>;
+		offset-millicelsius = <3830>;
+		#thermal-sensor-cells = <0>;
+	};
+
+	thermal-zones {
+		skin-thermal {
+			polling-delay-passive = <2000>;
+			polling-delay = <5000>;
+			thermal-sensors = <&skin_vts>;
+
+			trips {
+				skin_gold_1958: trip-point0 {
+					temperature = <37000>;
+					hysteresis = <500>;
+					type = "passive";
+				};
+
+				skin_gpu_670: trip-point1 {
+					temperature = <38000>;
+					hysteresis = <500>;
+					type = "passive";
+				};
+
+				skin_gold_1728: trip-point2 {
