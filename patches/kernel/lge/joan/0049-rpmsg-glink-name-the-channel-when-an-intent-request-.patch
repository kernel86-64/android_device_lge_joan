From 4982963e5dc47bd152c11dfe57fafc59618a5487 Mon Sep 17 00:00:00 2001
From: scada <scada@noreply.codeberg.org>
Date: Sat, 24 Oct 2026 23:19:33 +0000
Subject: [PATCH 49/80] rpmsg: glink: name the channel when an intent request
 times out

"intent request timed out" only names the glink-edge device, which on
msm8998 is shared by every ADSP channel (APR, IPCRTR, glink_ssr), so the
log cannot say which one is stuck. Print the channel name and both ids,
and add dev_dbg for the intent grant/intent receipt path so a wedged
channel can be followed with dynamic debug.

Also enable CONFIG_DYNAMIC_DEBUG so those dev_dbg() calls exist at all;
the console runs at loglevel 8 for this bring-up so they land in
pstore/ramoops as well.
---
 arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts |  63 ++
 arch/arm64/configs/joan_defconfig            |   6 +
 drivers/input/Kconfig                        |   2 +
 drivers/input/Makefile                       |   1 +
 drivers/input/fingerprint/Kconfig            |  21 +
 drivers/input/fingerprint/Makefile           |   6 +
 drivers/input/fingerprint/fpc1020_platform.c | 751 +++++++++++++++++++
 drivers/rpmsg/qcom_glink_native.c            |   9 +-
 8 files changed, 858 insertions(+), 1 deletion(-)
 create mode 100644 drivers/input/fingerprint/Kconfig
 create mode 100644 drivers/input/fingerprint/Makefile
 create mode 100644 drivers/input/fingerprint/fpc1020_platform.c

diff --git a/arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts b/arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts
index 352e786da399..518da1543c3e 100644
--- a/arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts
+++ b/arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts
@@ -2598,3 +2598,66 @@ map0 {
 		};
 	};
 };
+
+/*
+ * FPC1022 fingerprint sensor.
+ *
+ * Only the electrical side lives here: the sensor's SPI traffic and all
+ * matching run inside LG's TrustZone application (fpctzapp).  The
+ * compatible string and the reset/IRQ GPIOs match the downstream
+ * msm8998-fingerprint-fpc1022.dtsi; the driver exposes the legacy FPC
+ * sysfs ABI at /sys/devices/virtual/input/lge_fingerprint for the
+ * prebuilt joan fingerprint HAL.
+ */
+&soc {
+	fp_fpc1020: fingerprint {
+		compatible = "fpc,fpc1020";
+		status = "okay";
+
+		interrupt-parent = <&tlmm>;
+		interrupts = <121 IRQ_TYPE_EDGE_RISING>;
+
+		reset-gpios = <&tlmm 27 GPIO_ACTIVE_HIGH>;
+		irq-gpios = <&tlmm 121 GPIO_ACTIVE_HIGH>;
+
+		vdd_io-supply = <&vreg_lvs2a_1p8>;
+
+		fpc,enable-on-boot;
+		fpc,enable-wakeup;
+
+		pinctrl-names = "fpc1020_reset_reset",
+				"fpc1020_reset_active",
+				"fpc1020_irq_active";
+		pinctrl-0 = <&fpc1020_reset_reset>;
+		pinctrl-1 = <&fpc1020_reset_active>;
+		pinctrl-2 = <&fpc1020_irq_active>;
+	};
+};
+
+&tlmm {
+	/* GPIO 27: FP_RESET_N, asserted (low) */
+	fpc1020_reset_reset: fpc1020-reset-reset-state {
+		pins = "gpio27";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+		output-low;
+	};
+
+	/* GPIO 27: FP_RESET_N, released (high) */
+	fpc1020_reset_active: fpc1020-reset-active-state {
+		pins = "gpio27";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+		output-high;
+	};
+
+	/* GPIO 121: FP_INT_N */
+	fpc1020_irq_active: fpc1020-irq-active-state {
+		pins = "gpio121";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+};
