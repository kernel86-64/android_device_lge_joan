diff --git a/drivers/input/fingerprint/fpc1020_platform.c b/drivers/input/fingerprint/fpc1020_platform.c
new file mode 100644
index 000000000000..e1cd7d4983ac
--- /dev/null
+++ b/drivers/input/fingerprint/fpc1020_platform.c
@@ -0,0 +1,751 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * FPC1020/FPC1022 fingerprint sensor platform driver
+ *
+ * This driver owns only the electrical side of the sensor: the 1.8 V
+ * vdd_io rail, the reset line, the IRQ line and the wakeup source.  The
+ * actual fingerprint acquisition and matching run inside LG's TrustZone
+ * application (fpctzapp); no SPI traffic ever leaves the non-secure side.
+ *
+ * The sysfs ABI is deliberately identical to the LineageOS 22
+ * fpc1020_platform_tee driver because the prebuilt joan fingerprint HAL
+ * hard-codes it:
+ *
+ *   /sys/devices/virtual/input/lge_fingerprint/{clk_enable,device_prepare,
+ *       wakeup_enable,irq,pinctl_set,regulator_enable,hw_reset}
+ *
+ * The input device is intentionally *not* devm-allocated with a parent:
+ * the HAL expects the virtual/input path, which only happens when the
+ * input device has no parent device.
+ *
+ * Copyright (c) 2015 Fingerprint Cards AB <tech@fingerprints.com>
+ * Copyright (c) 2026 The joan mainline contributors
+ */
+
+#include <linux/atomic.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/gpio/consumer.h>
+#include <linux/input.h>
+#include <linux/interrupt.h>
+#include <linux/jiffies.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_wakeup.h>
+#include <linux/pinctrl/consumer.h>
+#include <linux/regulator/consumer.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+#include <linux/sysfs.h>
+#include <linux/workqueue.h>
+
+#define FPC_TTW_HOLD_TIME_MS	1000
+
+#define RESET_LOW_SLEEP_MIN_US		5000
+#define RESET_LOW_SLEEP_MAX_US		(RESET_LOW_SLEEP_MIN_US + 100)
+#define RESET_HIGH_SLEEP1_MIN_US	100
+#define RESET_HIGH_SLEEP1_MAX_US	(RESET_HIGH_SLEEP1_MIN_US + 100)
+#define RESET_HIGH_SLEEP2_MIN_US	5000
+#define RESET_HIGH_SLEEP2_MAX_US	(RESET_HIGH_SLEEP2_MIN_US + 100)
+#define PWR_ON_SLEEP_MIN_US		100
+#define PWR_ON_SLEEP_MAX_US		(PWR_ON_SLEEP_MIN_US + 900)
+
+#define VDD_IO_MIN_UV			1800000
+#define VDD_IO_MAX_UV			1800000
+
+/*
+ * IRQ storm protection.
+ *
+ * The sensor IRQ is an edge triggered "something happened" line and is
+ * expected to stay in the tens of interrupts per second at most.  A
+ * shorted or otherwise broken line can instead toggle at kHz rates and
+ * keep both the hardirq and the threaded handler busy forever.  If more
+ * than FPC_IRQ_STORM_MAX interrupts arrive inside one window, mask the
+ * line and re-arm it from a delayed work after a cool-down.  Re-arming
+ * cannot depend on a sysfs access: the HAL blocks in poll() on the "irq"
+ * attribute and would never issue one while the line is masked.
+ */
+#define FPC_IRQ_STORM_WINDOW_MS		1000
+#define FPC_IRQ_STORM_MAX		256
+#define FPC_IRQ_STORM_COOLDOWN_MS	1000
+
+static const char *const pctl_names[] = {
+	"fpc1020_reset_reset",
+	"fpc1020_reset_active",
+	"fpc1020_irq_active",
+};
+
+struct fpc1020_data {
+	struct device *dev;
+	struct input_dev *input;
+
+	struct pinctrl *fingerprint_pinctrl;
+	struct pinctrl_state *pinctrl_state[ARRAY_SIZE(pctl_names)];
+
+	struct regulator *vdd_io;
+	bool vdd_io_enabled;
+
+	struct gpio_desc *reset_gpiod;
+	struct gpio_desc *irq_gpiod;
+	int irq;
+
+	/* Serializes the sysfs-visible power/reset state. */
+	struct mutex lock;
+	bool prepared;
+
+	atomic_t wakeup_enabled;
+	bool irq_wake_enabled;
+	bool wakeup_capable;
+
+	/* IRQ storm mitigation, see above. */
+	spinlock_t irq_lock;
+	unsigned long storm_window;
+	unsigned int storm_count;
+	bool irq_storm;
+	bool irq_gone;
+	unsigned long irq_reenable_at;
+	struct delayed_work irq_reenable_work;
+};
+
+static int fpc1020_select_pin_ctl(struct fpc1020_data *fpc, const char *name)
+{
+	size_t i;
+	int rc;
+
+	for (i = 0; i < ARRAY_SIZE(fpc->pinctrl_state); i++) {
+		if (!sysfs_streq(name, pctl_names[i]))
+			continue;
+
+		rc = pinctrl_select_state(fpc->fingerprint_pinctrl,
+					  fpc->pinctrl_state[i]);
+		if (rc)
+			dev_err(fpc->dev, "cannot select '%s': %d\n", name, rc);
+		else
+			dev_dbg(fpc->dev, "selected '%s'\n", name);
+
+		return rc;
+	}
+
+	dev_err(fpc->dev, "%s: '%s' not found\n", __func__, name);
+
+	return -EINVAL;
+}
+
+static int fpc1020_vdd_io_set(struct fpc1020_data *fpc, bool enable)
+{
+	int rc;
+
+	if (!fpc->vdd_io)
+		return 0;
+
+	if (enable) {
+		if (fpc->vdd_io_enabled)
+			return 0;
+
+		if (regulator_count_voltages(fpc->vdd_io) > 0) {
+			rc = regulator_set_voltage(fpc->vdd_io, VDD_IO_MIN_UV,
+						   VDD_IO_MAX_UV);
+			/*
+			 * Fixed RPM rails such as pm8998_lvs2 commonly reject
+			 * set_voltage(); the level is already correct, so only
+			 * log this instead of refusing to power the sensor.
+			 */
+			if (rc)
+				dev_warn(fpc->dev,
+					 "cannot set vdd_io to 1.8 V: %d\n", rc);
+		}
+
+		rc = regulator_enable(fpc->vdd_io);
+		if (rc) {
+			dev_err(fpc->dev, "cannot enable vdd_io: %d\n", rc);
+			return rc;
+		}
+
+		fpc->vdd_io_enabled = true;
+	} else if (fpc->vdd_io_enabled) {
+		rc = regulator_disable(fpc->vdd_io);
+		if (rc) {
+			dev_err(fpc->dev, "cannot disable vdd_io: %d\n", rc);
+			return rc;
+		}
+
+		fpc->vdd_io_enabled = false;
+	}
+
+	return 0;
+}
+
+/*
+ * The following helpers must be called with fpc->lock held (or during
+ * probe/remove, where no userspace can race yet).
+ */
+
+static int fpc1020_hw_reset(struct fpc1020_data *fpc)
+{
+	int level;
+	int rc;
+
+	rc = fpc1020_select_pin_ctl(fpc, "fpc1020_reset_active");
+	if (rc)
+		return rc;
+	usleep_range(RESET_HIGH_SLEEP1_MIN_US, RESET_HIGH_SLEEP1_MAX_US);
+
+	rc = fpc1020_select_pin_ctl(fpc, "fpc1020_reset_reset");
+	if (rc)
+		return rc;
+	usleep_range(RESET_LOW_SLEEP_MIN_US, RESET_LOW_SLEEP_MAX_US);
+
+	rc = fpc1020_select_pin_ctl(fpc, "fpc1020_reset_active");
+	if (rc)
+		return rc;
+	usleep_range(RESET_HIGH_SLEEP2_MIN_US, RESET_HIGH_SLEEP2_MAX_US);
+
+	level = gpiod_get_value(fpc->irq_gpiod);
+	dev_info(fpc->dev, "IRQ after reset %d\n", level);
+
+	return 0;
+}
+
+static int fpc1020_device_prepare(struct fpc1020_data *fpc, bool enable)
+{
+	int rc = 0;
+
+	mutex_lock(&fpc->lock);
+
+	if (enable && !fpc->prepared) {
+		/* Reset must be low before the rail comes up. */
+		(void)fpc1020_select_pin_ctl(fpc, "fpc1020_reset_reset");
+		rc = fpc1020_vdd_io_set(fpc, true);
+		if (rc)
+			goto out;
+
+		fpc->prepared = true;
+		usleep_range(PWR_ON_SLEEP_MIN_US, PWR_ON_SLEEP_MAX_US);
+
+		/*
+		 * The TEE driver performs a soft reset over SPI after power
+		 * up; releasing reset here is all the non-secure side does.
+		 */
+		(void)fpc1020_select_pin_ctl(fpc, "fpc1020_reset_active");
+	} else if (!enable && fpc->prepared) {
+		(void)fpc1020_select_pin_ctl(fpc, "fpc1020_reset_reset");
+		usleep_range(PWR_ON_SLEEP_MIN_US, PWR_ON_SLEEP_MAX_US);
+
+		fpc->prepared = false;
+		rc = fpc1020_vdd_io_set(fpc, false);
+	}
+
+out:
+	mutex_unlock(&fpc->lock);
+
+	return rc;
+}
+
+static ssize_t clk_enable_store(struct device *dev,
+				struct device_attribute *attr, const char *buf,
+				size_t count)
+{
+	/* Kept for ABI compatibility; this platform has no sensor clock. */
+	dev_dbg(dev, "clk_enable is a no-op on this platform\n");
+
+	return count;
+}
+static DEVICE_ATTR_WO(clk_enable);
+
+static ssize_t pinctl_set_store(struct device *dev,
+				struct device_attribute *attr,
+				const char *buf, size_t count)
+{
+	struct fpc1020_data *fpc = dev_get_drvdata(dev);
+	int rc;
+
+	mutex_lock(&fpc->lock);
+	rc = fpc1020_select_pin_ctl(fpc, buf);
+	mutex_unlock(&fpc->lock);
+
+	return rc ? rc : count;
+}
+static DEVICE_ATTR_WO(pinctl_set);
+
+static ssize_t regulator_enable_store(struct device *dev,
+				      struct device_attribute *attr,
+				      const char *buf, size_t count)
+{
+	struct fpc1020_data *fpc = dev_get_drvdata(dev);
+	char name[16];
+	char op;
+	int rc;
+
+	if (sscanf(buf, "%15[^,],%c", name, &op) != 2)
+		return -EINVAL;
+	if (strcmp(name, "vdd_io") != 0)
+		return -EINVAL;
+	if (op != 'e' && op != 'd')
+		return -EINVAL;
+
+	mutex_lock(&fpc->lock);
+	rc = fpc1020_vdd_io_set(fpc, op == 'e');
+	mutex_unlock(&fpc->lock);
+
+	return rc ? rc : count;
+}
+static DEVICE_ATTR_WO(regulator_enable);
+
+static ssize_t hw_reset_store(struct device *dev,
+			      struct device_attribute *attr,
+			      const char *buf, size_t count)
+{
+	struct fpc1020_data *fpc = dev_get_drvdata(dev);
+	int rc;
+
+	if (!sysfs_streq(buf, "reset"))
+		return -EINVAL;
+
+	mutex_lock(&fpc->lock);
+	rc = fpc1020_hw_reset(fpc);
+	mutex_unlock(&fpc->lock);
+
+	return rc ? rc : count;
+}
+static DEVICE_ATTR_WO(hw_reset);
+
+static ssize_t device_prepare_store(struct device *dev,
+				    struct device_attribute *attr,
+				    const char *buf, size_t count)
+{
+	struct fpc1020_data *fpc = dev_get_drvdata(dev);
+	bool enable;
+	int rc;
+
+	if (sysfs_streq(buf, "enable"))
+		enable = true;
+	else if (sysfs_streq(buf, "disable"))
+		enable = false;
+	else
+		return -EINVAL;
+
+	rc = fpc1020_device_prepare(fpc, enable);
+
+	return rc ? rc : count;
+}
+static DEVICE_ATTR_WO(device_prepare);
+
+static ssize_t wakeup_enable_store(struct device *dev,
+				   struct device_attribute *attr,
+				   const char *buf, size_t count)
+{
+	struct fpc1020_data *fpc = dev_get_drvdata(dev);
+
+	if (sysfs_streq(buf, "enable"))
+		atomic_set(&fpc->wakeup_enabled, 1);
+	else if (sysfs_streq(buf, "disable"))
+		atomic_set(&fpc->wakeup_enabled, 0);
+	else
+		return -EINVAL;
+
+	return count;
+}
+static DEVICE_ATTR_WO(wakeup_enable);
+
+/*
+ * Re-arm an IRQ masked by the storm detector.  This is the only place
+ * that calls enable_irq() for a masked line: doing it from a sysfs
+ * callback would race with free_irq() during unbind, and the HAL blocks
+ * in poll(POLLPRI) anyway, so it would rarely be reached in time.
+ */
+static void fpc1020_irq_reenable_work(struct work_struct *work)
+{
+	struct fpc1020_data *fpc = container_of(to_delayed_work(work),
+						struct fpc1020_data,
+						irq_reenable_work);
+	unsigned long flags;
+	unsigned long delay = 0;
+	bool reenable = false;
+
+	spin_lock_irqsave(&fpc->irq_lock, flags);
+	if (fpc->irq_storm && !fpc->irq_gone) {
+		if (time_before(jiffies, fpc->irq_reenable_at)) {
+			delay = fpc->irq_reenable_at - jiffies;
+		} else {
+			fpc->irq_storm = false;
+			fpc->storm_count = 0;
+			fpc->storm_window = jiffies;
+			reenable = true;
+		}
+	}
+	spin_unlock_irqrestore(&fpc->irq_lock, flags);
+
+	if (delay) {
+		schedule_delayed_work(&fpc->irq_reenable_work, delay);
+		return;
+	}
+
+	if (reenable) {
+		enable_irq(fpc->irq);
+		dev_warn(fpc->dev, "IRQ re-enabled after storm\n");
+	}
+}
+
+/*
+ * The HAL opens this attribute and blocks in poll(POLLPRI); the interrupt
+ * handler notifies it through sysfs_notify().  Reading returns the raw
+ * level of the (active high) interrupt line, as the downstream driver did.
+ */
+static ssize_t irq_get(struct device *dev, struct device_attribute *attr,
+		       char *buf)
+{
+	struct fpc1020_data *fpc = dev_get_drvdata(dev);
+	int level;
+
+	level = gpiod_get_value(fpc->irq_gpiod);
+
+	return sysfs_emit(buf, "%d\n", level);
+}
+
+static ssize_t irq_ack(struct device *dev, struct device_attribute *attr,
+		       const char *buf, size_t count)
+{
+	return count;
+}
+/*
+ * 0600 here, matching the downstream ABI; init.lge.fingerprints.rc
+ * chowns it to system and relaxes it to 0644 at boot.
+ */
+static DEVICE_ATTR(irq, 0600, irq_get, irq_ack);
+
+static irqreturn_t fpc1020_irq_handler(int irq, void *handle)
+{
+	struct fpc1020_data *fpc = handle;
+	unsigned long flags;
+	bool storm = false;
+
+	spin_lock_irqsave(&fpc->irq_lock, flags);
+
+	if (fpc->irq_gone) {
+		spin_unlock_irqrestore(&fpc->irq_lock, flags);
+		return IRQ_HANDLED;
+	}
+
+	if (time_after(jiffies, fpc->storm_window +
+		       msecs_to_jiffies(FPC_IRQ_STORM_WINDOW_MS))) {
+		fpc->storm_window = jiffies;
+		fpc->storm_count = 0;
+	}
+
+	if (++fpc->storm_count > FPC_IRQ_STORM_MAX && !fpc->irq_storm) {
+		fpc->irq_storm = true;
+		fpc->irq_reenable_at = jiffies +
+			msecs_to_jiffies(FPC_IRQ_STORM_COOLDOWN_MS);
+		storm = true;
+	}
+
+	spin_unlock_irqrestore(&fpc->irq_lock, flags);
+
+	if (storm) {
+		/*
+		 * The threaded handler is the only thing that can mask this
+		 * safely: a hardirq-context disable would deadlock against
+		 * the oneshot unmask.  irq_finalize_oneshot() honors
+		 * IRQ_DISABLED, so the line stays masked.
+		 */
+		disable_irq_nosync(irq);
+		dev_err(fpc->dev,
+			"IRQ storm: over %u interrupts in %u ms, masking for %u ms\n",
+			FPC_IRQ_STORM_MAX, FPC_IRQ_STORM_WINDOW_MS,
+			FPC_IRQ_STORM_COOLDOWN_MS);
+		schedule_delayed_work(&fpc->irq_reenable_work,
+				      msecs_to_jiffies(FPC_IRQ_STORM_COOLDOWN_MS));
+		return IRQ_HANDLED;
+	}
+
+	if (atomic_read(&fpc->wakeup_enabled))
+		pm_wakeup_event(fpc->dev, FPC_TTW_HOLD_TIME_MS);
+
+	sysfs_notify(&fpc->input->dev.kobj, NULL, dev_attr_irq.attr.name);
+
+	return IRQ_HANDLED;
+}
+
+static struct attribute *fpc1020_attributes[] = {
+	&dev_attr_pinctl_set.attr,
+	&dev_attr_device_prepare.attr,
+	&dev_attr_regulator_enable.attr,
+	&dev_attr_hw_reset.attr,
+	&dev_attr_wakeup_enable.attr,
+	&dev_attr_clk_enable.attr,
+	&dev_attr_irq.attr,
+	NULL
+};
+
+static const struct attribute_group fpc1020_attribute_group = {
+	.attrs = fpc1020_attributes,
+};
+
+static const struct attribute_group *fpc1020_attribute_groups[] = {
+	&fpc1020_attribute_group,
+	NULL
+};
+
+/*
+ * Quiesce the interrupt side before the input device (whose kobject the
+ * handler notifies) or the driver data go away.  The "gone" flag is set
+ * under irq_lock so neither the handler nor a sysfs access can queue
+ * more work or touch the line after free_irq().
+ */
+static void fpc1020_irq_teardown(struct fpc1020_data *fpc)
+{
+	unsigned long flags;
+
+	cancel_delayed_work_sync(&fpc->irq_reenable_work);
+
+	spin_lock_irqsave(&fpc->irq_lock, flags);
+	fpc->irq_gone = true;
+	fpc->irq_storm = false;
+	fpc->storm_count = 0;
+	spin_unlock_irqrestore(&fpc->irq_lock, flags);
+
+	if (fpc->irq_wake_enabled) {
+		disable_irq_wake(fpc->irq);
+		fpc->irq_wake_enabled = false;
+	}
+
+	/*
+	 * The line may still be masked by the storm detector; free_irq()
+	 * shuts a disabled descriptor down just fine, and re-enabling it
+	 * here would only open a window for another storm.
+	 */
+	devm_free_irq(fpc->dev, fpc->irq, fpc);
+
+	/*
+	 * A threaded handler that was already past its irq_gone check can
+	 * have queued the re-arm work after the first cancel above.
+	 * free_irq() has waited for that handler, so nothing can queue the
+	 * work any more; cancel it once more before the driver data goes
+	 * away.  (The work itself rejects irq_storm after the state reset,
+	 * so it cannot touch the freed IRQ either way.)
+	 */
+	cancel_delayed_work_sync(&fpc->irq_reenable_work);
+}
+
+static int fpc1020_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np = dev->of_node;
+	struct fpc1020_data *fpc;
+	unsigned long irq_flags = IRQF_ONESHOT;
+	int rc;
+	size_t i;
+
+	fpc = devm_kzalloc(dev, sizeof(*fpc), GFP_KERNEL);
+	if (!fpc)
+		return -ENOMEM;
+
+	fpc->dev = dev;
+	platform_set_drvdata(pdev, fpc);
+
+	mutex_init(&fpc->lock);
+	spin_lock_init(&fpc->irq_lock);
+	INIT_DELAYED_WORK(&fpc->irq_reenable_work, fpc1020_irq_reenable_work);
+	atomic_set(&fpc->wakeup_enabled, 0);
+
+	if (!np) {
+		dev_err(dev, "no OF node\n");
+		return -EINVAL;
+	}
+
+	fpc->reset_gpiod = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(fpc->reset_gpiod)) {
+		rc = PTR_ERR(fpc->reset_gpiod);
+		if (rc != -EPROBE_DEFER)
+			dev_err(dev, "cannot get reset GPIO: %d\n", rc);
+		return rc;
+	}
+
+	fpc->irq_gpiod = devm_gpiod_get(dev, "irq", GPIOD_IN);
+	if (IS_ERR(fpc->irq_gpiod)) {
+		rc = PTR_ERR(fpc->irq_gpiod);
+		if (rc != -EPROBE_DEFER)
+			dev_err(dev, "cannot get IRQ GPIO: %d\n", rc);
+		return rc;
+	}
+
+	fpc->irq = platform_get_irq(pdev, 0);
+	if (fpc->irq < 0) {
+		dev_err(dev, "cannot get IRQ: %d\n", fpc->irq);
+		return fpc->irq;
+	}
+
+	fpc->vdd_io = devm_regulator_get_optional(dev, "vdd_io");
+	if (IS_ERR(fpc->vdd_io)) {
+		rc = PTR_ERR(fpc->vdd_io);
+		if (rc == -ENODEV) {
+			dev_warn(dev, "no vdd_io supply, power control unavailable\n");
+			fpc->vdd_io = NULL;
+		} else {
+			if (rc != -EPROBE_DEFER)
+				dev_err(dev, "cannot get vdd_io: %d\n", rc);
+			return rc;
+		}
+	}
+
+	fpc->fingerprint_pinctrl = devm_pinctrl_get(dev);
+	if (IS_ERR(fpc->fingerprint_pinctrl)) {
+		rc = PTR_ERR(fpc->fingerprint_pinctrl);
+		if (rc != -EPROBE_DEFER)
+			dev_err(dev, "cannot get pinctrl: %d\n", rc);
+		return rc;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(fpc->pinctrl_state); i++) {
+		fpc->pinctrl_state[i] = pinctrl_lookup_state(
+				fpc->fingerprint_pinctrl, pctl_names[i]);
+		if (IS_ERR(fpc->pinctrl_state[i])) {
+			rc = PTR_ERR(fpc->pinctrl_state[i]);
+			dev_err(dev, "cannot find pinctrl state '%s': %d\n",
+				pctl_names[i], rc);
+			return rc;
+		}
+	}
+
+	rc = fpc1020_select_pin_ctl(fpc, "fpc1020_reset_reset");
+	if (rc)
+		return rc;
+	rc = fpc1020_select_pin_ctl(fpc, "fpc1020_irq_active");
+	if (rc)
+		return rc;
+
+	/*
+	 * A plain input device (no parent!) keeps the traditional
+	 * /sys/devices/virtual/input/lge_fingerprint path the HAL opens.
+	 */
+	fpc->input = input_allocate_device();
+	if (!fpc->input) {
+		dev_err(dev, "input_allocate_device failed\n");
+		return -ENOMEM;
+	}
+
+	fpc->input->name = "fingerprint";
+	rc = dev_set_name(&fpc->input->dev, "lge_fingerprint");
+	if (rc) {
+		dev_err(dev, "cannot name input device: %d\n", rc);
+		goto err_free_input;
+	}
+	fpc->input->dev.groups = fpc1020_attribute_groups;
+	input_set_drvdata(fpc->input, fpc);
+
+	rc = input_register_device(fpc->input);
+	if (rc) {
+		dev_err(dev, "input_register_device failed: %d\n", rc);
+		goto err_free_input;
+	}
+
+	if (of_property_read_bool(np, "fpc,enable-wakeup")) {
+		irq_flags |= IRQF_NO_SUSPEND;
+
+		rc = device_init_wakeup(dev, true);
+		if (rc)
+			dev_warn(dev, "cannot init wakeup source: %d\n", rc);
+		else
+			fpc->wakeup_capable = true;
+	}
+
+	rc = devm_request_threaded_irq(dev, fpc->irq, NULL,
+				       fpc1020_irq_handler, irq_flags,
+				       dev_name(dev), fpc);
+	if (rc) {
+		dev_err(dev, "cannot request IRQ %d: %d\n", fpc->irq, rc);
+		goto err_unregister_input;
+	}
+
+	if (fpc->wakeup_capable) {
+		rc = enable_irq_wake(fpc->irq);
+		if (rc)
+			dev_warn(dev, "cannot enable IRQ wake: %d\n", rc);
+		else
+			fpc->irq_wake_enabled = true;
+	}
+
+	if (of_property_read_bool(np, "fpc,enable-on-boot")) {
+		dev_info(dev, "powering sensor on\n");
+		rc = fpc1020_device_prepare(fpc, true);
+		if (rc)
+			dev_err(dev, "could not power sensor on: %d\n", rc);
+	}
+
+	mutex_lock(&fpc->lock);
+	rc = fpc1020_hw_reset(fpc);
+	mutex_unlock(&fpc->lock);
+	if (rc) {
+		dev_err(dev, "initial hardware reset failed: %d\n", rc);
+		goto err_free_irq;
+	}
+
+	dev_info(dev, "%s: ok\n", __func__);
+
+	return 0;
+
+err_free_irq:
+	fpc1020_irq_teardown(fpc);
+
+	/* Do not leave the sensor powered if probe fails late. */
+	mutex_lock(&fpc->lock);
+	if (fpc->prepared) {
+		(void)fpc1020_select_pin_ctl(fpc, "fpc1020_reset_reset");
+		fpc->prepared = false;
+	}
+	(void)fpc1020_vdd_io_set(fpc, false);
+	mutex_unlock(&fpc->lock);
+
+err_unregister_input:
+	if (fpc->wakeup_capable)
+		device_init_wakeup(dev, false);
+	input_unregister_device(fpc->input);
+	return rc;
+
+err_free_input:
+	input_free_device(fpc->input);
+	return rc;
+}
+
+static void fpc1020_remove(struct platform_device *pdev)
+{
+	struct fpc1020_data *fpc = platform_get_drvdata(pdev);
+
+	fpc1020_irq_teardown(fpc);
+
+	mutex_lock(&fpc->lock);
+	if (fpc->prepared) {
+		(void)fpc1020_select_pin_ctl(fpc, "fpc1020_reset_reset");
+		fpc->prepared = false;
+	}
+	(void)fpc1020_vdd_io_set(fpc, false);
+	mutex_unlock(&fpc->lock);
+
+	if (fpc->wakeup_capable)
+		device_init_wakeup(fpc->dev, false);
+
+	input_unregister_device(fpc->input);
+}
+
+static const struct of_device_id fpc1020_of_match[] = {
+	{ .compatible = "fpc,fpc1020" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, fpc1020_of_match);
+
+static struct platform_driver fpc1020_driver = {
+	.probe = fpc1020_probe,
+	.remove = fpc1020_remove,
+	.driver = {
+		.name = "fpc1020",
+		.of_match_table = fpc1020_of_match,
+	},
+};
+module_platform_driver(fpc1020_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("Aleksej Makarov");
+MODULE_AUTHOR("Henrik Tillman <henrik.tillman@fingerprints.com>");
+MODULE_DESCRIPTION("FPC1020/FPC1022 fingerprint sensor platform driver");
