+# SPDX-License-Identifier: GPL-2.0-only
+#
+# FPC fingerprint sensor platform drivers
+#
+
+config INPUT_FPC1020
+	tristate "FPC1020/FPC1022 fingerprint sensor platform support"
+	depends on OF
+	depends on GPIOLIB
+	depends on PINCTRL
+	help
