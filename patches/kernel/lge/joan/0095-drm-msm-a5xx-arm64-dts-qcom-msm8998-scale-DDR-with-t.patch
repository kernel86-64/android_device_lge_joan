From 3816f6657a522aeb19cf1a05c10cb4770969f878 Mon Sep 17 00:00:00 2001
From: Lance <Gero3977@gmail.com>
Date: Tue, 3 Nov 2026 07:34:21 +0000
Subject: [PATCH 15/22] drm/msm/a5xx, arm64: dts: qcom: msm8998: scale DDR with
 the GPU clock

The A540 held one fixed gfx-mem vote of fast_rate * 8 (5.68 GB/s, about
768 MHz DDR) from probe on, whatever the GPU was doing. At full clock
that is less than half of what the vendor kernel gives it, and with the
GPU idle it still kept DDR at 768 MHz.

Vote per OPP instead, from the vendor kernel's grp3d bus table
(msm8998-v2.dtsi qcom,gpu-pwrlevels qcom,bus-freq): 257 MHz -> 412 MHz
DDR, 342 -> 768, 414 -> 1017, 515 and 596 -> 1555. The vendor's 1804 MHz
step for 670 and 710 MHz is held at 1555 MHz: on this stack DDR can be
raised to 1804 MHz and held there, but stepping down out of it after
sustained traffic hung the SoC (icc test client, 2026-11-02, and the
2026-10-06 run), so it cannot take part in normal scaling yet. The
gfx-l3 path keeps no vote. The driver's own fixed vote goes, since it
would floor DDR at 768 MHz under the OPP votes.

The vote is not released over GPU suspend: msm_gpu_pm_suspend() parks the
clock on the lowest OPP, so an idle GPU keeps 412 MHz DDR and that OPP's
VDDMX level. Releasing it there (dev_pm_opp_set_opp(dev, NULL), as the
vendor drops its bus vote over power collapse) made the ADSP come up
without SLIMbus in 2 of 7 boots, against 0 of 7 without the release on
the same series; releasing the DDR vote alone, keeping MX, is left for
later.

Measured on joan: the vote follows devfreq; DDR steps 412..1555 MHz and
60 random up/down transitions between them under memory load were clean.

Prior art: the per-level bus votes are LG/Qualcomm's (LineageOS
android_kernel_lge_msm8998, msm8998-v2.dtsi); the power-collapse release
that was tried and dropped follows scada's "drm/msm/a5xx: drop the
gfx-mem bus vote across power collapse"
(codeberg.org/scada/android_device_lge_joan, patch 0040).

Signed-off-by: Lance <Gero3977@gmail.com>
Assisted-by: Claude-Code:claude-opus-5-5
---
 arch/arm64/boot/dts/qcom/msm8998.dtsi | 22 +++++++++++
 drivers/gpu/drm/msm/adreno/a5xx_gpu.c | 54 +++------------------------
 drivers/gpu/drm/msm/adreno/a5xx_gpu.h |  8 ----
 3 files changed, 28 insertions(+), 56 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/msm8998.dtsi b/arch/arm64/boot/dts/qcom/msm8998.dtsi
index da8c0aa0a..d0faea0dd 100644
--- a/arch/arm64/boot/dts/qcom/msm8998.dtsi
+++ b/arch/arm64/boot/dts/qcom/msm8998.dtsi
@@ -2856,46 +2856,68 @@ adreno_gpu: gpu@5000000 {
 			 * qcom,gfxfreq-mx-speedbin0): SVS up to 414 MHz, NOM
 			 * for 515 and 596 MHz, TURBO for 670 and 710 MHz.
 			 */
+			/*
+			 * DDR bandwidth follows the GPU clock, from the vendor
+			 * kernel's grp3d bus table (msm8998-v2 gpu-pwrlevels,
+			 * qcom,bus-freq). The vendor's 1804 MHz step for 670 and
+			 * 710 MHz is held at 1555 MHz: 1804 MHz is not stable
+			 * here yet. The vote is released while the GPU is
+			 * suspended (a5xx_pm_suspend()).
+			 */
 			gpu_opp_table: opp-table {
 				compatible = "operating-points-v2";
 				opp-710000097 {
 					opp-hz = /bits/ 64 <710000097>;
+					/* gfx-mem: DDR 1804 MHz on stock, capped at 1555; gfx-l3: none */
+					opp-peak-kBps = <12440000 0>;
 					required-opps = <&rpmpd_opp_turbo>;
 					opp-supported-hw = <0xff>;
 				};
 
 				opp-670000048 {
 					opp-hz = /bits/ 64 <670000048>;
+					/* gfx-mem: DDR 1804 MHz on stock, capped at 1555; gfx-l3: none */
+					opp-peak-kBps = <12440000 0>;
 					required-opps = <&rpmpd_opp_turbo>;
 					opp-supported-hw = <0xff>;
 				};
 
 				opp-596000097 {
 					opp-hz = /bits/ 64 <596000097>;
+					/* gfx-mem: DDR 1555 MHz; gfx-l3: none */
+					opp-peak-kBps = <12440000 0>;
 					required-opps = <&rpmpd_opp_nom>;
 					opp-supported-hw = <0xff>;
 				};
 
 				opp-515000097 {
 					opp-hz = /bits/ 64 <515000097>;
+					/* gfx-mem: DDR 1555 MHz; gfx-l3: none */
+					opp-peak-kBps = <12440000 0>;
 					required-opps = <&rpmpd_opp_nom>;
 					opp-supported-hw = <0xff>;
 				};
 
 				opp-414000000 {
 					opp-hz = /bits/ 64 <414000000>;
+					/* gfx-mem: DDR 1017 MHz; gfx-l3: none */
+					opp-peak-kBps = <8136000 0>;
 					required-opps = <&rpmpd_opp_svs>;
 					opp-supported-hw = <0xff>;
 				};
 
 				opp-342000000 {
 					opp-hz = /bits/ 64 <342000000>;
+					/* gfx-mem: DDR 768 MHz; gfx-l3: none */
+					opp-peak-kBps = <6144000 0>;
 					required-opps = <&rpmpd_opp_svs>;
 					opp-supported-hw = <0xff>;
 				};
 
 				opp-257000000 {
 					opp-hz = /bits/ 64 <257000000>;
+					/* gfx-mem: DDR 412 MHz; gfx-l3: none */
+					opp-peak-kBps = <3296000 0>;
 					required-opps = <&rpmpd_opp_svs>;
 					opp-supported-hw = <0xff>;
 				};
diff --git a/drivers/gpu/drm/msm/adreno/a5xx_gpu.c b/drivers/gpu/drm/msm/adreno/a5xx_gpu.c
index df6e93be9..48898caf5 100644
--- a/drivers/gpu/drm/msm/adreno/a5xx_gpu.c
+++ b/drivers/gpu/drm/msm/adreno/a5xx_gpu.c
@@ -1424,17 +1424,10 @@ static int a5xx_pm_resume(struct msm_gpu *gpu)
 	struct a5xx_gpu *a5xx_gpu = to_a5xx_gpu(adreno_gpu);
 	int ret;
 
-	/* Restore the bus vote before the GPU can issue any memory traffic */
-	if (a5xx_gpu->gfx_mem_path)
-		icc_set_bw(a5xx_gpu->gfx_mem_path, 0, a5xx_gpu->gfx_mem_peak_bw);
-
 	/* Turn on the core power */
 	ret = msm_gpu_pm_resume(gpu);
-	if (ret) {
-		if (a5xx_gpu->gfx_mem_path)
-			icc_set_bw(a5xx_gpu->gfx_mem_path, 0, 0);
+	if (ret)
 		return ret;
-	}
 
 	/* Adreno 505, 506, 508, 509, 510, 512 needs manual RBBM sus/res control */
 	if (!(adreno_is_a530(adreno_gpu) || adreno_is_a540(adreno_gpu))) {
@@ -1539,22 +1532,9 @@ static int a5xx_pm_suspend(struct msm_gpu *gpu)
 		gpu_write(gpu, REG_A5XX_RBBM_BLOCK_SW_RESET_CMD, 0x00000000);
 	}
 
-	/*
-	 * Drop the gfx-mem vote before the power domain collapses. The VBIF
-	 * XIN ports are halted above, so nothing is in flight to the bus by
-	 * this point, and downstream KGSL likewise re-votes the bus on every
-	 * power transition rather than holding a peak vote across collapse.
-	 */
-	if (a5xx_gpu->gfx_mem_path)
-		icc_set_bw(a5xx_gpu->gfx_mem_path, 0, 0);
-
 	ret = msm_gpu_pm_suspend(gpu);
-	if (ret) {
-		if (a5xx_gpu->gfx_mem_path)
-			icc_set_bw(a5xx_gpu->gfx_mem_path, 0,
-				   a5xx_gpu->gfx_mem_peak_bw);
+	if (ret)
 		return ret;
-	}
 
 	if (a5xx_gpu->has_whereami)
 		for (i = 0; i < gpu->nr_rings; i++)
@@ -1919,33 +1899,11 @@ struct msm_gpu *a5xx_gpu_init(struct drm_device *dev)
 	}
 
 	/*
-	 * Vote for memory bandwidth on the GPU's interconnect path. The
-	 * path is optional: boards without an interconnect provider (or
-	 * without the DT property) get -ENODATA and simply run without
-	 * bus scaling. -EPROBE_DEFER propagates so the GPU comes up once
-	 * the interconnect driver is ready.
+	 * Memory bandwidth is voted by the OPP table: each GPU OPP carries an
+	 * opp-peak-kBps for the "gfx-mem" path, so dev_pm_opp_set_rate()
+	 * moves the DDR vote with the GPU clock, as downstream KGSL does
+	 * per power level.
 	 */
-	{
-		struct icc_path *icc_path = devm_of_icc_get(&pdev->dev, "gfx-mem");
-
-		if (IS_ERR(icc_path)) {
-			ret = PTR_ERR(icc_path);
-			if (ret == -ENODATA)
-				icc_path = NULL;
-			else if (ret != -EPROBE_DEFER)
-				dev_err(&pdev->dev, "failed to get gfx-mem interconnect: %d\n", ret);
-		}
-
-		if (!IS_ERR_OR_NULL(icc_path)) {
-			/* Max bandwidth for now; scale with devfreq later. */
-			a5xx_gpu->gfx_mem_path = icc_path;
-			a5xx_gpu->gfx_mem_peak_bw = Bps_to_icc(gpu->fast_rate) * 8;
-			icc_set_bw(icc_path, 0, a5xx_gpu->gfx_mem_peak_bw);
-			dev_info(&pdev->dev, "gfx-mem interconnect: %u Bps\n",
-				 a5xx_gpu->gfx_mem_peak_bw);
-		}
-	}
-
 
 	msm_mmu_set_fault_handler(to_msm_vm(gpu->vm)->mmu, gpu,
 				  a5xx_fault_handler);
diff --git a/drivers/gpu/drm/msm/adreno/a5xx_gpu.h b/drivers/gpu/drm/msm/adreno/a5xx_gpu.h
index d2669e676..f8124980d 100644
--- a/drivers/gpu/drm/msm/adreno/a5xx_gpu.h
+++ b/drivers/gpu/drm/msm/adreno/a5xx_gpu.h
@@ -29,14 +29,6 @@ struct a5xx_gpu {
 
 	uint32_t lm_leakage;
 
-	/*
-	 * gfx-mem bus vote. Held while the GPU is resumed and dropped over
-	 * power collapse, the way downstream KGSL scales it on every power
-	 * transition. NULL on boards with no interconnect provider.
-	 */
-	struct icc_path *gfx_mem_path;
-	u32 gfx_mem_peak_bw;
-
 	struct msm_ringbuffer *cur_ring;
 	struct msm_ringbuffer *next_ring;
 
-- 
