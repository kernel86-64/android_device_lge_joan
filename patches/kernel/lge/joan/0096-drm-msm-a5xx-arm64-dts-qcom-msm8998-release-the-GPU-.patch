From 925c694c6bc1a30341afe573d22857a0e8d0f40c Mon Sep 17 00:00:00 2001
From: Lance <Gero3977@gmail.com>
Date: Tue, 3 Nov 2026 04:07:36 -0800
Subject: [PATCH 16/22] drm/msm/a5xx, arm64: dts: qcom: msm8998: release the
 GPU's DDR vote in slumber

Add it as an OPP with no bandwidth, keeping the SVS rail level of the
257 MHz OPP: releasing VDDMX along with the DDR vote (disabling the OPP
table at suspend) made the ADSP come up without SLIMbus in 2 of 7 boots,
so only the DDR vote goes. Since the slumber level is for a suspended
GPU only, the a5xx driver adds a minimum-frequency QoS request at the
next OPP, which devfreq honours; msm_gpu_pm_suspend() sets the rate
directly and still reaches 27 MHz.

The slumber OPP needs a VDD_GFX voltage like every GPU OPP: the joan
board gives it the lowest corner ceiling as a fallback, and
a540_gfx_apply_open_loop() replaces that with the fused lowest-corner
voltage, so parking there never asks for more than 257 MHz does.
Without one, every slumber logged "failed to set voltage (0 0 0 mV)".

Also correct the OPP table comment, which said the vote was released at
suspend before this change did it.

Signed-off-by: Lance <Gero3977@gmail.com>
Assisted-by: Claude-Code:claude-opus-5-5
---
 arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts |  5 ++++
 arch/arm64/boot/dts/qcom/msm8998.dtsi        | 19 +++++++++++--
 drivers/gpu/drm/msm/adreno/a540_gfx_rail.c   | 19 +++++++++++++
 drivers/gpu/drm/msm/adreno/a5xx_gpu.c        | 30 ++++++++++++++++++++
 drivers/gpu/drm/msm/adreno/a5xx_gpu.h        |  5 ++++
 5 files changed, 76 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts b/arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts
index ee73c4872..a4bd02953 100644
--- a/arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts
+++ b/arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts
@@ -1710,6 +1710,11 @@ opp-342000000 {
 	opp-257000000 {
 		opp-microvolt = <724000>;
 	};
+
+	/* Slumber (GPU suspended): replaced with the lowest fused corner */
+	opp-27000000 {
+		opp-microvolt = <724000>;
+	};
 };
 
 
diff --git a/arch/arm64/boot/dts/qcom/msm8998.dtsi b/arch/arm64/boot/dts/qcom/msm8998.dtsi
index d0faea0dd..3a148c9d1 100644
--- a/arch/arm64/boot/dts/qcom/msm8998.dtsi
+++ b/arch/arm64/boot/dts/qcom/msm8998.dtsi
@@ -2861,8 +2861,8 @@ adreno_gpu: gpu@5000000 {
 			 * kernel's grp3d bus table (msm8998-v2 gpu-pwrlevels,
 			 * qcom,bus-freq). The vendor's 1804 MHz step for 670 and
 			 * 710 MHz is held at 1555 MHz: 1804 MHz is not stable
-			 * here yet. The vote is released while the GPU is
-			 * suspended (a5xx_pm_suspend()).
+			 * here yet. A suspended GPU parks on the 27 MHz slumber
+			 * OPP, which votes no DDR bandwidth.
 			 */
 			gpu_opp_table: opp-table {
 				compatible = "operating-points-v2";
@@ -2921,6 +2921,21 @@ opp-257000000 {
 					required-opps = <&rpmpd_opp_svs>;
 					opp-supported-hw = <0xff>;
 				};
+
+				/*
+				 * The vendor's 27 MHz slumber level (bus-freq 0),
+				 * only for a suspended GPU: msm_gpu_pm_suspend()
+				 * parks the clock here. It drops the DDR vote but
+				 * keeps the SVS rail level; releasing VDDMX with it
+				 * left the ADSP without SLIMbus on some boots. The
+				 * a5xx driver keeps devfreq above it.
+				 */
+				opp-27000000 {
+					opp-hz = /bits/ 64 <27000000>;
+					opp-peak-kBps = <0 0>;
+					required-opps = <&rpmpd_opp_svs>;
+					opp-supported-hw = <0xff>;
+				};
 			};
 		};
 
diff --git a/drivers/gpu/drm/msm/adreno/a540_gfx_rail.c b/drivers/gpu/drm/msm/adreno/a540_gfx_rail.c
index 9aace1bf4..46bb023bd 100644
--- a/drivers/gpu/drm/msm/adreno/a540_gfx_rail.c
+++ b/drivers/gpu/drm/msm/adreno/a540_gfx_rail.c
@@ -275,6 +275,25 @@ void a540_gfx_apply_open_loop(struct device *dev)
 			dev_warn(dev, "cannot set %lu Hz to %d uV: %d\n",
 				 hz, ol[i], ret);
 	}
+
+	/*
+	 * The 27 MHz slumber OPP is only reached with the GPU suspended.
+	 * Give it the lowest corner voltage so parking there never asks
+	 * for more than the 257 MHz OPP does.
+	 */
+	{
+		struct dev_pm_opp *opp;
+
+		opp = dev_pm_opp_find_freq_exact(dev, 27000000, true);
+		if (!IS_ERR(opp)) {
+			dev_pm_opp_put(opp);
+			ret = dev_pm_opp_adjust_voltage(dev, 27000000,
+							ol[0], ol[0], ol[0]);
+			if (ret)
+				dev_warn(dev, "cannot set the slumber OPP to %d uV: %d\n",
+					 ol[0], ret);
+		}
+	}
 }
 
 static struct regmap *a540_mem_acc_map;
diff --git a/drivers/gpu/drm/msm/adreno/a5xx_gpu.c b/drivers/gpu/drm/msm/adreno/a5xx_gpu.c
index 48898caf5..ed26f2680 100644
--- a/drivers/gpu/drm/msm/adreno/a5xx_gpu.c
+++ b/drivers/gpu/drm/msm/adreno/a5xx_gpu.c
@@ -1107,6 +1107,9 @@ static void a5xx_destroy(struct msm_gpu *gpu)
 
 	DBG("%s", gpu->name);
 
+	if (dev_pm_qos_request_active(&a5xx_gpu->slumber_qos))
+		dev_pm_qos_remove_request(&a5xx_gpu->slumber_qos);
+
 	a5xx_preempt_fini(gpu);
 
 	if (a5xx_gpu->pm4_bo) {
@@ -1903,7 +1906,34 @@ struct msm_gpu *a5xx_gpu_init(struct drm_device *dev)
 	 * opp-peak-kBps for the "gfx-mem" path, so dev_pm_opp_set_rate()
 	 * moves the DDR vote with the GPU clock, as downstream KGSL does
 	 * per power level.
+	 *
+	 * A 27 MHz OPP, if present, is the vendor's slumber level: no DDR
+	 * vote, used only while suspended, where msm_gpu_pm_suspend() parks
+	 * the clock at 27 MHz. Keep devfreq at or above the next OPP so the
+	 * running GPU is never left without bandwidth.
 	 */
+	{
+		unsigned long freq = 27000000;
+		struct dev_pm_opp *opp;
+
+		opp = dev_pm_opp_find_freq_exact(&pdev->dev, freq, true);
+		if (!IS_ERR(opp)) {
+			dev_pm_opp_put(opp);
+			freq++;
+			opp = dev_pm_opp_find_freq_ceil(&pdev->dev, &freq);
+			if (!IS_ERR(opp)) {
+				dev_pm_opp_put(opp);
+				ret = dev_pm_qos_add_request(&pdev->dev,
+							     &a5xx_gpu->slumber_qos,
+							     DEV_PM_QOS_MIN_FREQUENCY,
+							     freq / 1000);
+				if (ret < 0)
+					dev_warn(&pdev->dev,
+						 "no devfreq floor above the slumber OPP: %d\n",
+						 ret);
+			}
+		}
+	}
 
 	msm_mmu_set_fault_handler(to_msm_vm(gpu->vm)->mmu, gpu,
 				  a5xx_fault_handler);
diff --git a/drivers/gpu/drm/msm/adreno/a5xx_gpu.h b/drivers/gpu/drm/msm/adreno/a5xx_gpu.h
index f8124980d..dbaace550 100644
--- a/drivers/gpu/drm/msm/adreno/a5xx_gpu.h
+++ b/drivers/gpu/drm/msm/adreno/a5xx_gpu.h
@@ -6,6 +6,8 @@
 
 #include <linux/interconnect.h>
 
+#include <linux/pm_qos.h>
+
 #include "adreno_gpu.h"
 
 /* Bringing over the hack from the previous targets */
@@ -29,6 +31,9 @@ struct a5xx_gpu {
 
 	uint32_t lm_leakage;
 
+	/* Keeps devfreq off the suspend-only 27 MHz slumber OPP */
+	struct dev_pm_qos_request slumber_qos;
+
 	struct msm_ringbuffer *cur_ring;
 	struct msm_ringbuffer *next_ring;
 
-- 
