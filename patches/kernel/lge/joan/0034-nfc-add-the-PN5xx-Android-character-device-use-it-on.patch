diff --git a/drivers/nfc/pn5xx_i2c.c b/drivers/nfc/pn5xx_i2c.c
new file mode 100644
index 000000000000..b292071012a8
--- /dev/null
+++ b/drivers/nfc/pn5xx_i2c.c
@@ -0,0 +1,246 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * NXP PN54x/PN55x NFC controller, Android character device interface.
+ *
+ * Android's NXP NFC HAL (hardware/nxp/nfc) does not use the kernel NFC
+ * subsystem: it talks NCI itself through a character device, /dev/pn54x,
+ * and drives the VEN and firmware-download lines with PN544_SET_PWR. This
+ * is that interface, modelled on NXP's pn5xx_i2c driver.
+ */
+
+#include <linux/delay.h>
+#include <linux/fs.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/interrupt.h>
+#include <linux/miscdevice.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <linux/wait.h>
+
+#define PN544_MAGIC		0xe9
+#define PN544_SET_PWR		_IOW(PN544_MAGIC, 0x01, unsigned int)
+#define P61_SET_SPI_PWR		_IOW(PN544_MAGIC, 0x02, unsigned int)
+#define P61_GET_PWR_STATUS	_IOR(PN544_MAGIC, 0x03, unsigned int)
+#define P61_SET_WIRED_ACCESS	_IOW(PN544_MAGIC, 0x04, unsigned int)
+#define PN544_SET_DWNLD_STATUS	_IOW(PN544_MAGIC, 0x09, unsigned int)
+
+#define PN5XX_MAX_BUF		512
+
+struct pn5xx_dev {
+	struct i2c_client *client;
+	struct miscdevice misc;
+	struct gpio_desc *ven;
+	struct gpio_desc *fw;
+	struct mutex read_lock;
+	wait_queue_head_t read_wq;
+	bool irq_pending;
+	spinlock_t irq_lock;
+	u8 buf[PN5XX_MAX_BUF];
+};
+
+static irqreturn_t pn5xx_irq(int irq, void *data)
+{
+	struct pn5xx_dev *pn = data;
+	unsigned long flags;
+
+	spin_lock_irqsave(&pn->irq_lock, flags);
+	pn->irq_pending = true;
+	spin_unlock_irqrestore(&pn->irq_lock, flags);
+	wake_up(&pn->read_wq);
+	return IRQ_HANDLED;
+}
+
+static bool pn5xx_data_ready(struct pn5xx_dev *pn)
+{
+	unsigned long flags;
+	bool ready;
+
+	spin_lock_irqsave(&pn->irq_lock, flags);
+	ready = pn->irq_pending;
+	spin_unlock_irqrestore(&pn->irq_lock, flags);
+	return ready;
+}
+
+static ssize_t pn5xx_read(struct file *filp, char __user *ubuf, size_t count, loff_t *off)
+{
+	struct pn5xx_dev *pn = container_of(filp->private_data, struct pn5xx_dev, misc);
+	unsigned long flags;
+	int ret;
+
+	count = min_t(size_t, count, PN5XX_MAX_BUF);
+
+	mutex_lock(&pn->read_lock);
+	if (!pn5xx_data_ready(pn)) {
+		if (filp->f_flags & O_NONBLOCK) {
+			ret = -EAGAIN;
+			goto out;
+		}
+		ret = wait_event_interruptible(pn->read_wq, pn5xx_data_ready(pn));
+		if (ret)
+			goto out;
+	}
+	spin_lock_irqsave(&pn->irq_lock, flags);
+	pn->irq_pending = false;
+	spin_unlock_irqrestore(&pn->irq_lock, flags);
+
+	ret = i2c_master_recv(pn->client, pn->buf, count);
+	if (ret < 0)
+		goto out;
+	if (copy_to_user(ubuf, pn->buf, ret))
+		ret = -EFAULT;
+out:
+	mutex_unlock(&pn->read_lock);
+	return ret;
+}
+
+static ssize_t pn5xx_write(struct file *filp, const char __user *ubuf, size_t count,
+			   loff_t *off)
+{
+	struct pn5xx_dev *pn = container_of(filp->private_data, struct pn5xx_dev, misc);
+	u8 tmp[PN5XX_MAX_BUF];
+	int ret;
+
+	count = min_t(size_t, count, PN5XX_MAX_BUF);
+	if (copy_from_user(tmp, ubuf, count))
+		return -EFAULT;
+	ret = i2c_master_send(pn->client, tmp, count);
+	if (ret < 0) {
+		/* the controller NAKs while waking from standby; retry once */
+		usleep_range(6000, 10000);
+		ret = i2c_master_send(pn->client, tmp, count);
+	}
+	return ret;
+}
+
+static void pn5xx_set_power(struct pn5xx_dev *pn, unsigned int mode)
+{
+	switch (mode) {
+	case 0:		/* off */
+		gpiod_set_value_cansleep(pn->fw, 0);
+		gpiod_set_value_cansleep(pn->ven, 0);
+		msleep(60);
+		break;
+	case 1:		/* on, normal mode */
+		gpiod_set_value_cansleep(pn->fw, 0);
+		gpiod_set_value_cansleep(pn->ven, 1);
+		msleep(20);
+		break;
+	case 2:		/* on, firmware download mode */
+		gpiod_set_value_cansleep(pn->ven, 1);
+		msleep(20);
+		gpiod_set_value_cansleep(pn->fw, 1);
+		msleep(20);
+		gpiod_set_value_cansleep(pn->ven, 0);
+		msleep(60);
+		gpiod_set_value_cansleep(pn->ven, 1);
+		msleep(20);
+		break;
+	case 3:		/* reset: power cycle */
+		gpiod_set_value_cansleep(pn->ven, 0);
+		msleep(10);
+		gpiod_set_value_cansleep(pn->ven, 1);
+		msleep(10);
+		break;
+	}
+}
+
+static long pn5xx_ioctl(struct file *filp, unsigned int cmd, unsigned long arg)
+{
+	struct pn5xx_dev *pn = container_of(filp->private_data, struct pn5xx_dev, misc);
+
+	switch (cmd) {
+	case PN544_SET_PWR:
+		if (arg > 3)
+			return -EINVAL;
+		pn5xx_set_power(pn, arg);
+		return 0;
+	case P61_GET_PWR_STATUS:
+		/* no embedded secure element on this board */
+		return put_user(0, (unsigned int __user *)arg);
+	case P61_SET_SPI_PWR:
+	case P61_SET_WIRED_ACCESS:
+	case PN544_SET_DWNLD_STATUS:
+		return 0;
+	default:
+		return -ENOTTY;
+	}
+}
+
+static const struct file_operations pn5xx_fops = {
+	.owner = THIS_MODULE,
+	.read = pn5xx_read,
+	.write = pn5xx_write,
+	.unlocked_ioctl = pn5xx_ioctl,
+	.compat_ioctl = compat_ptr_ioctl,
+};
+
+static int pn5xx_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct pn5xx_dev *pn;
+	int ret;
+
+	pn = devm_kzalloc(dev, sizeof(*pn), GFP_KERNEL);
+	if (!pn)
+		return -ENOMEM;
+
+	pn->client = client;
+	mutex_init(&pn->read_lock);
+	spin_lock_init(&pn->irq_lock);
+	init_waitqueue_head(&pn->read_wq);
+
+	pn->ven = devm_gpiod_get(dev, "enable", GPIOD_OUT_LOW);
+	if (IS_ERR(pn->ven))
+		return dev_err_probe(dev, PTR_ERR(pn->ven), "no enable gpio\n");
+	pn->fw = devm_gpiod_get(dev, "firmware", GPIOD_OUT_LOW);
+	if (IS_ERR(pn->fw))
+		return dev_err_probe(dev, PTR_ERR(pn->fw), "no firmware gpio\n");
+
+	ret = devm_request_threaded_irq(dev, client->irq, NULL, pn5xx_irq,
+					IRQF_ONESHOT, "pn5xx", pn);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot request irq\n");
+
+	pn->misc.minor = MISC_DYNAMIC_MINOR;
+	pn->misc.name = "pn54x";
+	pn->misc.fops = &pn5xx_fops;
+	ret = misc_register(&pn->misc);
+	if (ret)
+		return ret;
+
+	i2c_set_clientdata(client, pn);
+	dev_info(dev, "registered /dev/%s\n", pn->misc.name);
+	return 0;
+}
+
+static void pn5xx_remove(struct i2c_client *client)
+{
+	struct pn5xx_dev *pn = i2c_get_clientdata(client);
+
+	misc_deregister(&pn->misc);
+	gpiod_set_value_cansleep(pn->ven, 0);
+}
+
+static const struct of_device_id pn5xx_of_match[] = {
+	{ .compatible = "nxp,pn547" },
+	{ .compatible = "nxp,pn553" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, pn5xx_of_match);
+
+static struct i2c_driver pn5xx_driver = {
+	.driver = {
+		.name = "pn5xx_i2c",
+		.of_match_table = pn5xx_of_match,
+	},
+	.probe = pn5xx_probe,
+	.remove = pn5xx_remove,
+};
+module_i2c_driver(pn5xx_driver);
+
+MODULE_DESCRIPTION("NXP PN5xx NFC Android character device");
+MODULE_LICENSE("GPL");
