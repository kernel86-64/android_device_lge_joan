From 6ad16909985b7485275413e8a55e075d604ad1cf Mon Sep 17 00:00:00 2001
From: scada <scada@noreply.codeberg.org>
Date: Thu, 29 Oct 2026 08:08:51 +0400
Subject: [PATCH 66/80] soc: qcom: icc-bwmon: share the BWMON regions with the
 BIMC driver

On MSM8998 the CPU BWMON's monitor (0x01008000) and global (0x01001000)
registers both lie inside the BIMC register window that qnoc-msm8998
claims, so devm_platform_ioremap_resource() failed with -EBUSY and the
monitor never probed, leaving the interconnect providers stuck in
sync_state with every path at maximum bandwidth. The drivers use
disjoint registers; map a region that is already requested without
requesting it again.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0144VMKxYe33NKa3LLPZNivr
---
 drivers/soc/qcom/icc-bwmon.c | 24 ++++++++++++++++++++++--
 1 file changed, 22 insertions(+), 2 deletions(-)

diff --git a/drivers/soc/qcom/icc-bwmon.c b/drivers/soc/qcom/icc-bwmon.c
index 597f9025e422..62cf5d2c30e9 100644
--- a/drivers/soc/qcom/icc-bwmon.c
+++ b/drivers/soc/qcom/icc-bwmon.c
@@ -700,6 +700,26 @@ static irqreturn_t bwmon_intr_thread(int irq, void *dev_id)
 	return IRQ_HANDLED;
 }
 
+/*
+ * On MSM8998 both BWMON regions lie inside the BIMC register window that the
+ * interconnect driver has already claimed. The drivers use disjoint
+ * registers, so map a busy region without requesting it again.
+ */
+static void __iomem *bwmon_ioremap(struct platform_device *pdev, unsigned int index)
+{
+	void __iomem *base = devm_platform_ioremap_resource(pdev, index);
+	struct resource *res;
+
+	if (PTR_ERR_OR_ZERO(base) != -EBUSY)
+		return base;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, index);
+	if (!res)
+		return IOMEM_ERR_PTR(-EINVAL);
+	base = devm_ioremap(&pdev->dev, res->start, resource_size(res));
+	return base ?: IOMEM_ERR_PTR(-ENOMEM);
+}
+
 static int bwmon_init_regmap(struct platform_device *pdev,
 			     struct icc_bwmon *bwmon)
 {
@@ -709,7 +729,7 @@ static int bwmon_init_regmap(struct platform_device *pdev,
 	int ret;
 
 	/* Map the monitor base */
-	base = devm_platform_ioremap_resource(pdev, 0);
+	base = bwmon_ioremap(pdev, 0);
 	if (IS_ERR(base))
 		return dev_err_probe(dev, PTR_ERR(base),
 				     "failed to map bwmon registers\n");
@@ -732,7 +752,7 @@ static int bwmon_init_regmap(struct platform_device *pdev,
 
 	if (bwmon->data->global_regmap_cfg) {
 		/* Map the global base, if separate */
-		base = devm_platform_ioremap_resource(pdev, 1);
+		base = bwmon_ioremap(pdev, 1);
 		if (IS_ERR(base))
 			return dev_err_probe(dev, PTR_ERR(base),
 					     "failed to map bwmon global registers\n");
