From e072290939658a0987d82a9f95417501b5b15af3 Mon Sep 17 00:00:00 2001
From: Lance <Gero3977@gmail.com>
Date: Sun, 25 Oct 2026 10:53:15 -0700
Subject: [PATCH 61/78] iio: qcom-smgr: support one-shot sysfs reads

iio-sensor-proxy polls in_*_raw sysfs attributes, which the SMGR driver
did not expose: channels had no IIO_CHAN_INFO_RAW and read_raw only
answered scale/sampling-frequency, so orientation stayed undefined on
the LG V30 (joan) even with the sensors enumerating.

Cache the latest buffering-report sample per sensor and complete a
completion on every report. read_raw(RAW) returns the cache while
buffering is active; in direct mode it enables buffering, waits for one
report (250 ms), disables it again and returns that sample. accel, gyro,
mag, proximity and pressure channels now carry the RAW info mask; light
still needs a channel of its own.

Signed-off-by: Lance <Gero3977@gmail.com>
Assisted-by: ZCode:GLM-5.3
(cherry picked from commit 187d1b250259642fcf99c5e45e2cab608fd12b95)
---
 drivers/iio/common/qcom_smgr/qcom_smgr.c | 46 ++++++++++++++++++++++--
 include/linux/iio/common/qcom_smgr.h     |  5 +++
 2 files changed, 49 insertions(+), 2 deletions(-)

diff --git a/drivers/iio/common/qcom_smgr/qcom_smgr.c b/drivers/iio/common/qcom_smgr/qcom_smgr.c
index f8ee48d075bc..1cc4533af27f 100644
--- a/drivers/iio/common/qcom_smgr/qcom_smgr.c
+++ b/drivers/iio/common/qcom_smgr/qcom_smgr.c
@@ -5,6 +5,7 @@
  * Copyright (c) 2021-2025, Yassine Oudjana <y.oudjana@protonmail.com>
  */
 
+#include <linux/completion.h>
 #include <linux/iio/buffer.h>
 #include <linux/iio/common/qcom_smgr.h>
 #include <linux/iio/iio.h>
@@ -313,6 +314,12 @@ static void qcom_smgr_buffering_report_handler(struct qmi_handle *hdl,
 		iio_data.values[0] = cpu_to_le32(temp);
 	}
 
+	/* Cache for one-shot sysfs reads */
+	for (j = 0; j < ARRAY_SIZE(sensor->last_sample_values); ++j)
+		sensor->last_sample_values[j] = iio_data.values[j];
+
+	complete(&sensor->sample_ready);
+
 	iio_push_to_buffers(sensor->iio_dev, &iio_data);
 }
 
@@ -377,8 +384,30 @@ static int qcom_smgr_iio_read_raw(struct iio_dev *iio_dev,
 				  int *val2, long mask)
 {
 	struct qcom_smgr_iio_priv *priv = iio_priv(iio_dev);
+	struct qcom_smgr_sensor *sensor = priv->sensor;
 
 	switch (mask) {
+	case IIO_CHAN_INFO_RAW: {
+		struct qcom_smgr *smgr = dev_get_drvdata(iio_dev->dev.parent);
+		int ret;
+
+		if (!iio_buffer_enabled(iio_dev)) {
+			reinit_completion(&sensor->sample_ready);
+			ret = qcom_smgr_request_buffering(smgr, sensor, true);
+			if (ret)
+				return ret;
+			ret = wait_for_completion_timeout(&sensor->sample_ready,
+				msecs_to_jiffies(250));
+			qcom_smgr_request_buffering(smgr, sensor, false);
+			if (!ret)
+				return -ETIMEDOUT;
+		}
+
+		if (chan->scan_index >= ARRAY_SIZE(sensor->last_sample_values))
+			return -EINVAL;
+		*val = (s32)sensor->last_sample_values[chan->scan_index];
+		return IIO_VAL_INT;
+	}
 	case IIO_CHAN_INFO_SAMP_FREQ:
 		*val = priv->sensor->data_types[0].cur_sample_rate;
 		return IIO_VAL_INT;
@@ -447,6 +476,7 @@ static const struct iio_chan_spec qcom_smgr_accel_iio_channels[] = {
 			.storagebits = 32,
 			.endianness = IIO_LE,
 		},
+		.info_mask_separate = BIT(IIO_CHAN_INFO_RAW),
 		.info_mask_shared_by_type = BIT(IIO_CHAN_INFO_SCALE) |
 					    BIT(IIO_CHAN_INFO_SAMP_FREQ),
 		.ext_info = qcom_smgr_iio_ext_info
@@ -462,6 +492,7 @@ static const struct iio_chan_spec qcom_smgr_accel_iio_channels[] = {
 			.storagebits = 32,
 			.endianness = IIO_LE,
 		},
+		.info_mask_separate = BIT(IIO_CHAN_INFO_RAW),
 		.info_mask_shared_by_type = BIT(IIO_CHAN_INFO_SCALE) |
 					    BIT(IIO_CHAN_INFO_SAMP_FREQ),
 		.ext_info = qcom_smgr_iio_ext_info
@@ -477,6 +508,7 @@ static const struct iio_chan_spec qcom_smgr_accel_iio_channels[] = {
 			.storagebits = 32,
 			.endianness = IIO_LE,
 		},
+		.info_mask_separate = BIT(IIO_CHAN_INFO_RAW),
 		.info_mask_shared_by_type = BIT(IIO_CHAN_INFO_SCALE) |
 					    BIT(IIO_CHAN_INFO_SAMP_FREQ),
 		.ext_info = qcom_smgr_iio_ext_info
@@ -506,6 +538,7 @@ static const struct iio_chan_spec qcom_smgr_gyro_iio_channels[] = {
 			.storagebits = 32,
 			.endianness = IIO_LE,
 		},
+		.info_mask_separate = BIT(IIO_CHAN_INFO_RAW),
 		.info_mask_shared_by_type = BIT(IIO_CHAN_INFO_SCALE) |
 					    BIT(IIO_CHAN_INFO_SAMP_FREQ),
 		.ext_info = qcom_smgr_iio_ext_info
@@ -521,6 +554,7 @@ static const struct iio_chan_spec qcom_smgr_gyro_iio_channels[] = {
 			.storagebits = 32,
 			.endianness = IIO_LE,
 		},
+		.info_mask_separate = BIT(IIO_CHAN_INFO_RAW),
 		.info_mask_shared_by_type = BIT(IIO_CHAN_INFO_SCALE) |
 					    BIT(IIO_CHAN_INFO_SAMP_FREQ),
 		.ext_info = qcom_smgr_iio_ext_info
@@ -536,6 +570,7 @@ static const struct iio_chan_spec qcom_smgr_gyro_iio_channels[] = {
 			.storagebits = 32,
 			.endianness = IIO_LE,
 		},
+		.info_mask_separate = BIT(IIO_CHAN_INFO_RAW),
 		.info_mask_shared_by_type = BIT(IIO_CHAN_INFO_SCALE) |
 					    BIT(IIO_CHAN_INFO_SAMP_FREQ),
 		.ext_info = qcom_smgr_iio_ext_info
@@ -565,6 +600,7 @@ static const struct iio_chan_spec qcom_smgr_mag_iio_channels[] = {
 			.storagebits = 32,
 			.endianness = IIO_LE,
 		},
+		.info_mask_separate = BIT(IIO_CHAN_INFO_RAW),
 		.info_mask_shared_by_type = BIT(IIO_CHAN_INFO_SCALE) |
 					    BIT(IIO_CHAN_INFO_SAMP_FREQ),
 		.ext_info = qcom_smgr_iio_ext_info
@@ -580,6 +616,7 @@ static const struct iio_chan_spec qcom_smgr_mag_iio_channels[] = {
 			.storagebits = 32,
 			.endianness = IIO_LE,
 		},
+		.info_mask_separate = BIT(IIO_CHAN_INFO_RAW),
 		.info_mask_shared_by_type = BIT(IIO_CHAN_INFO_SCALE) |
 					    BIT(IIO_CHAN_INFO_SAMP_FREQ),
 		.ext_info = qcom_smgr_iio_ext_info
@@ -595,6 +632,7 @@ static const struct iio_chan_spec qcom_smgr_mag_iio_channels[] = {
 			.storagebits = 32,
 			.endianness = IIO_LE,
 		},
+		.info_mask_separate = BIT(IIO_CHAN_INFO_RAW),
 		.info_mask_shared_by_type = BIT(IIO_CHAN_INFO_SCALE) |
 					    BIT(IIO_CHAN_INFO_SAMP_FREQ),
 		.ext_info = qcom_smgr_iio_ext_info
@@ -622,7 +660,8 @@ static const struct iio_chan_spec qcom_smgr_prox_iio_channels[] = {
 			.storagebits = 32,
 			.endianness = IIO_LE,
 		},
-		.info_mask_separate = BIT(IIO_CHAN_INFO_SCALE) |
+		.info_mask_separate = BIT(IIO_CHAN_INFO_RAW) |
+			      BIT(IIO_CHAN_INFO_SCALE) |
 				      BIT(IIO_CHAN_INFO_SAMP_FREQ)
 	},
 	{
@@ -648,7 +687,8 @@ static const struct iio_chan_spec qcom_smgr_pressure_iio_channels[] = {
 			.storagebits = 32,
 			.endianness = IIO_LE,
 		},
-		.info_mask_separate = BIT(IIO_CHAN_INFO_SCALE) |
+		.info_mask_separate = BIT(IIO_CHAN_INFO_RAW) |
+			      BIT(IIO_CHAN_INFO_SCALE) |
 				      BIT(IIO_CHAN_INFO_SAMP_FREQ)
 	},
 	{
@@ -704,6 +744,8 @@ static int qcom_smgr_register_sensor(struct qcom_smgr *smgr,
 	priv = iio_priv(iio_dev);
 	priv->sensor = sensor;
 
+	init_completion(&sensor->sample_ready);
+
 	priv->samp_freq_vals[0] = 1;
 	priv->samp_freq_vals[1] = 1;
 	priv->samp_freq_vals[2] = priv->sensor->data_types[0].max_sample_rate;
diff --git a/include/linux/iio/common/qcom_smgr.h b/include/linux/iio/common/qcom_smgr.h
index fdd3de12bb0a..4bcb1d39dff3 100644
--- a/include/linux/iio/common/qcom_smgr.h
+++ b/include/linux/iio/common/qcom_smgr.h
@@ -3,6 +3,7 @@
 #ifndef __QCOM_SMGR_H__
 #define __QCOM_SMGR_H__
 
+#include <linux/completion.h>
 #include <linux/iio/iio.h>
 #include <linux/iio/types.h>
 #include <linux/soc/qcom/qmi.h>
@@ -52,6 +53,10 @@ struct qcom_smgr_sensor {
 	struct qcom_smgr_data_type_item *data_types;
 
 	struct iio_dev *iio_dev;
+
+	/* Latest report sample, for one-shot sysfs reads */
+	u32 last_sample_values[3];
+	struct completion sample_ready;
 };
 
 struct qcom_smgr_iio_priv {
