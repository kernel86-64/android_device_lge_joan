From 8e9c8919094b3bb1932c15dbde97d11591d6c40e Mon Sep 17 00:00:00 2001
From: scada <scada@noreply.codeberg.org>
Date: Fri, 30 Oct 2026 04:56:08 +0400
Subject: [PATCH 76/78] ASoC: qdsp6: q6asm-dai: close a stopped stream before
 re-preparing

A stream that was stopped is still open on the DSP. Re-preparing it
(after an xrun or a failed trigger) skipped the close, so the open was
refused with ADSP_EALREADY; the error path then freed the audio client
without closing the stream, leaking the session on the DSP until
reboot. Close any non-idle stream, retry the open once after a close,
and leave freeing the client to close().
---
 sound/soc/qcom/qdsp6/q6asm-dai.c | 26 +++++++++++++++++++++-----
 1 file changed, 21 insertions(+), 5 deletions(-)

diff --git a/sound/soc/qcom/qdsp6/q6asm-dai.c b/sound/soc/qcom/qdsp6/q6asm-dai.c
index 0eae8c6e42b8..8e87830d3ec3 100644
--- a/sound/soc/qcom/qdsp6/q6asm-dai.c
+++ b/sound/soc/qcom/qdsp6/q6asm-dai.c
@@ -233,14 +233,18 @@ static int q6asm_dai_prepare(struct snd_soc_component *component,
 	prtd->pcm_count = snd_pcm_lib_period_bytes(substream);
 	prtd->pcm_irq_pos = 0;
 	/* rate and channels are sent to audio driver */
-	if (prtd->state == Q6ASM_STREAM_RUNNING) {
-		/* clear the previous setup if any  */
+	if (prtd->state != Q6ASM_STREAM_IDLE) {
+		/*
+		 * Clear the previous setup if any. A stopped stream is still
+		 * open on the DSP, so re-preparing after a stop (xrun, failed
+		 * trigger) must close it too, or the open below fails.
+		 */
 		q6asm_cmd(prtd->audio_client, prtd->stream_id, CMD_CLOSE);
 		q6asm_unmap_memory_regions(substream->stream,
 					   prtd->audio_client);
 		q6routing_stream_close(soc_prtd->dai_link->id,
 					 substream->stream);
-		prtd->state = Q6ASM_STREAM_STOPPED;
+		prtd->state = Q6ASM_STREAM_IDLE;
 	}
 
 	ret = q6asm_map_memory_regions(substream->stream, prtd->audio_client,
@@ -258,6 +262,19 @@ static int q6asm_dai_prepare(struct snd_soc_component *component,
 		ret = q6asm_open_write(prtd->audio_client, prtd->stream_id,
 				       FORMAT_LINEAR_PCM,
 				       0, prtd->bits_per_sample, false);
+		if (ret < 0) {
+			/*
+			 * The DSP keeps a stream it was never told to close
+			 * open, and refuses to open its session again. Close
+			 * it and retry once rather than failing forever.
+			 */
+			q6asm_cmd(prtd->audio_client, prtd->stream_id,
+				  CMD_CLOSE);
+			ret = q6asm_open_write(prtd->audio_client,
+					       prtd->stream_id,
+					       FORMAT_LINEAR_PCM, 0,
+					       prtd->bits_per_sample, false);
+		}
 	} else if (substream->stream == SNDRV_PCM_STREAM_CAPTURE) {
 		ret = q6asm_open_read(prtd->audio_client, prtd->stream_id,
 				      FORMAT_LINEAR_PCM,
@@ -304,9 +321,8 @@ static int q6asm_dai_prepare(struct snd_soc_component *component,
 routing_err:
 	q6asm_cmd(prtd->audio_client, prtd->stream_id,  CMD_CLOSE);
 open_err:
+	/* Keep the client: a later prepare may succeed, close() frees it. */
 	q6asm_unmap_memory_regions(substream->stream, prtd->audio_client);
-	q6asm_audio_client_free(prtd->audio_client);
-	prtd->audio_client = NULL;
 
 	return ret;
 }
