From 992c965ba41e17359a3c3d168eab62ca4d0e62ee Mon Sep 17 00:00:00 2001
From: scada <scada@noreply.codeberg.org>
Date: Thu, 22 Oct 2026 17:29:24 +0000
Subject: [PATCH 12/80] arm64: dts: qcom: msm8998-lg-joan: USB3 only on 6.18

6.18's phy-qcom-qmp-usbc has no MSM8998 USB3+DP combo support, so drive
the QMP PHY as the plain USB3 PHY (no phy cell, no DP resets/TCSR) and
leave the DisplayPort controller disabled.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0144VMKxYe33NKa3LLPZNivr
---
 arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts | 56 +++-----------------
 1 file changed, 6 insertions(+), 50 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts b/arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts
index df8b91a4d926..352e786da399 100644
--- a/arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts
+++ b/arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts
@@ -1222,7 +1222,7 @@ &usb3_dwc3 {
 	 * but the raised #phy-cells makes dtc warn and is the change that
 	 * previously broke USB on boards that were not updated.
 	 */
-	phys = <&qusb2phy>, <&usb3phy QMP_USB43DP_USB3_PHY>;
+	phys = <&qusb2phy>, <&usb3phy>;
 	dr_mode = "otg";
 	usb-role-switch;
 	role-switch-default-mode = "peripheral";
@@ -1233,26 +1233,14 @@ &usb3_dwc3_hs {
 };
 
 &usb3phy {
-	compatible = "qcom,msm8998-qmp-usb3-dp-phy";
-	reg = <0x0c010000 0x2000>;
-	#clock-cells = <1>;
-	#phy-cells = <1>;
-
-	resets = <&gcc GCC_USB3_PHY_BCR>,
-		 <&gcc GCC_USB3PHY_PHY_BCR>,
-		 <&gcc GCC_USB3_DP_PHY_BCR>;
-	reset-names = "phy", "phy_phy", "dp_phy";
-
 	/*
-	 * 0xb244 is the VLS clamp. 0xb248 selects the PHY mode and must
-	 * change while the resets above are asserted.
+	 * USB3 only on this kernel: the USB3+DP combo PHY support the
+	 * mainline joan tree uses is not in 6.18, so DisplayPort alt mode
+	 * stays off here.
 	 */
-	qcom,tcsr-reg = <&tcsr_regs_2 0xb244 0xb248>;
-
 	vdda-phy-supply = <&vreg_l1a_0p875>;
 	vdda-pll-supply = <&vreg_l2a_1p2>;
 
-	mode-switch;
 	orientation-switch;
 
 	status = "okay";
@@ -1270,43 +1258,11 @@ &mmcc {
 		 <&mdss_dsi1_phy DSI_PIXEL_PLL_CLK>,
 		 <&mdss_dsi1_phy DSI_BYTE_PLL_CLK>,
 		 <&mdss_hdmi_phy>,
-		 <&usb3phy QMP_USB43DP_DP_LINK_CLK>,
-		 <&usb3phy QMP_USB43DP_DP_VCO_DIV_CLK>,
+		 <0>,
+		 <0>,
 		 <&gcc GCC_MMSS_GPLL0_DIV_CLK>;
 };
 
-&mdss_dp {
-	status = "okay";
-	phys = <&usb3phy QMP_USB43DP_DP_PHY>;
-	phy-names = "dp";
-
-	assigned-clocks = <&mmcc DP_LINK_CLK_SRC>,
-			  <&mmcc DP_PIXEL_CLK_SRC>;
-	assigned-clock-parents = <&usb3phy QMP_USB43DP_DP_LINK_CLK>,
-				 <&usb3phy QMP_USB43DP_DP_VCO_DIV_CLK>;
-
-	ports {
-		port@1 {
-			mdss_dp_out: endpoint {
-				data-lanes = <2 3 1 0>;
-				remote-endpoint = <&usb3phy_dp_in>;
-			};
-		};
-	};
-};
-
-&usb3phy {
-	ports {
-		port@2 {
-			reg = <2>;
-
-			usb3phy_dp_in: endpoint {
-				remote-endpoint = <&mdss_dp_out>;
-			};
-		};
-	};
-};
-
 &wifi {
 	vdd-0.8-cx-mx-supply = <&vreg_l5a_0p8>;
 	vdd-1.8-xo-supply = <&vreg_l7a_1p8>;
