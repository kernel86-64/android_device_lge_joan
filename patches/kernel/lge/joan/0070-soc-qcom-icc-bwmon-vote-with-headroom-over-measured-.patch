From d8550bf8f313fa69eb84249d0df72aa8ff2404a7 Mon Sep 17 00:00:00 2001
From: scada <scada@noreply.codeberg.org>
Date: Thu, 29 Oct 2026 09:41:47 +0400
Subject: [PATCH 70/80] soc: qcom: icc-bwmon: vote with headroom over measured
 traffic

The monitor votes the OPP that covers the traffic it measured. For the
CPUs that traffic is capped by the vote itself, so on MSM8998 the DDR
vote settled at the 412 MHz step and a copy loop ran at 0.8-1.0 GB/s,
against 2.3 GB/s with DDR at full speed. The vendor bw_hwmon governor
avoided this by voting measured/io_percent.

Add an optional qcom,io-percent: thresholds still follow the measured
traffic, the vote is scaled up by 100/io_percent. Use the vendor value
(34) on MSM8998 and start its table at the vendor 1525 MB/s floor.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0144VMKxYe33NKa3LLPZNivr
---
 arch/arm64/boot/dts/qcom/msm8998.dtsi | 11 ++++-------
 drivers/soc/qcom/icc-bwmon.c          | 24 +++++++++++++++++++++++-
 2 files changed, 27 insertions(+), 8 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/msm8998.dtsi b/arch/arm64/boot/dts/qcom/msm8998.dtsi
index 304ecc4df840..71e3fa5392c3 100644
--- a/arch/arm64/boot/dts/qcom/msm8998.dtsi
+++ b/arch/arm64/boot/dts/qcom/msm8998.dtsi
@@ -2920,7 +2920,8 @@ bimc: interconnect@1000000 {
 		 * CPU to DDR bandwidth monitor. It raises the EBI vote with the
 		 * traffic the CPUs generate; without it DDR stays at whatever
 		 * the other masters vote, which starved memory-bound CPU work.
-		 * The steps are the vendor kernel's cpubw table (100-1804 MHz).
+		 * The steps are the vendor kernel's cpubw table from its 200 MHz floor
+		 * up to 1804 MHz.
 		 */
 		pmu@1008000 {
 			compatible = "qcom,msm8998-bwmon";
@@ -2928,17 +2929,13 @@ pmu@1008000 {
 			interrupts = <GIC_SPI 183 IRQ_TYPE_LEVEL_HIGH>;
 			interconnects = <&gnoc MAS_APSS_PROC &bimc SLV_EBI>;
 			operating-points-v2 = <&cpu_bwmon_opp_table>;
+			/* The vendor kernel's bw_hwmon io_percent for cpubw */
+			qcom,io-percent = <34>;
 
 			cpu_bwmon_opp_table: opp-table {
 				compatible = "operating-points-v2";
 
-				opp-0 {
-					opp-peak-kBps = <762000>;
-				};
 
-				opp-1 {
-					opp-peak-kBps = <1144000>;
-				};
 
 				opp-2 {
 					opp-peak-kBps = <1525000>;
diff --git a/drivers/soc/qcom/icc-bwmon.c b/drivers/soc/qcom/icc-bwmon.c
index 62cf5d2c30e9..c142decde494 100644
--- a/drivers/soc/qcom/icc-bwmon.c
+++ b/drivers/soc/qcom/icc-bwmon.c
@@ -190,6 +190,8 @@ struct icc_bwmon {
 	unsigned int min_bw_kbps;
 	unsigned int target_kbps;
 	unsigned int current_kbps;
+	/* Vote for measured traffic * 100 / io_percent */
+	unsigned int io_percent;
 };
 
 /* BWMON v4 */
@@ -689,7 +691,24 @@ static irqreturn_t bwmon_intr_thread(int irq, void *dev_id)
 	if (bwmon->target_kbps == bwmon->current_kbps)
 		goto out;
 
-	dev_pm_opp_set_opp(bwmon->dev, target_opp);
+	if (bwmon->io_percent < 100) {
+		/*
+		 * The CPUs can only generate as much traffic as the current
+		 * vote lets through; vote above the measured level so the
+		 * monitor can see demand grow, as the vendor bw_hwmon did.
+		 */
+		unsigned int vote_kbps = min_t(u64, (u64)bwmon->target_kbps * 100 /
+					      bwmon->io_percent, bwmon->max_bw_kbps);
+		struct dev_pm_opp *vote_opp =
+			dev_pm_opp_find_bw_ceil(bwmon->dev, &vote_kbps, 0);
+
+		if (!IS_ERR(vote_opp)) {
+			dev_pm_opp_set_opp(bwmon->dev, vote_opp);
+			dev_pm_opp_put(vote_opp);
+		}
+	} else {
+		dev_pm_opp_set_opp(bwmon->dev, target_opp);
+	}
 	bwmon->current_kbps = bwmon->target_kbps;
 
 out:
@@ -808,6 +827,9 @@ static int bwmon_probe(struct platform_device *pdev)
 	dev_pm_opp_put(opp);
 
 	bwmon->dev = dev;
+	bwmon->io_percent = 100;
+	of_property_read_u32(dev->of_node, "qcom,io-percent", &bwmon->io_percent);
+	bwmon->io_percent = clamp(bwmon->io_percent, 1U, 100U);
 
 	bwmon_disable(bwmon);
 
