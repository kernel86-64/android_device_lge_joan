From f7d0336f1ffa94ee97105a89d93ddb60bd45af24 Mon Sep 17 00:00:00 2001
From: scada <scada@noreply.codeberg.org>
Date: Fri, 30 Oct 2026 06:32:55 +0400
Subject: [PATCH 80/80] iio: qcom-smgr: sample at the requested rate

Buffering always asked the SLPI for the sensor's maximum rate and the
sampling_frequency attribute was only stored, and refused while
streaming. Android's 15 Hz auto-rotate listener got 500 accelerometer
events a second, keeping SensorService busy on the big cores. Request
the rate userspace set, apply changes while streaming by restarting
buffering, and advertise the supported range through
sampling_frequency_available.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01G6CiGx9h5EjLxvqnN8bcVp
---
 drivers/iio/common/qcom_smgr/qcom_smgr.c | 58 +++++++++++++++++++-----
 1 file changed, 46 insertions(+), 12 deletions(-)

diff --git a/drivers/iio/common/qcom_smgr/qcom_smgr.c b/drivers/iio/common/qcom_smgr/qcom_smgr.c
index 723ac2c638a1..913ac165c703 100644
--- a/drivers/iio/common/qcom_smgr/qcom_smgr.c
+++ b/drivers/iio/common/qcom_smgr/qcom_smgr.c
@@ -191,11 +191,14 @@ static int qcom_smgr_request_buffering(struct qcom_smgr *smgr,
 		 * A report cannot have 0 samples, therefore report rate cannot
 		 * be higher than sample rate.
 		 *
-		 * Fow now we default to the maximum sample rate and set the
-		 * report rate such that every report contains only 1 sample.
-		 * This gives us the lowest latency.
+		 * Sample at the rate userspace asked for (sampling_frequency),
+		 * the maximum by default, and set the report rate such that
+		 * every report contains only 1 sample. This gives us the
+		 * lowest latency without waking the CPU more than requested.
 		 */
-		if (data->native_sample_rates)
+		if (data->cur_sample_rate)
+			sample_rate = data->cur_sample_rate;
+		else if (data->native_sample_rates)
 			sample_rate = data->native_sample_rates
 					[data->native_sample_rate_count - 1];
 
@@ -434,17 +437,36 @@ static int qcom_smgr_iio_write_raw(struct iio_dev *iio_dev,
 				   struct iio_chan_spec const *chan, int val,
 				   int val2, long mask)
 {
+	struct qcom_smgr *smgr = dev_get_drvdata(iio_dev->dev.parent);
 	struct qcom_smgr_iio_priv *priv = iio_priv(iio_dev);
+	struct qcom_smgr_data_type_item *data;
+	int ret;
 
 	switch (mask) {
 	case IIO_CHAN_INFO_SAMP_FREQ:
-		if (!iio_device_claim_direct(iio_dev))
-			return -EBUSY;
+		data = qcom_smgr_sensor_data(priv->sensor);
+		if (val < 1 || val > data->max_sample_rate)
+			return -EINVAL;
 
-		qcom_smgr_sensor_data(priv->sensor)->cur_sample_rate = val;
+		if (iio_device_claim_direct(iio_dev)) {
+			data->cur_sample_rate = val;
+			iio_device_release_direct(iio_dev);
+			return 0;
+		}
 
-		iio_device_release_direct(iio_dev);
-		return 0;
+		/*
+		 * Streaming: Android changes rates on active sensors, so
+		 * restart buffering at the new rate instead of refusing.
+		 */
+		if (iio_device_claim_buffer_mode(iio_dev))
+			return -EBUSY;
+		ret = qcom_smgr_request_buffering(smgr, priv->sensor, false);
+		data->cur_sample_rate = val;
+		if (!ret)
+			ret = qcom_smgr_request_buffering(smgr, priv->sensor,
+							  true);
+		iio_device_release_buffer_mode(iio_dev);
+		return ret;
 	default:
 		return -EINVAL;
 	}
