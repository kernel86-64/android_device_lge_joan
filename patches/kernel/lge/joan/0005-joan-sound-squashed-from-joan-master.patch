diff --git a/sound/soc/codecs/btfm-slim.c b/sound/soc/codecs/btfm-slim.c
new file mode 100644
index 000000000000..9c92cce1cf9a
--- /dev/null
+++ b/sound/soc/codecs/btfm-slim.c
@@ -0,0 +1,650 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * SLIMbus audio path for the Qualcomm WCN399x Bluetooth/FM combination
+ * chip, as used on the LG V30 (joan).
+ *
+ * The WCN3990 exposes two SLIMbus devices on the msm8998's second NGD
+ * engine: a ported generic device (PGD, device index 1) that owns the
+ * slave ports, and its interface device (IFD, device index 0) carrying
+ * the port configuration registers at offset 0x800.  The FM receiver
+ * inside the chip digitises the analogue baseband at 48 kHz and streams
+ * it out through the two FM TX slave ports (PGD ports 1 and 2) as a
+ * two-channel group, which the ADSP receives on its SLIMBUS_8_TX AFE
+ * port.  The remaining ports (TX 0, RX 16/17) carry SCO/A2DP audio.
+ *
+ * Ported from the Qualcomm/LG Android kernel sources
+ * (android_kernel_lge_msm8998, Copyright (c) 2016-2017, The Linux
+ * Foundation, GPL-2.0):
+ *
+ *   drivers/bluetooth/btfm_slim.c         - SLIMbus client (PGD/IFD element
+ *                                           access, logical addresses)
+ *   drivers/bluetooth/btfm_slim_codec.c   - ASoC DAIs and channel mapping
+ *   drivers/bluetooth/btfm_slim_wcn3990.c - WCN3990 port map and port
+ *                                           enable/disable programming
+ *
+ * adapted to the mainline slimbus stream API and the modern
+ * snd_soc_component interface.  The chip must be powered (Bluetooth
+ * controller up / FM receiver on) before a stream can run, exactly as
+ * downstream; the FM receiver driver takes care of that part.
+ */
+
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/slimbus.h>
+#include <sound/pcm.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+
+/* WCN3990 interface-device register block (downstream btfm_slim_wcn3990.h) */
+#define WCN3990_SLIM_REG_OFFSET			0x0800
+
+#define WCN3990_SB_SLAVE_HW_REV_MSB		0x0001
+#define WCN3990_SB_SLAVE_HW_REV_LSB		0x0002
+
+#define WCN3990_SB_PGD_TX_PORT_CFG(n)		(0x0050 + (n))
+#define WCN3990_SB_PGD_RX_PORT_CFG(n)		(0x0040 + (n))
+#define WCN3990_SB_PGD_TX_PORT_MULTI_CH_0(n)	(0x0100 + 0x4 * (n))
+#define WCN3990_SB_PGD_RX_PORT_MULTI_CH_0(n)	(0x0180 + 0x4 * (n))
+#define WCN3990_SB_PGD_TX_PORT_OR_UR_CFG(n)	(0x01f0 + (n))
+
+#define WCN3990_PORT_ENABLE			BIT(0)
+#define WCN3990_PORT_WM_L1			(0x1 << 1)
+#define WCN3990_PORT_WM_L8			(0x8 << 1)
+#define WCN3990_PORT_WM_LB			(0xb << 1)
+#define WCN3990_OVERRUN_AUTO_RECOVERY		BIT(1)
+#define WCN3990_UNDERRUN_AUTO_RECOVERY		BIT(0)
+
+/* WCN3990 PGD port assignment (downstream btfm_slim_wcn3990.h) */
+#define WCN3990_PORT_TX_SCO			0
+#define WCN3990_PORT_TX1_FM			1
+#define WCN3990_PORT_TX2_FM			2
+#define WCN3990_PORT_RX_SCO			16
+#define WCN3990_PORT_RX_A2P			17
+
+/* Enumeration address of the WCN3990 devices (downstream msm8998.dtsi) */
+#define WCN3990_MANF_ID				0x0217
+#define WCN3990_PROD_CODE			0x0220
+
+enum {
+	BTFM_FM_SLIM_TX = 0,
+	BTFM_BT_SCO_SLIM_TX,
+	BTFM_BT_SCO_A2DP_SLIM_RX,
+	BTFM_BT_SPLIT_A2DP_SLIM_RX,
+	BTFM_SLIM_NUM_DAIS,
+};
+
+struct btfm_slim_ch {
+	u16 port;
+	unsigned int ch_num;
+};
+
+struct btfm_slim {
+	struct slim_device *sdev;	/* ported generic device */
+	struct slim_device *sidev;	/* interface device */
+	struct mutex io_lock;
+	bool enabled;
+	bool channels_set;
+	/* ADSP channel allocation handed over by the machine driver */
+	struct btfm_slim_ch tx_chs[3];
+	struct btfm_slim_ch rx_chs[2];
+	unsigned int rate;
+	unsigned int ch_count;
+	struct slim_stream_runtime *sruntime;
+};
+
+static int btfm_slim_write_ifd(struct btfm_slim *btfm, u16 reg, u8 val)
+{
+	int ret;
+
+	mutex_lock(&btfm->io_lock);
+	ret = slim_write(btfm->sidev, WCN3990_SLIM_REG_OFFSET + reg, 1, &val);
+	mutex_unlock(&btfm->io_lock);
+
+	if (ret)
+		dev_err(&btfm->sdev->dev, "IFD write 0x%04x failed: %d\n",
+			reg, ret);
+
+	return ret;
+}
+
+static int btfm_slim_read_ifd(struct btfm_slim *btfm, u16 reg, u8 *val)
+{
+	int ret;
+
+	mutex_lock(&btfm->io_lock);
+	ret = slim_read(btfm->sidev, WCN3990_SLIM_REG_OFFSET + reg, 1, val);
+	mutex_unlock(&btfm->io_lock);
+
+	if (ret)
+		dev_err(&btfm->sdev->dev, "IFD read 0x%04x failed: %d\n",
+			reg, ret);
+
+	return ret;
+}
+
+/*
+ * Probe the slave (downstream btfm_slim_chrk_hw_init).  The chip only
+ * answers once it is powered, so this runs at DAI startup, not at
+ * slimbus device probe.
+ */
+static int btfm_slim_hw_init(struct btfm_slim *btfm)
+{
+	u8 rev_msb, rev_lsb;
+	int ret;
+
+	if (btfm->enabled)
+		return 0;
+
+	ret = btfm_slim_read_ifd(btfm, WCN3990_SB_SLAVE_HW_REV_MSB, &rev_msb);
+	if (ret)
+		return ret;
+
+	ret = btfm_slim_read_ifd(btfm, WCN3990_SB_SLAVE_HW_REV_LSB, &rev_lsb);
+	if (ret)
+		return ret;
+
+	dev_dbg(&btfm->sdev->dev, "WCN3990 HW rev %u.%u.%u\n",
+		(rev_msb & 0xf0) >> 4, rev_msb & 0x0f, rev_lsb);
+
+	btfm->enabled = true;
+
+	return 0;
+}
+
+static void btfm_slim_hw_deinit(struct btfm_slim *btfm)
+{
+	btfm->enabled = false;
+}
+
+/*
+ * Slave port programming, ported from downstream
+ * btfm_slim_chrk_enable_port(): the multi-channel register selects the
+ * local channel slots feeding the port (TX slots equal the port number,
+ * RX slots count from port 16), the OR/UR register arms the automatic
+ * underrun/overrun recovery, and the port config register sets the
+ * watermark before enabling the port.
+ */
+static int btfm_slim_enable_fm_port(struct btfm_slim *btfm, u16 port,
+				    bool enable)
+{
+	u8 val;
+	int ret;
+
+	/* the two FM TX ports share the two-channel group */
+	val = BIT(WCN3990_PORT_TX1_FM) | BIT(WCN3990_PORT_TX2_FM);
+	ret = btfm_slim_write_ifd(btfm,
+				  WCN3990_SB_PGD_TX_PORT_MULTI_CH_0(port), val);
+	if (ret)
+		return ret;
+
+	if (enable) {
+		val = WCN3990_OVERRUN_AUTO_RECOVERY |
+		      WCN3990_UNDERRUN_AUTO_RECOVERY;
+		ret = btfm_slim_write_ifd(btfm,
+				WCN3990_SB_PGD_TX_PORT_OR_UR_CFG(port), val);
+		if (ret)
+			return ret;
+
+		val = WCN3990_PORT_ENABLE | WCN3990_PORT_WM_L8;
+	} else {
+		val = 0;
+	}
+
+	return btfm_slim_write_ifd(btfm, WCN3990_SB_PGD_TX_PORT_CFG(port), val);
+}
+
+static int btfm_slim_enable_sco_tx_port(struct btfm_slim *btfm, bool enable)
+{
+	u8 val;
+	int ret;
+
+	val = BIT(WCN3990_PORT_TX_SCO);
+	ret = btfm_slim_write_ifd(btfm,
+			WCN3990_SB_PGD_TX_PORT_MULTI_CH_0(WCN3990_PORT_TX_SCO),
+			val);
+	if (ret)
+		return ret;
+
+	if (enable) {
+		val = WCN3990_OVERRUN_AUTO_RECOVERY |
+		      WCN3990_UNDERRUN_AUTO_RECOVERY;
+		ret = btfm_slim_write_ifd(btfm,
+			WCN3990_SB_PGD_TX_PORT_OR_UR_CFG(WCN3990_PORT_TX_SCO),
+			val);
+		if (ret)
+			return ret;
+
+		val = WCN3990_PORT_ENABLE | WCN3990_PORT_WM_L1;
+	} else {
+		val = 0;
+	}
+
+	return btfm_slim_write_ifd(btfm,
+			WCN3990_SB_PGD_TX_PORT_CFG(WCN3990_PORT_TX_SCO), val);
+}
+
+static int btfm_slim_enable_rx_port(struct btfm_slim *btfm, u16 port,
+				    bool enable)
+{
+	u8 val = 0;
+	int ret;
+
+	if (enable) {
+		val = WCN3990_PORT_ENABLE | WCN3990_PORT_WM_LB;
+		ret = btfm_slim_write_ifd(btfm,
+			WCN3990_SB_PGD_RX_PORT_MULTI_CH_0(port - 16), BIT(0));
+		if (ret)
+			return ret;
+	}
+
+	return btfm_slim_write_ifd(btfm, WCN3990_SB_PGD_RX_PORT_CFG(port - 16),
+				   val);
+}
+
+static int btfm_slim_enable_ports(struct btfm_slim *btfm, int dai_id,
+				  bool enable)
+{
+	switch (dai_id) {
+	case BTFM_FM_SLIM_TX:
+		return btfm_slim_enable_fm_port(btfm, WCN3990_PORT_TX1_FM,
+						enable) ?:
+		       btfm_slim_enable_fm_port(btfm, WCN3990_PORT_TX2_FM,
+						enable);
+	case BTFM_BT_SCO_SLIM_TX:
+		return btfm_slim_enable_sco_tx_port(btfm, enable);
+	case BTFM_BT_SCO_A2DP_SLIM_RX:
+		return btfm_slim_enable_rx_port(btfm, WCN3990_PORT_RX_SCO,
+						enable);
+	case BTFM_BT_SPLIT_A2DP_SLIM_RX:
+		return btfm_slim_enable_rx_port(btfm, WCN3990_PORT_RX_A2P,
+						enable);
+	default:
+		return -EINVAL;
+	}
+}
+
+static int btfm_slim_dai_startup(struct snd_pcm_substream *substream,
+				 struct snd_soc_dai *dai)
+{
+	struct btfm_slim *btfm = snd_soc_component_get_drvdata(dai->component);
+
+	dev_dbg(dai->dev, "%s: dai %s\n", __func__, dai->name);
+
+	return btfm_slim_hw_init(btfm);
+}
+
+static void btfm_slim_dai_shutdown(struct snd_pcm_substream *substream,
+				   struct snd_soc_dai *dai)
+{
+	struct btfm_slim *btfm = snd_soc_component_get_drvdata(dai->component);
+
+	if (btfm->sruntime) {
+		slim_stream_disable(btfm->sruntime);
+		slim_stream_unprepare(btfm->sruntime);
+		slim_stream_free(btfm->sruntime);
+		btfm->sruntime = NULL;
+	}
+
+	btfm_slim_enable_ports(btfm, dai->id, false);
+	btfm_slim_hw_deinit(btfm);
+}
+
+static int btfm_slim_dai_hw_params(struct snd_pcm_substream *substream,
+				   struct snd_pcm_hw_params *params,
+				   struct snd_soc_dai *dai)
+{
+	struct btfm_slim *btfm = snd_soc_component_get_drvdata(dai->component);
+
+	btfm->rate = params_rate(params);
+
+	dev_dbg(dai->dev, "%s: dai %s rate %u ch %u\n", __func__, dai->name,
+		btfm->rate, params_channels(params));
+
+	/*
+	 * The FM group always carries both TX ports, exactly as
+	 * downstream (grp = true, nchan = 2); a mono FE taps one of the
+	 * two channels of the group at the ADM routing stage.
+	 */
+	btfm->ch_count = (dai->id == BTFM_FM_SLIM_TX) ? 2 : 1;
+
+	return 0;
+}
+
+static int btfm_slim_dai_prepare(struct snd_pcm_substream *substream,
+				 struct snd_soc_dai *dai)
+{
+	struct btfm_slim *btfm = snd_soc_component_get_drvdata(dai->component);
+	struct slim_stream_config cfg = {0};
+	const struct btfm_slim_ch *chs;
+	int nports, i, ret;
+
+	switch (dai->id) {
+	case BTFM_FM_SLIM_TX:
+		chs = &btfm->tx_chs[0];
+		nports = 2;
+		break;
+	case BTFM_BT_SCO_SLIM_TX:
+		chs = &btfm->tx_chs[2];
+		nports = 1;
+		break;
+	case BTFM_BT_SCO_A2DP_SLIM_RX:
+		chs = &btfm->rx_chs[0];
+		nports = 1;
+		break;
+	case BTFM_BT_SPLIT_A2DP_SLIM_RX:
+		chs = &btfm->rx_chs[1];
+		nports = 1;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	if (!btfm->channels_set) {
+		dev_err(dai->dev, "no channel map assigned for %s\n",
+			dai->name);
+		return -EINVAL;
+	}
+
+	/* one shared stream state: a second open would leak the first */
+	if (btfm->sruntime) {
+		dev_err(dai->dev, "%s: stream already active\n", dai->name);
+		return -EBUSY;
+	}
+
+	cfg.rate = btfm->rate;
+	cfg.bps = 16;
+	cfg.ch_count = btfm->ch_count;
+	cfg.direction = substream->stream;
+	cfg.port_mask = 0;
+	cfg.chs = kcalloc(btfm->ch_count, sizeof(*cfg.chs), GFP_KERNEL);
+	if (!cfg.chs)
+		return -ENOMEM;
+
+	for (i = 0; i < btfm->ch_count && i < nports; i++) {
+		cfg.chs[i] = chs[i].ch_num;
+		cfg.port_mask |= BIT(chs[i].port);
+	}
+
+	ret = btfm_slim_enable_ports(btfm, dai->id, true);
+	if (ret)
+		goto err_free_chs;
+
+	btfm->sruntime = slim_stream_allocate(btfm->sdev, "WCN399x-BTFM");
+	if (IS_ERR(btfm->sruntime)) {
+		ret = PTR_ERR(btfm->sruntime);
+		btfm->sruntime = NULL;
+		goto err_disable_ports;
+	}
+
+	ret = slim_stream_prepare(btfm->sruntime, &cfg);
+	if (ret) {
+		slim_stream_unprepare(btfm->sruntime);
+		goto err_free_stream;
+	}
+
+	ret = slim_stream_enable(btfm->sruntime);
+	if (ret)
+		goto err_unprepare;
+
+	kfree(cfg.chs);
+
+	return 0;
+
+err_unprepare:
+	slim_stream_unprepare(btfm->sruntime);
+err_free_stream:
+	slim_stream_free(btfm->sruntime);
+	btfm->sruntime = NULL;
+err_disable_ports:
+	btfm_slim_enable_ports(btfm, dai->id, false);
+err_free_chs:
+	kfree(cfg.chs);
+
+	return ret;
+}
+
+static int btfm_slim_set_channel_map(struct snd_soc_dai *dai,
+				     unsigned int tx_num,
+				     const unsigned int *tx_slot,
+				     unsigned int rx_num,
+				     const unsigned int *rx_slot)
+{
+	struct btfm_slim *btfm = snd_soc_component_get_drvdata(dai->component);
+	static const u16 tx_ports[3] = {
+		WCN3990_PORT_TX1_FM, WCN3990_PORT_TX2_FM, WCN3990_PORT_TX_SCO,
+	};
+	static const u16 rx_ports[2] = {
+		WCN3990_PORT_RX_SCO, WCN3990_PORT_RX_A2P,
+	};
+	unsigned int i;
+
+	/*
+	 * The machine driver hands us the ADSP channel allocation for the
+	 * whole slave (downstream msm_wcn_init), in table order: two FM
+	 * TX channels, one SCO TX channel, one SCO/A2DP and one split
+	 * A2DP RX channel.
+	 */
+	if (tx_num > 3 || rx_num > 2 || !tx_slot || !rx_slot) {
+		dev_err(dai->dev, "invalid channel map tx %u rx %u\n",
+			tx_num, rx_num);
+		return -EINVAL;
+	}
+
+	for (i = 0; i < tx_num; i++) {
+		btfm->tx_chs[i].ch_num = tx_slot[i];
+		btfm->tx_chs[i].port = tx_ports[i];
+	}
+	for (i = 0; i < rx_num; i++) {
+		btfm->rx_chs[i].ch_num = rx_slot[i];
+		btfm->rx_chs[i].port = rx_ports[i];
+	}
+
+	btfm->channels_set = true;
+
+	return 0;
+}
+
+static int btfm_slim_get_channel_map(const struct snd_soc_dai *dai,
+				     unsigned int *tx_num,
+				     unsigned int *tx_slot,
+				     unsigned int *rx_num,
+				     unsigned int *rx_slot)
+{
+	struct btfm_slim *btfm = snd_soc_component_get_drvdata(dai->component);
+
+	if (!btfm->channels_set)
+		return -EINVAL;
+
+	switch (dai->id) {
+	case BTFM_FM_SLIM_TX:
+		tx_slot[0] = btfm->tx_chs[0].ch_num;
+		tx_slot[1] = btfm->tx_chs[1].ch_num;
+		*tx_num = 2;
+		*rx_num = 0;
+		break;
+	case BTFM_BT_SCO_SLIM_TX:
+		tx_slot[0] = btfm->tx_chs[2].ch_num;
+		*tx_num = 1;
+		*rx_num = 0;
+		break;
+	case BTFM_BT_SCO_A2DP_SLIM_RX:
+		rx_slot[0] = btfm->rx_chs[0].ch_num;
+		*tx_num = 0;
+		*rx_num = 1;
+		break;
+	case BTFM_BT_SPLIT_A2DP_SLIM_RX:
+		rx_slot[0] = btfm->rx_chs[1].ch_num;
+		*tx_num = 0;
+		*rx_num = 1;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static const struct snd_soc_dai_ops btfm_slim_dai_ops = {
+	.startup	= btfm_slim_dai_startup,
+	.shutdown	= btfm_slim_dai_shutdown,
+	.hw_params	= btfm_slim_dai_hw_params,
+	.prepare	= btfm_slim_dai_prepare,
+	.set_channel_map = btfm_slim_set_channel_map,
+	.get_channel_map = btfm_slim_get_channel_map,
+};
+
+static struct snd_soc_dai_driver btfm_slim_dais[] = {
+	{
+		/* FM audio, WCN3990 -> ADSP (two-channel group) */
+		.name = "btfm_fm_slim_tx",
+		.id = BTFM_FM_SLIM_TX,
+		.capture = {
+			.stream_name = "FM TX Capture",
+			.rates = SNDRV_PCM_RATE_48000,
+			.formats = SNDRV_PCM_FMTBIT_S16_LE,
+			.rate_min = 48000,
+			.rate_max = 48000,
+			.channels_min = 1,
+			.channels_max = 2,
+		},
+		.ops = &btfm_slim_dai_ops,
+	},
+	{
+		/* Bluetooth SCO voice uplink: bt -> modem */
+		.name = "btfm_bt_sco_slim_tx",
+		.id = BTFM_BT_SCO_SLIM_TX,
+		.capture = {
+			.stream_name = "SCO TX Capture",
+			.rates = SNDRV_PCM_RATE_8000 | SNDRV_PCM_RATE_16000,
+			.formats = SNDRV_PCM_FMTBIT_S16_LE,
+			.rate_min = 8000,
+			.rate_max = 16000,
+			.channels_min = 1,
+			.channels_max = 1,
+		},
+		.ops = &btfm_slim_dai_ops,
+	},
+	{
+		/* Bluetooth SCO voice downlink: modem -> bt, or A2DP */
+		.name = "btfm_bt_sco_a2dp_slim_rx",
+		.id = BTFM_BT_SCO_A2DP_SLIM_RX,
+		.playback = {
+			.stream_name = "SCO A2DP RX Playback",
+			.rates = SNDRV_PCM_RATE_8000 | SNDRV_PCM_RATE_16000 |
+				 SNDRV_PCM_RATE_48000,
+			.formats = SNDRV_PCM_FMTBIT_S16_LE,
+			.rate_min = 8000,
+			.rate_max = 48000,
+			.channels_min = 1,
+			.channels_max = 1,
+		},
+		.ops = &btfm_slim_dai_ops,
+	},
+	{
+		/* Bluetooth split A2DP data: ADSP -> bt */
+		.name = "btfm_bt_split_a2dp_slim_rx",
+		.id = BTFM_BT_SPLIT_A2DP_SLIM_RX,
+		.playback = {
+			.stream_name = "SPLIT A2DP Playback",
+			.rates = SNDRV_PCM_RATE_48000,
+			.formats = SNDRV_PCM_FMTBIT_S16_LE,
+			.rate_min = 48000,
+			.rate_max = 48000,
+			.channels_min = 1,
+			.channels_max = 1,
+		},
+		.ops = &btfm_slim_dai_ops,
+	},
+};
+
+static const struct snd_soc_component_driver btfm_slim_comp = {
+	.name = "btfm-slim",
+};
+
+static void btfm_slim_sidev_put(void *data)
+{
+	put_device(data);
+}
+
+static int btfm_slim_probe(struct slim_device *sdev)
+{
+	struct device_node *ifc_np;
+	struct btfm_slim *btfm;
+	int ret;
+
+	btfm = devm_kzalloc(&sdev->dev, sizeof(*btfm), GFP_KERNEL);
+	if (!btfm)
+		return -ENOMEM;
+
+	ifc_np = of_parse_phandle(sdev->dev.of_node, "slim-ifc-dev", 0);
+	if (!ifc_np) {
+		dev_err(&sdev->dev, "slim-ifc-dev phandle missing\n");
+		return -EINVAL;
+	}
+
+	btfm->sidev = of_slim_get_device(sdev->ctrl, ifc_np);
+	of_node_put(ifc_np);
+	if (!btfm->sidev) {
+		dev_err(&sdev->dev, "interface device not found\n");
+		return -EINVAL;
+	}
+
+	ret = devm_add_action_or_reset(&sdev->dev, btfm_slim_sidev_put,
+				       &btfm->sidev->dev);
+	if (ret)
+		return ret;
+
+	btfm->sdev = sdev;
+	mutex_init(&btfm->io_lock);
+	dev_set_drvdata(&sdev->dev, btfm);
+
+	ret = devm_snd_soc_register_component(&sdev->dev, &btfm_slim_comp,
+					      btfm_slim_dais,
+					      ARRAY_SIZE(btfm_slim_dais));
+	if (ret)
+		dev_err(&sdev->dev, "failed to register component: %d\n", ret);
+
+	return ret;
+}
+
+static void btfm_slim_remove(struct slim_device *sdev)
+{
+	struct btfm_slim *btfm = dev_get_drvdata(&sdev->dev);
+
+	mutex_destroy(&btfm->io_lock);
+}
+
+static const struct slim_device_id btfm_slim_id[] = {
+	/*
+	 * The PGD only (device index 1); the interface device stays
+	 * driverless and is looked up through the slim-ifc-dev phandle.
+	 */
+	{ .manf_id = WCN3990_MANF_ID, .prod_code = WCN3990_PROD_CODE,
+	  .dev_index = 1, .instance = 0 },
+	{ }
+};
+MODULE_DEVICE_TABLE(slim, btfm_slim_id);
+
+static struct slim_driver btfm_slim_driver = {
+	.driver = {
+		.name = "btfm-slim-driver",
+	},
+	.probe = btfm_slim_probe,
+	.remove = btfm_slim_remove,
+	.id_table = btfm_slim_id,
+};
+
+static int __init btfm_slim_init(void)
+{
+	return slim_driver_register(&btfm_slim_driver);
+}
+module_init(btfm_slim_init);
+
+static void __exit btfm_slim_exit(void)
+{
+	slim_driver_unregister(&btfm_slim_driver);
+}
+module_exit(btfm_slim_exit);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Qualcomm WCN399x Bluetooth/FM SLIMbus audio codec");
diff --git a/sound/soc/codecs/es9218p.c b/sound/soc/codecs/es9218p.c
new file mode 100644
index 000000000000..90eeca7b9464
--- /dev/null
+++ b/sound/soc/codecs/es9218p.c
@@ -0,0 +1,757 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * ESS Technology ES9218P "Sabre" headphone DAC/amplifier
+ *
+ * Found on the LG V30 (msm8998, joan) as the "Quad DAC", sitting on BLSP1 QUP1
+ * at I2C 0x48, downstream of the WCD9340 codec on the headphone path.
+ *
+ * This is a fresh ASoC driver using the upstream idioms (regmap, DAPM,
+ * component driver). It is NOT a copy of LG's downstream es9218p.c, which is
+ * ~3700 lines dominated by vendor headphone-detection, impedance measurement,
+ * custom sysfs and per-SKU tuning. The register semantics below are taken from
+ * that driver's header, which is the only public description of the part.
+ *
+ * STATUS: working on hardware (LG V30, 2026-08-21). The part answers on BLSP1
+ * QUP1 with chip id 0xd0, the value LG's own driver checks for, and plays
+ * stereo audio: regmap, volume, mute, power sequencing, the register init and
+ * the analog amplifier power-up are all implemented and verified, and the DAC
+ * reports a locked DPLL while a stream runs.
+ *
+ * On joan the I2S feed is QUATERNARY MI2S, not tertiary -- tertiary carries the
+ * TFA9872 loudspeaker amplifier instead. Read the dai-link that names the codec
+ * (LPASS_BE_QUAT_MI2S_RX / msm-dai-q6-mi2s.3 -> es9218-codec.1-0048) rather than
+ * inferring the port from a neighbouring DT node.
+ *
+ * Not yet done: jack detection, and a sane default volume (full scale here is
+ * 0 dB into headphones and is uncomfortably loud).
+ *
+ * There is no ES9218P support anywhere upstream to compare against (the only
+ * ESS codec in tree, es9356, is a SoundWire part and shares no bus model with
+ * this one).
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/regmap.h>
+#include <sound/pcm.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include <sound/tlv.h>
+
+#define ES9218P_SYSTEM_REG		0x00
+#define ES9218P_INPUT_SELECT		0x01
+#define ES9218P_AUTOMUTE_CONFIG		0x02
+#define ES9218P_ANALOG_VOL_CTRL		0x03
+#define ES9218P_AUTOMUTE_TIME		0x04
+#define ES9218P_AUTOMUTE_LEVEL		0x05
+#define ES9218P_DOP_VOL_RAMP_RATE	0x06
+#define ES9218P_FILTER_BAND_SYSTEM_MUTE	0x07
+#define ES9218P_GPIO1_2_CONFIG		0x08
+#define ES9218P_MASTERMODE_SYNC_CONFIG	0x0a
+#define ES9218P_OVERCURRENT_PROTECT	0x0b
+#define ES9218P_DPLL_BANDWIDTH		0x0c
+#define ES9218P_THD_COMP_MONO_MODE	0x0d
+#define ES9218P_SOFT_START_CONFIG	0x0e
+#define ES9218P_VOL1_CTRL		0x0f
+#define ES9218P_VOL2_CTRL		0x10
+#define ES9218P_MASTERTRIM_4		0x11
+#define ES9218P_MASTERTRIM_3		0x12
+#define ES9218P_MASTERTRIM_2		0x13
+#define ES9218P_MASTERTRIM_1		0x14
+#define ES9218P_GPIO_INPUT_SEL		0x15
+#define ES9218P_CP_SS_DELAY		0x1b	/* charge pump soft-start delay */
+#define ES9218P_GEN_CONFIG		0x1d
+#define ES9218P_GPIO_INVERT_CLKGEAR1	0x1e
+#define ES9218P_GPIO_INVERT_CLKGEAR2	0x1f
+#define ES9218P_AMP_CONFIG		0x20
+#define ES9218P_AMP_MODE_HIFI1		0x02
+
+/*
+ * Analog output block.  LG's driver drives these directly with no symbolic
+ * names; the bit meanings below come from the comments in its power-up
+ * sequence (es9218p.c, es9218p_sabre_bypass2hifi()).
+ */
+#define ES9218P_ANALOG_OVERRIDE		0x2d	/* "register 45" */
+#define ES9218P_APDB			BIT(2)
+#define ES9218P_CPH_WEAK		BIT(3)
+#define ES9218P_CPH_STRONG		BIT(4)
+#define ES9218P_AREG_PDB		BIT(5)
+#define ES9218P_ENHPA			BIT(6)
+
+#define ES9218P_DIGITAL_OVERRIDE	0x2e	/* "register 46" */
+#define ES9218P_SHTINB			BIT(0)	/* release amp input shunt */
+#define ES9218P_SHTOUTB			BIT(1)	/* release amp output shunt */
+#define ES9218P_SEL1V			BIT(2)	/* external LDO */
+#define ES9218P_OVERRIDE_EN		BIT(7)
+
+#define ES9218P_CP_OVERRIDE		0x2f	/* "register 47" */
+#define ES9218P_CPL_WEAK		BIT(3)
+#define ES9218P_CPL_STRONG		BIT(4)
+#define ES9218P_ENCP_OE			BIT(5)
+#define ES9218P_ENAUX_OE		BIT(6)
+
+#define ES9218P_HPA_CTRL		0x30	/* "register 48" */
+#define ES9218P_STATE3_CTRL_SEL		0x07	/* minimum state-machine delay */
+#define ES9218P_HPAHIQ			BIT(3)
+#define ES9218P_ENHPA_OUT		BIT(6)
+
+/* ATC (analog volume) floor used while the output stage is brought up. */
+#define ES9218P_ATC_MIN			0x18
+#define ES9218P_CHIP_ID			0x40
+
+#define ES9218P_MAX_REGISTER		0x45
+
+/* ES9218P_INPUT_SELECT */
+#define ES9218P_INPUT_SEL_MASK		GENMASK(7, 6)
+#define ES9218P_INPUT_SEL_I2S		0
+/*
+ * Serial word length lives in bit 7 of the input-select register, and LG's
+ * es9218p_set_bit_width() writes the whole byte rather than masking: 0x00 for
+ * 16-bit, 0x80 for 24- and 32-bit.  An earlier version of this driver put the
+ * field in bits 1:0, so the register kept its 0x8c reset value -- 32-bit --
+ * while 16-bit frames were being sent, and the misaligned frames crackled.
+ */
+#define ES9218P_SERIAL_LEN_16		0x00
+#define ES9218P_SERIAL_LEN_32		0x80
+
+/* ES9218P_FILTER_BAND_SYSTEM_MUTE */
+#define ES9218P_SYSTEM_MUTE		BIT(0)
+
+struct es9218p_priv {
+	struct regmap *regmap;
+	bool internal_ldo;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *power_gpio;
+	struct gpio_desc *hph_sw_gpio;
+};
+
+static const struct reg_default es9218p_reg_defaults[] = {
+	{ ES9218P_SYSTEM_REG,		0x00 },
+	{ ES9218P_INPUT_SELECT,		0x8c },
+	{ ES9218P_ANALOG_VOL_CTRL,	0x40 },
+	{ ES9218P_VOL1_CTRL,		0x50 },
+	{ ES9218P_VOL2_CTRL,		0x50 },
+};
+
+static bool es9218p_volatile_reg(struct device *dev, unsigned int reg)
+{
+	/* status and chip-id space is read-only/volatile */
+	return reg >= ES9218P_CHIP_ID;
+}
+
+static const struct regmap_config es9218p_regmap_config = {
+	.reg_bits	= 8,
+	.val_bits	= 8,
+	.max_register	= ES9218P_MAX_REGISTER,
+	.reg_defaults	= es9218p_reg_defaults,
+	.num_reg_defaults = ARRAY_SIZE(es9218p_reg_defaults),
+	.volatile_reg	= es9218p_volatile_reg,
+	.cache_type	= REGCACHE_MAPLE,
+};
+
+/*
+ * Digital volume, registers 0x0f/0x10, one per channel. Downstream treats the
+ * value as attenuation in 0.5 dB steps with 0x00 = 0 dB, so the usable range is
+ * 0 dB down to -127.5 dB.
+ */
+static const DECLARE_TLV_DB_SCALE(es9218p_vol_tlv, -12750, 50, 1);
+
+/*
+ * Operating mode.  RESET_N and MODE2 are not independent signals: together they
+ * are a two-bit mode field on the DAC itself, transcribed from LG's es9218p.c:
+ *
+ *	RESET_N=H, MODE2=L	HiFi		DAC + amplifier active
+ *	RESET_N=H, MODE2=H	LowFi
+ *	RESET_N=L, MODE2=H	Low Power Bypass
+ *	RESET_N=L, MODE2=L	Standby (shutdown)
+ *
+ * In Low Power Bypass the part shuts its own DAC down and passes analogue
+ * through to the jack, which is how downstream idles: it sits in LPB and only
+ * transitions to HiFi once a load has been measured on insertion.
+ *
+ * Note the inversion.  reset-gpios is ACTIVE_LOW in DT, so a gpiod value of 0
+ * means RESET_N is *high* and the part is out of reset; hph-sw-gpios is
+ * ACTIVE_HIGH and maps straight through.
+ *
+ * This control only moves the mode pins.  The register sequences downstream
+ * runs across a transition (es9218p_sabre_hifi2lpb() and friends) are not
+ * implemented yet, so changing mode under an active stream is not expected to
+ * be glitch-free.
+ */
+/*
+ * Defined below, beside the register sequence and amplifier power-up it
+ * replays: a mode that holds RESET_N low clears the register map, so restoring
+ * the pins alone does not restore the part.
+ */
+static int es9218p_restore_after_reset(struct es9218p_priv *es9218p);
+
+enum es9218p_mode {
+	ES9218P_MODE_HIFI = 0,
+	ES9218P_MODE_LOWFI,
+	ES9218P_MODE_LPB,
+	ES9218P_MODE_STANDBY,
+};
+
+static const char * const es9218p_mode_text[] = {
+	"HiFi", "LowFi", "Low Power Bypass", "Standby",
+};
+
+static SOC_ENUM_SINGLE_EXT_DECL(es9218p_mode_enum, es9218p_mode_text);
+
+/* { reset gpiod value, mode2 gpiod value } per mode, in enum order. */
+static const u8 es9218p_mode_pins[][2] = {
+	[ES9218P_MODE_HIFI]	= { 0, 0 },
+	[ES9218P_MODE_LOWFI]	= { 0, 1 },
+	[ES9218P_MODE_LPB]	= { 1, 1 },
+	[ES9218P_MODE_STANDBY]	= { 1, 0 },
+};
+
+static int es9218p_mode_get(struct snd_kcontrol *kcontrol,
+			    struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct es9218p_priv *es9218p = snd_soc_component_get_drvdata(component);
+	int rst, sw, i;
+
+	if (!es9218p->reset_gpio || !es9218p->hph_sw_gpio)
+		return -ENODEV;
+
+	rst = gpiod_get_value_cansleep(es9218p->reset_gpio);
+	sw  = gpiod_get_value_cansleep(es9218p->hph_sw_gpio);
+
+	for (i = 0; i < ARRAY_SIZE(es9218p_mode_pins); i++) {
+		if (es9218p_mode_pins[i][0] == rst &&
+		    es9218p_mode_pins[i][1] == sw) {
+			ucontrol->value.enumerated.item[0] = i;
+			return 0;
+		}
+	}
+
+	return -EINVAL;
+}
+
+static int es9218p_mode_put(struct snd_kcontrol *kcontrol,
+			    struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct es9218p_priv *es9218p = snd_soc_component_get_drvdata(component);
+	unsigned int mode = ucontrol->value.enumerated.item[0];
+	struct snd_soc_dapm_context *dapm;
+	int rst, sw;
+
+	if (mode >= ARRAY_SIZE(es9218p_mode_pins))
+		return -EINVAL;
+
+	if (!es9218p->reset_gpio || !es9218p->hph_sw_gpio)
+		return -ENODEV;
+
+	rst = gpiod_get_value_cansleep(es9218p->reset_gpio);
+	sw  = gpiod_get_value_cansleep(es9218p->hph_sw_gpio);
+
+	if (es9218p_mode_pins[mode][0] == rst && es9218p_mode_pins[mode][1] == sw)
+		return 0;
+
+	/*
+	 * Leaving an amplifier mode has to hand amp-mode control back to the
+	 * mode pin before RESET_N drops, or the part does not reach bypass.
+	 * Downstream's es9218p_sabre_hifione2lpb() writes AMP_CONFIG = 0 --
+	 * "amp mode core on, amp mode gpio set to trigger Core On", which it
+	 * notes leaves the part in LowFi under GPIO2 control -- waits, and only
+	 * then pulls RESETb low. The 100 ms settle is what LG compiles in for
+	 * this board specifically (CONFIG_MACH_MSM8998_JOAN); the generic path
+	 * has no delay there.
+	 */
+	if (es9218p_mode_pins[mode][0] == 1 && rst == 0) {
+		regmap_write(es9218p->regmap, ES9218P_AMP_CONFIG, 0);
+		gpiod_set_value_cansleep(es9218p->hph_sw_gpio,
+					 es9218p_mode_pins[mode][1]);
+		msleep(100);
+		gpiod_set_value_cansleep(es9218p->reset_gpio,
+					 es9218p_mode_pins[mode][0]);
+		/*
+		 * RESET_N is asserted again from here, so the register
+		 * interface is gone until the part is woken the next time.
+		 */
+		regcache_cache_only(es9218p->regmap, true);
+	} else if (es9218p_mode_pins[mode][0] == 0) {
+		/* Powering the part back up: MODE2 first, then release RESET_N. */
+		gpiod_set_value_cansleep(es9218p->hph_sw_gpio,
+					 es9218p_mode_pins[mode][1]);
+		gpiod_set_value_cansleep(es9218p->reset_gpio,
+					 es9218p_mode_pins[mode][0]);
+		usleep_range(1000, 2000);
+		/* Out of reset again: the init replay below, and the
+		 * power-up sequence in es9218p_amp_power_up(), must reach
+		 * hardware. */
+		regcache_cache_only(es9218p->regmap, false);
+	} else {
+		gpiod_set_value_cansleep(es9218p->reset_gpio,
+					 es9218p_mode_pins[mode][0]);
+		gpiod_set_value_cansleep(es9218p->hph_sw_gpio,
+					 es9218p_mode_pins[mode][1]);
+		usleep_range(1000, 2000);
+	}
+
+	/*
+	 * RESET_N low clears the register map, so returning to an amplifier
+	 * mode has to replay the init sequence and bring the output stage back
+	 * up.  Without this the part reports the right mode and the card shows
+	 * a live route and a RUNNING PCM while the jack stays silent.
+	 */
+	if (es9218p_mode_pins[mode][0] == 0 && rst == 1)
+		es9218p_restore_after_reset(es9218p);
+
+	/*
+	 * Only HiFi drives the jack from this part.  Park the output pins in
+	 * every other mode so the DAPM path goes away and the DPCM backend
+	 * detaches from the front-end: while it stays attached, opening a
+	 * stream fails hw_params with -ENXIO as soon as the part leaves HiFi,
+	 * and that takes the whole front-end open down with it.
+	 */
+	dapm = snd_soc_component_to_dapm(component);
+	if (mode == ES9218P_MODE_HIFI) {
+		snd_soc_dapm_force_enable_pin(dapm, "HPOUTL");
+		snd_soc_dapm_force_enable_pin(dapm, "HPOUTR");
+	} else {
+		snd_soc_dapm_disable_pin(dapm, "HPOUTL");
+		snd_soc_dapm_disable_pin(dapm, "HPOUTR");
+	}
+	snd_soc_dapm_sync(dapm);
+
+	return 1;
+}
