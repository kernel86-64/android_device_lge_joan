From 8bbe3ccaf884e7b81fa18c774cc7a91d90116691 Mon Sep 17 00:00:00 2001
From: scada <scada@noreply.codeberg.org>
Date: Thu, 29 Oct 2026 09:27:36 +0400
Subject: [PATCH 68/78] remoteproc: qcom: pas: let a board keep one processor
 from auto-booting

All processors of one PAS driver instance auto-boot when it probes, so
loading the module early to bring up the SLPI also started the ADSP
before the services its users depend on were ready. Honour a
qcom,no-auto-boot property per node and set it on joan's ADSP, which
joan_rprocs.sh starts explicitly; the SLPI can then boot before the
framework enumerates sensors.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0144VMKxYe33NKa3LLPZNivr
---
 arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts | 6 ++++++
 drivers/remoteproc/qcom_q6v5_pas.c           | 7 ++++++-
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts b/arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts
index 518da1543c3e..05626da0ff49 100644
--- a/arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts
+++ b/arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts
@@ -1894,6 +1894,12 @@ swm: soundwire@c85 {
 };
 
 &remoteproc_adsp {
+	/*
+	 * joan_rprocs.sh starts the ADSP once the filesystem services and
+	 * Wi-Fi are ready; the SLPI shares the driver and must boot early,
+	 * before the framework reads the sensor list.
+	 */
+	qcom,no-auto-boot;
 	firmware-name = "qcom/msm8998/joan/adsp.mdt";
 	status = "okay";
 };
diff --git a/drivers/remoteproc/qcom_q6v5_pas.c b/drivers/remoteproc/qcom_q6v5_pas.c
index 158bcd6cc85c..c536246bf296 100644
--- a/drivers/remoteproc/qcom_q6v5_pas.c
+++ b/drivers/remoteproc/qcom_q6v5_pas.c
@@ -716,7 +716,12 @@ static int qcom_pas_probe(struct platform_device *pdev)
 		return -ENOMEM;
 	}
 
-	rproc->auto_boot = desc->auto_boot;
+	/*
+	 * A board can hold one processor back for userspace to start, while
+	 * the others of the same driver still boot as soon as it probes.
+	 */
+	rproc->auto_boot = desc->auto_boot &&
+			   !of_property_read_bool(pdev->dev.of_node, "qcom,no-auto-boot");
 	rproc_coredump_set_elf_info(rproc, ELFCLASS32, EM_NONE);
 
 	pas = rproc->priv;
