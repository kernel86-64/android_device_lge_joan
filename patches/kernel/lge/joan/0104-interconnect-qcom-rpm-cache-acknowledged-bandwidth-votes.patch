From 5b0636de1c75861dfc498c2d29e4196559bafc9e Mon Sep 17 00:00:00 2001
From: joan <joan@localhost>
Date: Sat, 21 Nov 2026 21:23:23 +0300
Subject: [PATCH] interconnect: qcom: rpm: cache acknowledged bandwidth votes

An OPP change can update a peak bandwidth vote without changing the
aggregate average bandwidth sent to the RPM. Avoid resending the same
average for every such update, just as bus clock rates are already cached.

Keep a per-context validity bit so that an initial zero vote is still
transmitted. Invalidate the old value before sending a changed vote: if a
master succeeds but its slave fails, even a subsequent request for the
old value must be resent. Cache a value only after both writes succeed,
and clear validity when the provider is probed again.

On LG V30, CPU OPP transitions repeatedly sent the same two slave-0 votes.
Removing these duplicate synchronous messages reduced measured median
OPP latency from 349/530 us to 36/26 us on the little/big clusters.
Peak bandwidth aggregation and bus clock updates are unchanged.
---
 drivers/interconnect/qcom/icc-rpm.c | 11 +++++++++++
 drivers/interconnect/qcom/icc-rpm.h |  4 ++++
 2 files changed, 15 insertions(+)

diff --git a/drivers/interconnect/qcom/icc-rpm.c b/drivers/interconnect/qcom/icc-rpm.c
index f0377259a..a3574942e 100644
--- a/drivers/interconnect/qcom/icc-rpm.c
+++ b/drivers/interconnect/qcom/icc-rpm.c
@@ -213,6 +213,12 @@ static int qcom_icc_rpm_set(struct qcom_icc_node *qn, u64 *bw)
 		return 0;
 
 	for (rpm_ctx = 0; rpm_ctx < QCOM_SMD_RPM_STATE_NUM; rpm_ctx++) {
+		if ((qn->last_bw_valid & BIT(rpm_ctx)) &&
+		    qn->last_bw[rpm_ctx] == bw[rpm_ctx])
+			continue;
+
+		/* A partial failure must also invalidate the previous vote. */
+		qn->last_bw_valid &= ~BIT(rpm_ctx);
 		bw_bps = icc_units_to_bps(bw[rpm_ctx]);
 
 		if (qn->mas_rpm_id != -1) {
@@ -238,6 +244,9 @@ static int qcom_icc_rpm_set(struct qcom_icc_node *qn, u64 *bw)
 				return ret;
 			}
 		}
+
+		qn->last_bw[rpm_ctx] = bw[rpm_ctx];
+		qn->last_bw_valid |= BIT(rpm_ctx);
 	}
 
 	return 0;
@@ -570,6 +579,8 @@ int qnoc_probe(struct platform_device *pdev)
 	for (i = 0; i < num_nodes; i++) {
 		size_t j;
 
+		qnodes[i]->last_bw_valid = 0;
+
 		if (!qnodes[i]->ab_coeff)
 			qnodes[i]->ab_coeff = qp->ab_coeff;
 
diff --git a/drivers/interconnect/qcom/icc-rpm.h b/drivers/interconnect/qcom/icc-rpm.h
index b8e346659..0eec6f62b 100644
--- a/drivers/interconnect/qcom/icc-rpm.h
+++ b/drivers/interconnect/qcom/icc-rpm.h
@@ -101,6 +101,8 @@ struct qcom_icc_qos {
  * @bus_clk_desc: a pointer to a rpm_clk_resource description of bus clocks
  * @sum_avg: current sum aggregate value of all avg bw requests
  * @max_peak: current max aggregate value of all peak bw requests
+ * @last_bw: last bandwidth acknowledged by the RPM for each context
+ * @last_bw_valid: bitmap of contexts with an acknowledged bandwidth
  * @mas_rpm_id:	RPM id for devices that are bus masters
  * @slv_rpm_id:	RPM id for devices that are bus slaves
  * @qos: NoC QoS setting parameters
@@ -118,6 +120,8 @@ struct qcom_icc_node {
 	const struct rpm_clk_resource *bus_clk_desc;
 	u64 sum_avg[QCOM_SMD_RPM_STATE_NUM];
 	u64 max_peak[QCOM_SMD_RPM_STATE_NUM];
+	u64 last_bw[QCOM_SMD_RPM_STATE_NUM];
+	u8 last_bw_valid;
 	int mas_rpm_id;
 	int slv_rpm_id;
 	struct qcom_icc_qos qos;
