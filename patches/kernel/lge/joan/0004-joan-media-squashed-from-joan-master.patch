+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Hynix HI553 5MP image sensor driver
+ *
+ * The front (VT) camera of the LG V30 (joan): a fixed-focus 5 MP sensor,
+ * wired by LG to BLSP2 I2C2 (downstream "i2c_8"), CSIPHY2 and MCLK2, with
+ * the BRCF016GWZ module EEPROM on the same bus.
+ *
+ * The register settings are LG's, recovered from the camera sensor library
+ * (libmmcamera_hi553.so) of the stock US998 30b firmware and byte-identical
+ * in the LineageOS SGCMarkus vendor trees: three 8-bit loads into the
+ * sensor's 0x2000 SRAM block, a common PLL/ISP block, and per-mode output
+ * registers for 2560x1920, 2560x1440 and 1280x720 (the mode list LG applies
+ * after its init; only the registers that differ from the 2560x1920 list
+ * are carried in the two smaller modes).  All modes share line length 2816
+ * and frame length 2083 at a 220 MHz CSI-2 link (4 lanes, RAW10, 30 fps):
+ * LG's camera_config.xml gives the front camera LaneMask 0x1F (four data
+ * lanes plus clock), and the library's op_pixel_clk of 176 MHz over four
+ * RAW10 lanes is 440 Mb/s per lane.
+ *
+ * The part follows the HI556/HI846 register map: 16-bit register data,
+ * chip ID 0x0553 readable at 0x0f16, streaming controlled by 0x0a00.  The
+ * exposure, gain and frame-length registers are LG's: the sensor library's
+ * output descriptor (libmmcamera_hi553.so @0x8fd0) lists x/y output
+ * 0x0a12/0x0a14, line length 0x0008, frame length 0x0006, coarse exposure
+ * 0x0004 and analogue gain 0x003a, and its exposure fill writes exactly
+ * those, plus 1.0x (0x0100) digital gain to 0x0126/0x012a/0x012c.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+#define HI553_REG_CHIP_ID		CCI_REG16(0x0f16)
+#define HI553_CHIP_ID			0x0553
+
+#define HI553_REG_MODE_SELECT		CCI_REG16(0x0a00)
+#define HI553_MODE_STANDBY		0x0000
+#define HI553_MODE_STREAMING		0x0100
+
+#define HI553_REG_FRAME_LENGTH		CCI_REG16(0x0006)
+#define HI553_FRAME_LENGTH_MAX		0x7fff
+
+/* Coarse (long) exposure in lines (LG: minimum 6) */
+#define HI553_REG_EXPOSURE		CCI_REG16(0x0004)
+#define HI553_EXPOSURE_MIN		6
+#define HI553_EXPOSURE_OFFSET		6
+#define HI553_EXPOSURE_DEFAULT		0x100
+
+/*
+ * Analogue gain code: gain = (code + 16) / 16, x1 to x16 (LG's library
+ * writes (gain - 1) * 16, clamped to [1, 16])
+ */
+#define HI553_REG_ANALOG_GAIN		CCI_REG16(0x003a)
+#define HI553_ANA_GAIN_MIN		0
+#define HI553_ANA_GAIN_MAX		240
+#define HI553_ANA_GAIN_DEFAULT		0
+
+#define HI553_XCLK_FREQ			24000000
+
+#define HI553_NATIVE_WIDTH		2560
+#define HI553_NATIVE_HEIGHT		1920
+
+/*
+ * LG runs the sensor on two CSI-2 lanes (lane_cnt 2, settle 0x11 in
+ * libmmcamera_hi553.so at 0xb1af8).  op_pixel_clk is 176 MHz for the
+ * 2560-wide modes and 88 MHz for the binned 1280x720 mode, so RAW10 over
+ * two DDR lanes needs a 440 MHz and a 220 MHz link respectively.
+ */
+enum hi553_link_freq {
+	HI553_LINK_FREQ_440MHZ,
+	HI553_LINK_FREQ_220MHZ,
+};
+
+static const s64 hi553_link_freqs[] = {
+	[HI553_LINK_FREQ_440MHZ] = 440000000,
+	[HI553_LINK_FREQ_220MHZ] = 220000000,
+};
+
+static const char * const hi553_supply_names[] = {
+	"dovdd",
+	"avdd",
+	"dvdd",
+};
+
+/*
+ * The sensor reads out unflipped and its first row starts G B.  LG's
+ * library labels it GRBG, but on the V30 under warm light the GRBG reading
+ * needs a red gain of 3.0 and a blue gain of 0.82 while the GBRG reading
+ * needs 0.82 and 3.0, which is what the IMX351 (whose order is confirmed)
+ * converges to in the same room; a grey-world render of a raw frame is
+ * natural in GBRG and colour-swapped in GRBG.
+ */
+static const u32 hi553_mbus_codes[] = {
+	MEDIA_BUS_FMT_SGBRG10_1X10,
+};
+
+struct hi553_mode {
+	u32 width;
+	u32 height;
+	struct v4l2_rect crop;
+	u32 line_length;	/* in pixels */
+	u32 frame_length;	/* default, in lines */
+	u64 pixel_rate;
+	enum hi553_link_freq link_freq;
+	const struct cci_reg_sequence *regs;
+	unsigned int num_regs;
+};
+
+struct hi553 {
+	struct device *dev;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct regmap *regmap;
+
+	struct clk *xclk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(hi553_supply_names)];
+
+	/* Link frequencies both the board and the driver support */
+	unsigned long link_freq_bitmap;
+
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *exposure;
+};
+
+static inline struct hi553 *to_hi553(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct hi553, sd);
+}
