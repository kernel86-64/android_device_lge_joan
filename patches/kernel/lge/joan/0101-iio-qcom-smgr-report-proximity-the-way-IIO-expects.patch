From 45fd6ec4947bdf2e8692e2f1dc456b1f0d6ec400 Mon Sep 17 00:00:00 2001
From: Lance <Gero3977@gmail.com>
Date: Fri, 6 Nov 2026 14:25:19 -0800
Subject: [PATCH 21/22] iio: qcom-smgr: report proximity the way IIO expects

Report the range when something is within range and 0 when nothing is.

iio-sensor-proxy also refused the sensor outright ("Found proximity
sensor but no PROXIMITY_NEAR_LEVEL udev property"). SMGR only gives a
near/far boolean, so the right level follows from the range and does not
depend on the device. Publish half the range as in_proximity_nearlevel,
as ltr501, stk3310 and vcnl4000 do, rather than asking every device
using this driver for a udev rule.

Tested before this change on an LG V30 (US998): four covers of the
sensor in 30 seconds each moved raw proximity between 3277 and 0 within
one half-second sample, so the boolean itself is reliable. 3277 is 0.05
in Q16, the 5 cm range SMGR reports for this part.

Signed-off-by: Lance <Gero3977@gmail.com>
Assisted-by: Claude-Code:claude-opus-5-5
---
 drivers/iio/common/qcom_smgr/qcom_smgr.c | 38 +++++++++++++++++++-----
 1 file changed, 31 insertions(+), 7 deletions(-)

diff --git a/drivers/iio/common/qcom_smgr/qcom_smgr.c b/drivers/iio/common/qcom_smgr/qcom_smgr.c
index e07769468..67432404c 100644
--- a/drivers/iio/common/qcom_smgr/qcom_smgr.c
+++ b/drivers/iio/common/qcom_smgr/qcom_smgr.c
@@ -307,16 +307,15 @@ static void qcom_smgr_buffering_report_handler(struct qmi_handle *hdl,
 	 * Proximity sensor values are reported differently from other sensors.
 	 * The value reported is a boolean (0 or 1, still in the same fixed-point
 	 * format) where 1 means the sensor is activated, i.e. something is
-	 * within its range. Use the reported range to pass an actual distance
-	 * value to IIO. We pass the sensor range when nothing is within range
-	 * (sensor maxed out) and 0 when something is within range (assume
-	 * sensor is covered).
+	 * within its range. IIO expects higher proximity values for closer
+	 * objects, so pass the sensor range when something is within range and
+	 * 0 when nothing is.
 	 */
 	if (sensor->type == SNS_SMGR_SENSOR_TYPE_PROX_LIGHT &&
 	    sensor->data_type == SNS_SMGR_DATA_TYPE_PRIMARY) {
 		temp = le32_to_cpu(iio_data.values[0]);
 		temp >>= SMGR_VALUE_DECIMAL_OFFSET;
-		temp = ~temp & 1;
+		temp &= 1;
 		temp *= sensor->data_types[0].range;
 		iio_data.values[0] = cpu_to_le32(temp);
 	}
@@ -391,6 +390,29 @@ static const struct iio_chan_spec_ext_info qcom_smgr_iio_ext_info[] = {
 	{ }
 };
 
+/*
+ * SMGR only tells us whether something is within range, so raw proximity is
+ * either 0 or the sensor range and any level between the two separates them.
+ */
+static ssize_t qcom_smgr_read_near_level(struct iio_dev *iio_dev,
+					 uintptr_t private,
+					 const struct iio_chan_spec *chan,
+					 char *buf)
+{
+	struct qcom_smgr_iio_priv *priv = iio_priv(iio_dev);
+
+	return sysfs_emit(buf, "%u\n", priv->sensor->data_types[0].range / 2);
+}
+
+static const struct iio_chan_spec_ext_info qcom_smgr_prox_ext_info[] = {
+	{
+		.name = "nearlevel",
+		.shared = IIO_SEPARATE,
+		.read = qcom_smgr_read_near_level,
+	},
+	{ }
+};
+
 static int qcom_smgr_iio_read_raw(struct iio_dev *iio_dev,
 				  struct iio_chan_spec const *chan, int *val,
 				  int *val2, long mask)
@@ -707,7 +729,8 @@ static const struct iio_chan_spec qcom_smgr_prox_iio_channels[] = {
 		.info_mask_separate = BIT(IIO_CHAN_INFO_RAW) |
 			      BIT(IIO_CHAN_INFO_SCALE) |
 				      BIT(IIO_CHAN_INFO_SAMP_FREQ),
-		.info_mask_separate_available = BIT(IIO_CHAN_INFO_SAMP_FREQ)
+		.info_mask_separate_available = BIT(IIO_CHAN_INFO_SAMP_FREQ),
+		.ext_info = qcom_smgr_prox_ext_info
 	},
 	{
 		.type = IIO_TIMESTAMP,
@@ -763,7 +786,8 @@ static const struct iio_chan_spec qcom_smgr_pressure_iio_channels[] = {
 		.info_mask_separate = BIT(IIO_CHAN_INFO_RAW) |
 			      BIT(IIO_CHAN_INFO_SCALE) |
 				      BIT(IIO_CHAN_INFO_SAMP_FREQ),
-		.info_mask_separate_available = BIT(IIO_CHAN_INFO_SAMP_FREQ)
+		.info_mask_separate_available = BIT(IIO_CHAN_INFO_SAMP_FREQ),
+		.ext_info = qcom_smgr_prox_ext_info
 	},
 	{
 		.type = IIO_TIMESTAMP,
