From fd58dde8def6577c75138514dee504c9eccc1427 Mon Sep 17 00:00:00 2001
From: scada <scada@noreply.codeberg.org>
Date: Sat, 24 Oct 2026 19:59:42 +0000
Subject: [PATCH 46/53] Revert the CPU BWMON: its RPM bandwidth votes time out
 (-110) and take the ADSP with them

v27 (with BWMON) logs "qcom-bwmon ... Failed to set bandwidth: -110" and
"qcom_icc_rpm_smd_send slv 0 error -110", then the ADSP stops answering
glink entirely: "timeout waiting for subsystem event response", then
"intent request timed out" every 2 s, and ath10k never gets past its
regulator line, so there is no wlan0 and no Wi-Fi.

v19 (97b34065565a, before the BWMON) has none of this: no -110s, no glink
timeouts, ath10k QMI completes and wlan0 comes up. Revert the BWMON node,
its icc-rpm ioremap change and the ThinLTO/no-NUMA config to get back to
that state.

Also enable hung-task detection with panic-on-hang (30 s) and panic=10:
a wedge now panics, reboots by itself and leaves the stacks in ramoops
instead of needing a manual Power+Volume Down reset.
---
 arch/arm64/boot/dts/qcom/msm8998.dtsi | 32 ---------------------------
 arch/arm64/configs/joan_defconfig     | 12 +++++++---
 drivers/interconnect/qcom/icc-rpm.c   | 11 +++------
 3 files changed, 12 insertions(+), 43 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/msm8998.dtsi b/arch/arm64/boot/dts/qcom/msm8998.dtsi
index 1078908696aa..53d1f9e76d58 100644
--- a/arch/arm64/boot/dts/qcom/msm8998.dtsi
+++ b/arch/arm64/boot/dts/qcom/msm8998.dtsi
@@ -2910,38 +2910,6 @@ ipa: ipa@1e40000 {
 			status = "disabled";
 		};
 
-		/*
-		 * CPU bandwidth monitor (BWMON v4) on BIMC master port 0. It
-		 * scales the CPU's DDR vote with measured traffic; without it the
-		 * CPU has no DDR vote of its own. Table from downstream
-		 * qcom,cpubw (MB/s).
-		 */
-		pmu@1008000 {
-			compatible = "qcom,msm8998-bwmon";
-			reg = <0x01008000 0x300>, <0x01001000 0x200>;
-			reg-names = "monitor", "global";
-			interrupts = <GIC_SPI 183 IRQ_TYPE_LEVEL_HIGH>;
-			interconnects = <&gnoc MAS_APSS_PROC &bimc SLV_EBI>;
-			operating-points-v2 = <&cpu_bwmon_opp_table>;
-
-			cpu_bwmon_opp_table: opp-table {
-				compatible = "operating-points-v2";
-
-				opp-0 { opp-peak-kBps = <762000>; };
-				opp-1 { opp-peak-kBps = <1144000>; };
-				opp-2 { opp-peak-kBps = <1525000>; };
-				opp-3 { opp-peak-kBps = <2288000>; };
-				opp-4 { opp-peak-kBps = <3143000>; };
-				opp-5 { opp-peak-kBps = <4173000>; };
-				opp-6 { opp-peak-kBps = <5195000>; };
-				opp-7 { opp-peak-kBps = <5859000>; };
-				opp-8 { opp-peak-kBps = <7759000>; };
-				opp-9 { opp-peak-kBps = <9887000>; };
-				opp-10 { opp-peak-kBps = <11863000>; };
-				opp-11 { opp-peak-kBps = <13763000>; };
-			};
-		};
-
 		bimc: interconnect@1000000 {
 			compatible = "qcom,msm8998-bimc";
 			reg = <0x01000000 0x80000>;
diff --git a/arch/arm64/configs/joan_defconfig b/arch/arm64/configs/joan_defconfig
index 8944f5b21ecf..eb17458e3343 100644
--- a/arch/arm64/configs/joan_defconfig
+++ b/arch/arm64/configs/joan_defconfig
@@ -42,6 +42,7 @@ CONFIG_PROFILING=y
 CONFIG_KEXEC=y
 CONFIG_KEXEC_FILE=y
 CONFIG_ARCH_QCOM=y
+CONFIG_NUMA=y
 CONFIG_XEN=y
 CONFIG_COMPAT=y
 CONFIG_RANDOMIZE_BASE=y
@@ -68,7 +69,6 @@ CONFIG_ARM_QCOM_CPUFREQ_HW=y
 CONFIG_ARM_QCOM_CPUFREQ_OSM=y
 CONFIG_ARM_SCMI_CPUFREQ=y
 CONFIG_KPROBES=y
-CONFIG_LTO_CLANG_THIN=y
 CONFIG_MODULES=y
 CONFIG_MODULE_UNLOAD=y
 CONFIG_MODULE_COMPRESS=y
@@ -89,7 +89,6 @@ CONFIG_MEMORY_FAILURE=y
 CONFIG_TRANSPARENT_HUGEPAGE=y
 CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
 CONFIG_READ_ONLY_THP_FOR_FS=y
-CONFIG_CMA_AREAS=20
 CONFIG_ANON_VMA_NAME=y
 CONFIG_USERFAULTFD=y
 CONFIG_LRU_GEN=y
@@ -1301,7 +1300,7 @@ CONFIG_QCOM_SPM=y
 CONFIG_QCOM_STATS=y
 CONFIG_QCOM_WCNSS_CTRL=m
 CONFIG_QCOM_APR=y
-CONFIG_QCOM_ICC_BWMON=y
+CONFIG_QCOM_ICC_BWMON=m
 CONFIG_QCOM_PBS=y
 CONFIG_SOC_TI=y
 CONFIG_QCOM_CPR=y
@@ -1505,6 +1504,13 @@ CONFIG_PRINTK_TIME=y
 CONFIG_DEBUG_KERNEL=y
 CONFIG_DEBUG_INFO_DWARF5=y
 CONFIG_MAGIC_SYSRQ=y
+# A wedged task should panic: panic=10 reboots on its own and ramoops keeps
+# the stacks, so a freeze no longer needs a manual Power+VolDown reset.
+CONFIG_DETECT_HUNG_TASK=y
+CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=30
+CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
+CONFIG_BOOTPARAM_HUNG_TASK_PANIC_VALUE=1
+CONFIG_PANIC_TIMEOUT=10
 CONFIG_DEBUG_FS=y
 CONFIG_CORESIGHT=m
 CONFIG_CORESIGHT_LINK_AND_SINK_TMC=m
diff --git a/drivers/interconnect/qcom/icc-rpm.c b/drivers/interconnect/qcom/icc-rpm.c
index 1137d58188c0..ea1042d38128 100644
--- a/drivers/interconnect/qcom/icc-rpm.c
+++ b/drivers/interconnect/qcom/icc-rpm.c
@@ -526,14 +526,9 @@ int qnoc_probe(struct platform_device *pdev)
 			return -ENODEV;
 		}
 
-		/*
-		 * Map without claiming the region: on MSM8998 the BIMC block
-		 * also contains the CPU bandwidth monitor (master port 0 at
-		 * +0x8000), which icc-bwmon maps on its own.
-		 */
-		mmio = devm_ioremap(dev, res->start, resource_size(res));
-		if (!mmio)
-			return -ENOMEM;
+		mmio = devm_ioremap_resource(dev, res);
+		if (IS_ERR(mmio))
+			return PTR_ERR(mmio);
 
 		qp->regmap = devm_regmap_init_mmio(dev, mmio, desc->regmap_cfg);
 		if (IS_ERR(qp->regmap)) {
-- 
