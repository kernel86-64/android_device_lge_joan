From 31e86ea67c930642a1bd3c254181d3206365e194 Mon Sep 17 00:00:00 2001
From: scada <scada@noreply.codeberg.org>
Date: Fri, 30 Oct 2026 04:56:09 +0400
Subject: [PATCH 78/80] ASoC: es9218p, sdm845: Quad DAC controls and a 24-bit
 link on joan

Expose the ES9218P digital filter, headphone type and analog volume as
in LG's driver, apply them on amplifier power-up, and run quaternary
MI2S at S24_LE with a 3.072 MHz bit clock when the board asks for it
(qcom,quat-mi2s-s24) so software volume does not cost DAC resolution.
---
 arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts |   2 +
 sound/soc/codecs/es9218p.c                   | 176 ++++++++++++++++++-
 sound/soc/qcom/sdm845.c                      |  23 ++-
 3 files changed, 194 insertions(+), 7 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts b/arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts
index 05626da0ff49..ee73c4872021 100644
--- a/arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts
+++ b/arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts
@@ -1959,6 +1959,8 @@ / {
 	sound {
 		compatible = "qcom,sdm845-sndcard";
 		model = "LG-V30";
+		/* The ES9218P on quaternary MI2S takes 24-bit samples. */
+		qcom,quat-mi2s-s24;
 		status = "okay";
 
 		pinctrl-0 = <&quat_mi2s_default>, <&tert_mi2s_default>;
diff --git a/sound/soc/codecs/es9218p.c b/sound/soc/codecs/es9218p.c
index 90eeca7b9464..384f6d4ad6b7 100644
--- a/sound/soc/codecs/es9218p.c
+++ b/sound/soc/codecs/es9218p.c
@@ -22,8 +22,8 @@
  * (LPASS_BE_QUAT_MI2S_RX / msm-dai-q6-mi2s.3 -> es9218-codec.1-0048) rather than
  * inferring the port from a neighbouring DT node.
  *
- * Not yet done: jack detection, and a sane default volume (full scale here is
- * 0 dB into headphones and is uncomfortably loud).
+ * Not yet done: jack detection and headphone load measurement; the headphone
+ * type is chosen by the user instead.
  *
  * There is no ES9218P support anywhere upstream to compare against (the only
  * ESS codec in tree, es9356, is a SoundWire part and shares no bus model with
@@ -68,6 +68,9 @@
 #define ES9218P_GPIO_INVERT_CLKGEAR2	0x1f
 #define ES9218P_AMP_CONFIG		0x20
 #define ES9218P_AMP_MODE_HIFI1		0x02
+#define ES9218P_AMP_MODE_HIFI2		0x03	/* higher swing for high impedance loads */
+#define ES9218P_THD_COMP_LEFT		0x16	/* 22..25: C2 (2 bytes), C3 (2 bytes) */
+#define ES9218P_THD_COMP_RIGHT		0x35	/* 53..56 */
 
 /*
  * Analog output block.  LG's driver drives these directly with no symbolic
@@ -119,10 +122,39 @@
 
 /* ES9218P_FILTER_BAND_SYSTEM_MUTE */
 #define ES9218P_SYSTEM_MUTE		BIT(0)
+#define ES9218P_FILTER_SHAPE_SHIFT	5
+
+/* ES9218P_ANALOG_VOL_CTRL: 0x40 plus the attenuation in dB, 0..24 dB */
+#define ES9218P_AVC_BASE		0x40
+#define ES9218P_AVC_MAX_ATTEN		24
+
+/*
+ * Headphone type, as LG's driver selects it after measuring the load: the
+ * amplifier mode and the harmonic (THD) compensation it applies, per channel.
+ * The tables are LG's (normal/advance/aux_harmonic_comp_{left,right}).
+ */
+enum es9218p_hp_type {
+	ES9218P_HP_NORMAL = 0,
+	ES9218P_HP_HIGH_IMPEDANCE,
+	ES9218P_HP_AUX,
+};
+
+static const char * const es9218p_hp_type_text[] = {
+	"Normal", "High Impedance", "AUX",
+};
+
+static const u8 es9218p_thd_comp[][2][4] = {
+	[ES9218P_HP_NORMAL] =		{ { 0x18, 0x00, 0x90, 0xfc }, { 0x28, 0x00, 0x90, 0xfc } },
+	[ES9218P_HP_HIGH_IMPEDANCE] =	{ { 0x1c, 0x02, 0x46, 0x00 }, { 0xea, 0x01, 0x64, 0x00 } },
+	[ES9218P_HP_AUX] =		{ { 0x18, 0x01, 0x11, 0xfe }, { 0x18, 0x01, 0x11, 0xfe } },
+};
 
 struct es9218p_priv {
 	struct regmap *regmap;
 	bool internal_ldo;
+	bool amp_on;
+	enum es9218p_hp_type hp_type;
+	unsigned int avc_atten;	/* analog volume attenuation, dB */
 	struct gpio_desc *reset_gpio;
 	struct gpio_desc *power_gpio;
 	struct gpio_desc *hph_sw_gpio;
@@ -276,6 +308,7 @@ static int es9218p_mode_put(struct snd_kcontrol *kcontrol,
 		 * interface is gone until the part is woken the next time.
 		 */
 		regcache_cache_only(es9218p->regmap, true);
+		es9218p->amp_on = false;
 	} else if (es9218p_mode_pins[mode][0] == 0) {
 		/* Powering the part back up: MODE2 first, then release RESET_N. */
 		gpiod_set_value_cansleep(es9218p->hph_sw_gpio,
@@ -324,7 +357,120 @@ static int es9218p_mode_put(struct snd_kcontrol *kcontrol,
 	return 1;
 }
 
+/*
+ * Digital filter: the roll-off shape in register 7, bits 7:5. LG's menu
+ * offers Short (5), Sharp (0) and Slow (1) and defaults to 4.
+ */
+static const char * const es9218p_filter_text[] = {
+	"Fast Roll-off", "Slow Roll-off", "Minimum Phase Fast",
+	"Minimum Phase Slow", "Apodizing Fast", "Short",
+	"Hybrid Fast", "Brick Wall",
+};
+
+static SOC_ENUM_SINGLE_DECL(es9218p_filter_enum, ES9218P_FILTER_BAND_SYSTEM_MUTE,
+			    ES9218P_FILTER_SHAPE_SHIFT, es9218p_filter_text);
+
+static SOC_ENUM_SINGLE_EXT_DECL(es9218p_hp_type_enum, es9218p_hp_type_text);
+
+static int es9218p_apply_hp_type(struct es9218p_priv *es9218p)
+{
+	const u8 (*thd)[4] = es9218p_thd_comp[es9218p->hp_type];
+	int ret, i;
+
+	/* Cached registers: written now, or replayed at the next power-up. */
+	for (i = 0; i < 4; i++) {
+		ret = regmap_write(es9218p->regmap, ES9218P_THD_COMP_LEFT + i, thd[0][i]);
+		if (!ret)
+			ret = regmap_write(es9218p->regmap, ES9218P_THD_COMP_RIGHT + i, thd[1][i]);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static unsigned int es9218p_amp_mode(struct es9218p_priv *es9218p)
+{
+	return es9218p->hp_type == ES9218P_HP_HIGH_IMPEDANCE ?
+	       ES9218P_AMP_MODE_HIFI2 : ES9218P_AMP_MODE_HIFI1;
+}
+
+static int es9218p_hp_type_get(struct snd_kcontrol *kcontrol,
+			       struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct es9218p_priv *es9218p = snd_soc_component_get_drvdata(component);
+
+	ucontrol->value.enumerated.item[0] = es9218p->hp_type;
+	return 0;
+}
+
+static int es9218p_hp_type_put(struct snd_kcontrol *kcontrol,
+			       struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct es9218p_priv *es9218p = snd_soc_component_get_drvdata(component);
+	unsigned int type = ucontrol->value.enumerated.item[0];
+	int ret;
+
+	if (type >= ARRAY_SIZE(es9218p_hp_type_text))
+		return -EINVAL;
+	if (type == es9218p->hp_type)
+		return 0;
+
+	es9218p->hp_type = type;
+	ret = es9218p_apply_hp_type(es9218p);
+	if (!ret && es9218p->amp_on)
+		ret = regmap_write(es9218p->regmap, ES9218P_AMP_CONFIG,
+				   es9218p_amp_mode(es9218p));
+
+	return ret ? ret : 1;
+}
+
+/* Analog volume (AVC): 0 dB down to -24 dB, in 1 dB steps. */
+static const DECLARE_TLV_DB_SCALE(es9218p_avc_tlv, -2400, 100, 0);
+
+static int es9218p_avc_get(struct snd_kcontrol *kcontrol,
+			   struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct es9218p_priv *es9218p = snd_soc_component_get_drvdata(component);
+
+	ucontrol->value.integer.value[0] = ES9218P_AVC_MAX_ATTEN - es9218p->avc_atten;
+	return 0;
+}
+
+static int es9218p_avc_put(struct snd_kcontrol *kcontrol,
+			   struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct es9218p_priv *es9218p = snd_soc_component_get_drvdata(component);
+	long val = ucontrol->value.integer.value[0];
+	unsigned int atten;
+
+	if (val < 0 || val > ES9218P_AVC_MAX_ATTEN)
+		return -EINVAL;
+
+	atten = ES9218P_AVC_MAX_ATTEN - val;
+	if (atten == es9218p->avc_atten)
+		return 0;
+
+	es9218p->avc_atten = atten;
+	/* The power-up sequence owns the register while the amp is off. */
+	if (es9218p->amp_on)
+		regmap_write(es9218p->regmap, ES9218P_ANALOG_VOL_CTRL,
+			     ES9218P_AVC_BASE | atten);
+
+	return 1;
+}
+
 static const struct snd_kcontrol_new es9218p_snd_controls[] = {
+	SOC_ENUM("Headphone Digital Filter", es9218p_filter_enum),
+	SOC_ENUM_EXT("Headphone Type", es9218p_hp_type_enum,
+		     es9218p_hp_type_get, es9218p_hp_type_put),
+	SOC_SINGLE_EXT_TLV("Headphone Analog Volume", SND_SOC_NOPM, 0,
+			   ES9218P_AVC_MAX_ATTEN, 0,
+			   es9218p_avc_get, es9218p_avc_put, es9218p_avc_tlv),
 	SOC_DOUBLE_R_TLV("Headphone Playback Volume",
 			 ES9218P_VOL1_CTRL, ES9218P_VOL2_CTRL,
 			 0, 0xff, 1, es9218p_vol_tlv),
@@ -482,7 +628,7 @@ static int es9218p_amp_power_up(struct es9218p_priv *es9218p)
 		ret = regmap_write(rm, ES9218P_DIGITAL_OVERRIDE, r46);
 	if (!ret)
 		ret = regmap_write(rm, ES9218P_AMP_CONFIG,
-				   ES9218P_AMP_MODE_HIFI1);
+				   es9218p_amp_mode(es9218p));
 	if (!ret)
 		ret = regmap_write(rm, ES9218P_ANALOG_VOL_CTRL,
 				   ES9218P_ATC_MIN);
@@ -523,7 +669,8 @@ static int es9218p_amp_power_up(struct es9218p_priv *es9218p)
 				   ES9218P_ENHPA_OUT);
 	/* Restore the analog volume the ATC floor above displaced. */
 	if (!ret)
-		ret = regmap_write(rm, ES9218P_ANALOG_VOL_CTRL, 0x40);
+		ret = regmap_write(rm, ES9218P_ANALOG_VOL_CTRL,
+				   ES9218P_AVC_BASE | es9218p->avc_atten);
 	/*
 	 * Release the output shunt and hand control back to AMP_CONFIG, which
 	 * holds the part in HiFi1 from here.
@@ -535,9 +682,12 @@ static int es9218p_amp_power_up(struct es9218p_priv *es9218p)
 	if (!ret)
 		/*
 		 * Replay mixer values that landed in the cache while the
-		 * part was idled in Low Power Bypass (volume, mute).
+		 * part was idled in Low Power Bypass (volume, mute, filter,
+		 * harmonic compensation).
 		 */
 		ret = regcache_sync(rm);
+	if (!ret)
+		es9218p->amp_on = true;
 	return ret;
 }
 
@@ -549,6 +699,8 @@ static int es9218p_amp_power_down(struct es9218p_priv *es9218p)
 	if (!es9218p->internal_ldo)
 		r46 |= ES9218P_SEL1V;
 
+	es9218p->amp_on = false;
+
 	/* Shunt the output, drop the amp, then the supplies and pumps. */
 	regmap_write(rm, ES9218P_ANALOG_VOL_CTRL, ES9218P_ATC_MIN);
 	regmap_write(rm, ES9218P_DIGITAL_OVERRIDE, r46);
@@ -719,6 +871,20 @@ static int es9218p_i2c_probe(struct i2c_client *i2c)
 	if (ret)
 		return dev_err_probe(dev, ret, "failed to read system mute\n");
 
+	/*
+	 * LG's defaults: the apodizing filter, the normal headphone tables,
+	 * and -14 dB of analog volume for normal headphones (its
+	 * headphones-hifi-dac mixer path); full scale is uncomfortably loud.
+	 */
+	regmap_update_bits(es9218p->regmap, ES9218P_FILTER_BAND_SYSTEM_MUTE,
+			   GENMASK(7, ES9218P_FILTER_SHAPE_SHIFT),
+			   4 << ES9218P_FILTER_SHAPE_SHIFT);
+	es9218p->hp_type = ES9218P_HP_NORMAL;
+	es9218p->avc_atten = 14;
+	ret = es9218p_apply_hp_type(es9218p);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to set THD compensation\n");
+
 	regmap_write(es9218p->regmap, ES9218P_AMP_CONFIG, 0);
 	gpiod_set_value_cansleep(es9218p->hph_sw_gpio, 1);
 	msleep(100);
diff --git a/sound/soc/qcom/sdm845.c b/sound/soc/qcom/sdm845.c
index 9ed0119a2ca3..8eecc66ba368 100644
--- a/sound/soc/qcom/sdm845.c
+++ b/sound/soc/qcom/sdm845.c
@@ -23,6 +23,8 @@
 #define DEFAULT_MCLK_RATE		24576000
 #define TDM_BCLK_RATE		6144000
 #define MI2S_BCLK_RATE		1536000
+/* 48 kHz, two 32-bit slots: S24_LE to a headphone DAC that takes 24 bits */
+#define MI2S_BCLK_RATE_32	3072000
 #define LEFT_SPK_TDM_TX_MASK    0x30
 #define RIGHT_SPK_TDM_TX_MASK   0xC0
 #define SPK_TDM_RX_MASK         0x03
@@ -41,6 +43,7 @@ struct sdm845_snd_data {
 	uint32_t pri_mi2s_clk_count;
 	uint32_t sec_mi2s_clk_count;
 	uint32_t quat_tdm_clk_count;
+	bool quat_mi2s_24bit;
 	struct sdw_stream_runtime *sruntime[AFE_PORT_MAX];
 };
 
@@ -408,7 +411,8 @@ static int sdm845_snd_startup(struct snd_pcm_substream *substream)
 	case QUATERNARY_MI2S_RX:
 		snd_soc_dai_set_sysclk(cpu_dai,
 			Q6AFE_LPASS_CLK_ID_QUAD_MI2S_IBIT,
-			MI2S_BCLK_RATE, SNDRV_PCM_STREAM_PLAYBACK);
+			data->quat_mi2s_24bit ? MI2S_BCLK_RATE_32 : MI2S_BCLK_RATE,
+			SNDRV_PCM_STREAM_PLAYBACK);
 		snd_soc_dai_set_fmt(cpu_dai, fmt);
 		break;
 
@@ -603,9 +607,22 @@ static int sdm845_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 					SNDRV_PCM_HW_PARAM_CHANNELS);
 	struct snd_mask *fmt = hw_param_mask(params, SNDRV_PCM_HW_PARAM_FORMAT);
 
+	struct sdm845_snd_data *data = snd_soc_card_get_drvdata(rtd->card);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+
 	rate->min = rate->max = DEFAULT_SAMPLE_RATE_48K;
 	channels->min = channels->max = 2;
-	snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S16_LE);
+
+	/*
+	 * Software volume attenuates the mixed stream, so a 16-bit link to a
+	 * DAC loses a bit of resolution per 6 dB turned down. Feed a DAC that
+	 * takes 24 bits (the LG V30's ES9218P on quaternary MI2S) S24_LE.
+	 */
+	if (cpu_dai->id == QUATERNARY_MI2S_RX && data->quat_mi2s_24bit) {
+		snd_mask_none(fmt);
+		snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S24_LE);
+	} else
+		snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S16_LE);
 
 	return 0;
 }
@@ -666,6 +683,8 @@ static int sdm845_snd_platform_probe(struct platform_device *pdev)
 		return ret;
 
 	data->card = card;
+	/* The quaternary MI2S codec takes 24-bit samples (LG V30's ES9218P). */
+	data->quat_mi2s_24bit = of_property_read_bool(dev->of_node, "qcom,quat-mi2s-s24");
 	snd_soc_card_set_drvdata(card, data);
 
 	sdm845_add_ops(card);
