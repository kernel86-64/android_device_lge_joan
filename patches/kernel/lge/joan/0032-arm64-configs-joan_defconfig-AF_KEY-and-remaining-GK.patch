From 6a22f9d8b374c715067584178dd633895420d01b Mon Sep 17 00:00:00 2001
From: scada <scada@noreply.codeberg.org>
Date: Fri, 23 Oct 2026 21:30:57 +0000
Subject: [PATCH 32/80] arm64: configs: joan_defconfig: AF_KEY and remaining
 GKI net options

netd's synchronizeKernelRCU() needs PF_KEY; without it system_server
dies with EAFNOSUPPORT in NetworkStatsService.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0144VMKxYe33NKa3LLPZNivr
---
 arch/arm64/configs/joan_defconfig | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/configs/joan_defconfig b/arch/arm64/configs/joan_defconfig
index f6ee035d65f8..49191a5eb79a 100644
--- a/arch/arm64/configs/joan_defconfig
+++ b/arch/arm64/configs/joan_defconfig
@@ -93,15 +93,20 @@ CONFIG_NET=y
 CONFIG_PACKET=y
 CONFIG_XFRM_USER=y
 CONFIG_XFRM_INTERFACE=y
-CONFIG_XFRM_MIGRATE=y
 CONFIG_XFRM_STATISTICS=y
+CONFIG_NET_KEY=y
+CONFIG_NET_KEY_MIGRATE=y
 CONFIG_IP_MULTICAST=y
 CONFIG_IP_ADVANCED_ROUTER=y
 CONFIG_IP_MULTIPLE_TABLES=y
 CONFIG_IP_PNP=y
 CONFIG_IP_PNP_DHCP=y
 CONFIG_IP_PNP_BOOTP=y
+CONFIG_NET_IPIP=y
+CONFIG_NET_IPGRE_DEMUX=y
+CONFIG_NET_IPGRE=y
 CONFIG_SYN_COOKIES=y
+CONFIG_NET_IPVTI=y
 CONFIG_INET_ESP=y
 CONFIG_INET_UDP_DIAG=y
 CONFIG_INET_DIAG_DESTROY=y
@@ -115,6 +120,7 @@ CONFIG_INET6_IPCOMP=y
 CONFIG_IPV6_MIP6=y
 CONFIG_IPV6_VTI=y
 CONFIG_IPV6_SIT=m
+CONFIG_IPV6_GRE=y
 CONFIG_IPV6_MULTIPLE_TABLES=y
 CONFIG_IPV6_SUBTREES=y
 CONFIG_IPV6_MROUTE=y
@@ -207,7 +213,7 @@ CONFIG_IP6_NF_MANGLE=y
 CONFIG_IP6_NF_RAW=y
 CONFIG_IP6_NF_NAT=y
 CONFIG_L2TP=y
-CONFIG_BRIDGE=m
+CONFIG_BRIDGE=y
 CONFIG_BRIDGE_VLAN_FILTERING=y
 CONFIG_NET_DSA=m
 CONFIG_NET_DSA_TAG_OCELOT=m
@@ -253,6 +259,7 @@ CONFIG_NET_ACT_SKBEDIT=y
 CONFIG_NET_ACT_BPF=y
 CONFIG_NET_ACT_GATE=m
 CONFIG_DNS_RESOLVER=y
+CONFIG_VSOCKETS=y
 CONFIG_HSR=m
 CONFIG_QRTR=y
 CONFIG_QRTR_SMD=y
