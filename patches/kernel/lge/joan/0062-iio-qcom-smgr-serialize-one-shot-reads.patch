From f1868f8acd6ecb4c985fd402ceb4ed80def2d226 Mon Sep 17 00:00:00 2001
From: Lance <Gero3977@gmail.com>
Date: Sun, 25 Oct 2026 11:51:16 -0700
Subject: [PATCH 62/80] iio: qcom-smgr: serialize one-shot reads

Concurrent read_raw(RAW) calls in direct mode race each other's
enable/wait/disable buffering cycles: one reader's disable can kill
another's pending report, leaving both with a stale sample or a timeout.
Observed live when a sysfs monitor ran beside iio-sensor-proxy's poll.
Serialize the one-shot cycle per sensor with a mutex.

Signed-off-by: Lance <Gero3977@gmail.com>
Assisted-by: ZCode:GLM-5.3
(cherry picked from commit dc9c6692dbfba9c114eb116f48be9cf3e283ac0f)
---
 drivers/iio/common/qcom_smgr/qcom_smgr.c | 3 +++
 include/linux/iio/common/qcom_smgr.h     | 2 ++
 2 files changed, 5 insertions(+)

diff --git a/drivers/iio/common/qcom_smgr/qcom_smgr.c b/drivers/iio/common/qcom_smgr/qcom_smgr.c
index 1cc4533af27f..b94c0548ce9e 100644
--- a/drivers/iio/common/qcom_smgr/qcom_smgr.c
+++ b/drivers/iio/common/qcom_smgr/qcom_smgr.c
@@ -392,6 +392,7 @@ static int qcom_smgr_iio_read_raw(struct iio_dev *iio_dev,
 		int ret;
 
 		if (!iio_buffer_enabled(iio_dev)) {
+			mutex_lock(&sensor->oneshot_lock);
 			reinit_completion(&sensor->sample_ready);
 			ret = qcom_smgr_request_buffering(smgr, sensor, true);
 			if (ret)
@@ -399,6 +400,7 @@ static int qcom_smgr_iio_read_raw(struct iio_dev *iio_dev,
 			ret = wait_for_completion_timeout(&sensor->sample_ready,
 				msecs_to_jiffies(250));
 			qcom_smgr_request_buffering(smgr, sensor, false);
+			mutex_unlock(&sensor->oneshot_lock);
 			if (!ret)
 				return -ETIMEDOUT;
 		}
@@ -745,6 +747,7 @@ static int qcom_smgr_register_sensor(struct qcom_smgr *smgr,
 	priv->sensor = sensor;
 
 	init_completion(&sensor->sample_ready);
+	mutex_init(&sensor->oneshot_lock);
 
 	priv->samp_freq_vals[0] = 1;
 	priv->samp_freq_vals[1] = 1;
diff --git a/include/linux/iio/common/qcom_smgr.h b/include/linux/iio/common/qcom_smgr.h
index 4bcb1d39dff3..dba5d4e71460 100644
--- a/include/linux/iio/common/qcom_smgr.h
+++ b/include/linux/iio/common/qcom_smgr.h
@@ -4,6 +4,7 @@
 #define __QCOM_SMGR_H__
 
 #include <linux/completion.h>
+#include <linux/mutex.h>
 #include <linux/iio/iio.h>
 #include <linux/iio/types.h>
 #include <linux/soc/qcom/qmi.h>
@@ -57,6 +58,7 @@ struct qcom_smgr_sensor {
 	/* Latest report sample, for one-shot sysfs reads */
 	u32 last_sample_values[3];
 	struct completion sample_ready;
+	struct mutex oneshot_lock;
 };
 
 struct qcom_smgr_iio_priv {
