From d7a8b8c35b6ddfd254f87a3e4c34c1f86a0fae82 Mon Sep 17 00:00:00 2001
From: kernel86-64 <87580651+kernel86-64@users.noreply.github.com>
Date: Sat, 21 Nov 2026 00:07:09 +0300
Subject: [PATCH] drm/msm/a5xx: drop the unused local in pm_resume

The GPU DDR vote moved into the OPP table, so a5xx_pm_resume() no longer
uses a5xx_gpu. Fixes the -Wunused-variable warning.
---
 drivers/gpu/drm/msm/adreno/a5xx_gpu.c | 1 -
 1 file changed, 1 deletion(-)

diff --git a/drivers/gpu/drm/msm/adreno/a5xx_gpu.c b/drivers/gpu/drm/msm/adreno/a5xx_gpu.c
index ed26f2680..346d162a7 100644
--- a/drivers/gpu/drm/msm/adreno/a5xx_gpu.c
+++ b/drivers/gpu/drm/msm/adreno/a5xx_gpu.c
@@ -1424,7 +1424,6 @@ static void a5xx_dump(struct msm_gpu *gpu)
 static int a5xx_pm_resume(struct msm_gpu *gpu)
 {
 	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
-	struct a5xx_gpu *a5xx_gpu = to_a5xx_gpu(adreno_gpu);
 	int ret;
 
 	/* Turn on the core power */
-- 
2.56.1

