 	.driver = {
 		.name = "vl53l0x-i2c",
 		.of_match_table = st_vl53l0x_dt_match,
+		.pm = pm_ptr(&vl53l0x_pm_ops),
 	},
 	.probe = vl53l0x_probe,
 	.id_table = vl53l0x_id,
