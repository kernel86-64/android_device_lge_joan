+void ipa_cmd_hdr_init_system_add(struct gsi_trans *trans, dma_addr_t addr)
+{
+	struct ipa *ipa = container_of(trans->gsi, struct ipa, gsi);
+	enum ipa_cmd_opcode opcode = IPA_CMD_HDR_INIT_SYSTEM;
