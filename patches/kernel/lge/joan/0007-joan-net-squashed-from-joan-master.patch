 		if (qcadev->bdaddr_property_broken)
 			hci_set_quirk(hdev, HCI_QUIRK_BDADDR_PROPERTY_BROKEN);
 
+		if (soc_type == QCA_WCN3990) {
+			/*
+			 * WCN3990 answers HCI_OP_LE_READ_TRANSMIT_POWER with a
