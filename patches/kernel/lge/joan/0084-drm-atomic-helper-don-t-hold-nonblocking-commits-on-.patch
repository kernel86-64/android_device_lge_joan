From 312daffb013b148b0e8ab8621fd07941fb0c6190 Mon Sep 17 00:00:00 2001
From: Lance <Gero3977@gmail.com>
Date: Wed, 4 Nov 2026 01:04:47 -0800
Subject: [PATCH 04/22] drm/atomic-helper: don't hold nonblocking commits on a
 fake commit

A plane or connector with no CRTC is tracked through the state's fake
commit. Nothing ever flips on it, but its flip_done is only completed
from hw_done, or from wait_for_flip_done() since 2de42f79bb21
("drm/atomic-helper: Complete fake_commit->flip_done potentially
earlier"). That commit narrowed a spurious -EBUSY for i915 and said the
race still exists when the real flip_done completes well before the
wait. A driver that signals the page-flip event ahead of hw_done, and
does not use wait_for_flip_done(), never gets even that:

  [drm:drm_atomic_helper_setup_commit] [PLANE:76:plane-6] busy with a
  previous commit

msm is such a driver: its commit tail calls hw_done last, after waiting
for the flush, so on a command-mode panel userspace is woken while the
fake commit still looks in flight. wlroots lists the disabled cursor
plane in every commit, so on the LG V30 phoc saw about one EBUSY per
displayed frame while scrolling (5169 failures against 5576 panel
frames in a two-minute run), retried about 4 ms later, and stalled for
up to about 66 ms between frames. The CRTC and the primary plane passed
their checks every time; only the plane with no CRTC was refused. With
this change the same test logs no failures.

Complete flip_done as soon as the fake commit is created, which closes
the race for every driver instead of narrowing it. hw_done is untouched
and drm_crtc_commit_wait() waits for it first, so commits stay ordered
in the commit tail. Most drivers already call hw_done before they wait
for the flip, so for them this moves the completion very little. The
later completions become redundant and go away.

Fixes: 080de2e5be2d ("drm/atomic: Check for busy planes/connectors before setting the commit")
Signed-off-by: Lance <Gero3977@gmail.com>
Assisted-by: Claude-Code:claude-opus-5-5
---
 drivers/gpu/drm/drm_atomic_helper.c | 14 ++++++++------
 include/drm/drm_atomic.h            |  5 +++--
 2 files changed, 11 insertions(+), 8 deletions(-)

diff --git a/drivers/gpu/drm/drm_atomic_helper.c b/drivers/gpu/drm/drm_atomic_helper.c
index 398014433..e27943580 100644
--- a/drivers/gpu/drm/drm_atomic_helper.c
+++ b/drivers/gpu/drm/drm_atomic_helper.c
@@ -1958,9 +1958,6 @@ void drm_atomic_helper_wait_for_flip_done(struct drm_device *dev,
 			drm_err(dev, "[CRTC:%d:%s] flip_done timed out\n",
 				crtc->base.id, crtc->name);
 	}
-
-	if (state->fake_commit)
-		complete_all(&state->fake_commit->flip_done);
 }
 EXPORT_SYMBOL(drm_atomic_helper_wait_for_flip_done);
 
@@ -2455,6 +2452,13 @@ crtc_or_fake_commit(struct drm_atomic_state *state, struct drm_crtc *crtc)
 			return NULL;
 
 		init_commit(state->fake_commit, NULL);
+
+		/*
+		 * Nothing will ever flip without a CRTC, so nonblocking commits
+		 * must not be held back by this one. Ordering is still enforced
+		 * through hw_done in drm_crtc_commit_wait().
+		 */
+		complete_all(&state->fake_commit->flip_done);
 	}
 
 	return state->fake_commit;
@@ -2751,10 +2755,8 @@ void drm_atomic_helper_commit_hw_done(struct drm_atomic_state *state)
 		complete_all(&commit->hw_done);
 	}
 
-	if (state->fake_commit) {
+	if (state->fake_commit)
 		complete_all(&state->fake_commit->hw_done);
-		complete_all(&state->fake_commit->flip_done);
-	}
 }
 EXPORT_SYMBOL(drm_atomic_helper_commit_hw_done);
 
diff --git a/include/drm/drm_atomic.h b/include/drm/drm_atomic.h
index 7e6c57b4b..f6d1ffd30 100644
--- a/include/drm/drm_atomic.h
+++ b/include/drm/drm_atomic.h
@@ -552,8 +552,9 @@ struct drm_atomic_state {
 	 * When a connector or plane is not bound to any CRTC, it's still important
 	 * to preserve linearity to prevent the atomic states from being freed too early.
 	 *
-	 * This commit (if set) is not bound to any CRTC, but will be completed when
-	 * drm_atomic_helper_commit_hw_done() is called.
+	 * This commit (if set) is not bound to any CRTC. Nothing can flip without
+	 * one, so its flip_done is completed on creation; the rest is completed
+	 * when drm_atomic_helper_commit_hw_done() is called.
 	 */
 	struct drm_crtc_commit *fake_commit;
 
-- 
