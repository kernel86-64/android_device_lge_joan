From 5e0f44f29e554bbfcc151e04ee984ba9381aa268 Mon Sep 17 00:00:00 2001
From: scada <scada@noreply.codeberg.org>
Date: Thu, 29 Oct 2026 09:39:40 +0400
Subject: [PATCH 69/78] iio: qcom-smgr: describe the timestamp channel as
 64-bit

The timestamp channels declared 32 real bits in 64-bit storage, so
consumers that honour the scan type truncate the nanosecond timestamp
and see it wrap every 4.3 s. Describe it like IIO_CHAN_SOFT_TIMESTAMP:
signed, 64 of 64 bits.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0144VMKxYe33NKa3LLPZNivr
---
 drivers/iio/common/qcom_smgr/qcom_smgr.c | 20 ++++++++++----------
 1 file changed, 10 insertions(+), 10 deletions(-)

diff --git a/drivers/iio/common/qcom_smgr/qcom_smgr.c b/drivers/iio/common/qcom_smgr/qcom_smgr.c
index b34a095d8478..8604a253df45 100644
--- a/drivers/iio/common/qcom_smgr/qcom_smgr.c
+++ b/drivers/iio/common/qcom_smgr/qcom_smgr.c
@@ -521,8 +521,8 @@ static const struct iio_chan_spec qcom_smgr_accel_iio_channels[] = {
 		.channel = -1,
 		.scan_index = 3,
 		.scan_type = {
-			.sign = 'u',
-			.realbits = 32,
+			.sign = 's',
+			.realbits = 64,
 			.storagebits = 64,
 			.endianness = IIO_LE,
 		},
@@ -583,8 +583,8 @@ static const struct iio_chan_spec qcom_smgr_gyro_iio_channels[] = {
 		.channel = -1,
 		.scan_index = 3,
 		.scan_type = {
-			.sign = 'u',
-			.realbits = 32,
+			.sign = 's',
+			.realbits = 64,
 			.storagebits = 64,
 			.endianness = IIO_LE,
 		},
@@ -645,8 +645,8 @@ static const struct iio_chan_spec qcom_smgr_mag_iio_channels[] = {
 		.channel = -1,
 		.scan_index = 3,
 		.scan_type = {
-			.sign = 'u',
-			.realbits = 32,
+			.sign = 's',
+			.realbits = 64,
 			.storagebits = 64,
 			.endianness = IIO_LE,
 		},
@@ -672,8 +672,8 @@ static const struct iio_chan_spec qcom_smgr_prox_iio_channels[] = {
 		.channel = -1,
 		.scan_index = 3,
 		.scan_type = {
-			.sign = 'u',
-			.realbits = 32,
+			.sign = 's',
+			.realbits = 64,
 			.storagebits = 64,
 			.endianness = IIO_LE,
 		},
@@ -699,8 +699,8 @@ static const struct iio_chan_spec qcom_smgr_pressure_iio_channels[] = {
 		.channel = -1,
 		.scan_index = 3,
 		.scan_type = {
-			.sign = 'u',
-			.realbits = 32,
+			.sign = 's',
+			.realbits = 64,
 			.storagebits = 64,
 			.endianness = IIO_LE,
 		},
