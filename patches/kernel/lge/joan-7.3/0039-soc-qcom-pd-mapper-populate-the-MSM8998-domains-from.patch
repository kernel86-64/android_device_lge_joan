From 480f1c93f1ef0885a9431adbdd413385e54e9484 Mon Sep 17 00:00:00 2001
From: kernel86-64 <87580651+kernel86-64@users.noreply.github.com>
Date: Sun, 22 Nov 2026 20:37:43 +0300
Subject: [PATCH 39/57] soc: qcom: pd-mapper: populate the MSM8998 domains from
 the firmware .jsn

The in-kernel locator listed avs/audio and the modem WLAN loader
services, but not tms/servreg on any domain and not tms/pdr_enabled on
modem/root_pd.  Without tms/servreg a protection domain never finishes
registering: the ADSP WLAN firmware loader stalls ath10k (no wlan0) and
the modem waits in init until its 40 s DOG fires (fatal error without
message).

The firmware ships the authoritative lists in
adspr/adspua/modemr/modemuw/slpir/slpius .jsn files; copy those service
lists verbatim.
---
 drivers/soc/qcom/qcom_pd_mapper.c | 19 ++++++++++++++++---
 1 file changed, 16 insertions(+), 3 deletions(-)

diff --git a/drivers/soc/qcom/qcom_pd_mapper.c b/drivers/soc/qcom/qcom_pd_mapper.c
index 99cfc5221..67cccd34a 100644
--- a/drivers/soc/qcom/qcom_pd_mapper.c
+++ b/drivers/soc/qcom/qcom_pd_mapper.c
@@ -255,6 +255,7 @@ static const struct qcom_pdm_domain_data adsp_audio_pd = {
 	.instance_id = 74,
 	.services = {
 		"avs/audio",
+		"tms/servreg",
 		NULL,
 	},
 };
@@ -274,7 +275,10 @@ static const struct qcom_pdm_domain_data adsp_ois_pd = {
 static const struct qcom_pdm_domain_data adsp_root_pd = {
 	.domain = "msm/adsp/root_pd",
 	.instance_id = 74,
-	.services = { NULL },
+	.services = {
+		"tms/servreg",
+		NULL,
+	},
 };
 
 static const struct qcom_pdm_domain_data adsp_root_pd_pdr = {
@@ -331,19 +335,27 @@ static const struct qcom_pdm_domain_data gpdsp1_root_pd = {
 static const struct qcom_pdm_domain_data slpi_root_pd = {
 	.domain = "msm/slpi/root_pd",
 	.instance_id = 90,
-	.services = { NULL },
+	.services = {
+		"tms/servreg",
+		NULL,
+	},
 };
 
 static const struct qcom_pdm_domain_data slpi_sensor_pd = {
 	.domain = "msm/slpi/sensor_pd",
 	.instance_id = 90,
-	.services = { NULL },
+	.services = {
+		"tms/servreg",
+		NULL,
+	},
 };
 
 static const struct qcom_pdm_domain_data mpss_root_pd = {
 	.domain = "msm/modem/root_pd",
 	.instance_id = 180,
 	.services = {
+		"tms/servreg",
+		"tms/pdr_enabled",
 		NULL,
 	},
 };
@@ -378,6 +390,7 @@ static const struct qcom_pdm_domain_data mpss_wlan_pd = {
 	.instance_id = 180,
 	.services = {
 		"kernel/elf_loader",
+		"tms/servreg",
 		"wlan/fw",
 		NULL,
 	},
