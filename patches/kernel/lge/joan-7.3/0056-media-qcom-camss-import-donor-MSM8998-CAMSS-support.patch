-csiphy_match_clock_name(const char *clock_name, const char *format, ...)
-{
-	char name[16]; /* csiphyXXX_timer\0 */
-	va_list args;
-
-	va_start(args, format);
-	vsnprintf(name, sizeof(name), format, args);
-	va_end(args);
-
-	return !strcmp(clock_name, name);
-}
-
 /*
  * msm_csiphy_subdev_init - Initialize CSIPHY device structure and resources
  * @csiphy: CSIPHY device
@@ -694,6 +703,19 @@ int msm_csiphy_subdev_init(struct camss *camss,
 				continue;
 		}
 
+		/*
+		 * The MSM8998 PHYs also drive their CSI core clock, which
+		 * otherwise only gets a rate when the CSID with the same index
+		 * is in use (downstream rates csiN_clk_src from the CSIPHY).
+		 */
+		if (camss->res->version == CAMSS_8998) {
+			csiphy->rate_set[i] = csiphy_match_clock_name(clock->name,
+								      "csi%d",
+								      csiphy->id);
+			if (csiphy->rate_set[i])
+				continue;
+		}
+
 		csiphy->rate_set[i] = csiphy_match_clock_name(clock->name, "csiphy%d", csiphy->id);
 	}
 
diff --git a/drivers/media/platform/qcom/camss/camss-ispif.c b/drivers/media/platform/qcom/camss/camss-ispif.c
index 20ccd7b1f..eb9c667fa 100644
--- a/drivers/media/platform/qcom/camss/camss-ispif.c
+++ b/drivers/media/platform/qcom/camss/camss-ispif.c
@@ -341,6 +341,41 @@ static int ispif_reset(struct ispif_device *ispif, u8 vfe_id)
 	if (ret)
 		dev_dbg(camss->dev, "ISPIF Reset failed\n");
 
+	/*
+	 * The msm8998 block reset does not clear the interface state, so the
+	 * IRQ masks, input selects and CID masks a previous session programmed
+	 * survive it. Starting a second session then arms the old routing
+	 * alongside the new one. Downstream's msm_ispif_reset() writes the
+	 * whole interface state out by hand; do the same. Per VFE: line-buf
+	 * enable only, masks off, everything pending cleared, interfaces
+	 * stopped immediately, no inputs and no CIDs.
+	 */
+	if (camss->res->version == CAMSS_8998) {
+		unsigned int m;
+
+		for (m = 0; m < camss->res->vfe_num; m++) {
+			writel_relaxed(ISPIF_VFE_m_CTRL_0_PIX0_LINE_BUF_EN,
+				       ispif->base + ISPIF_VFE_m_CTRL_0(m));
+			writel_relaxed(0, ispif->base + ISPIF_VFE_m_IRQ_MASK_0(m));
+			writel_relaxed(0, ispif->base + ISPIF_VFE_m_IRQ_MASK_1(m));
+			writel_relaxed(0, ispif->base + ISPIF_VFE_m_IRQ_MASK_2(m));
+			writel_relaxed(0xffffffff, ispif->base + ISPIF_VFE_m_IRQ_CLEAR_0(m));
+			writel_relaxed(0xffffffff, ispif->base + ISPIF_VFE_m_IRQ_CLEAR_1(m));
+			writel_relaxed(0xffffffff, ispif->base + ISPIF_VFE_m_IRQ_CLEAR_2(m));
+			writel_relaxed(0, ispif->base + ISPIF_VFE_m_INTF_INPUT_SEL(m));
+			writel_relaxed(CMD_ALL_DISABLE_IMMEDIATELY,
+				       ispif->base + ISPIF_VFE_m_INTF_CMD_0(m));
+			writel_relaxed(CMD_ALL_DISABLE_IMMEDIATELY,
+				       ispif->base + ISPIF_VFE_m_INTF_CMD_1(m));
+			writel_relaxed(0, ispif->base + ISPIF_VFE_m_PIX_INTF_n_CID_MASK(m, 0));
+			writel_relaxed(0, ispif->base + ISPIF_VFE_m_PIX_INTF_n_CID_MASK(m, 1));
+			writel_relaxed(0, ispif->base + ISPIF_VFE_m_RDI_INTF_n_CID_MASK(m, 0));
+			writel_relaxed(0, ispif->base + ISPIF_VFE_m_RDI_INTF_n_CID_MASK(m, 1));
+			writel_relaxed(0, ispif->base + ISPIF_VFE_m_RDI_INTF_n_CID_MASK(m, 2));
+		}
+		writel(0x1, ispif->base + ISPIF_IRQ_GLOBAL_CLEAR_CMD);
+	}
+
 	camss_disable_clocks(ispif->nclocks_for_reset, ispif->clock_for_reset);
 
 	camss_pm_domain_off(camss, PM_DOMAIN_VFE0);
@@ -831,7 +866,8 @@ static int ispif_set_stream(struct v4l2_subdev *sd, int enable)
 		ispif_config_irq(ispif, intf, vfe, 1);
 		if (camss->res->version == CAMSS_8x96 ||
 		    camss->res->version == CAMSS_8x53 ||
-		    camss->res->version == CAMSS_660)
+		    camss->res->version == CAMSS_660 ||
+		    camss->res->version == CAMSS_8998)
 			ispif_config_pack(ispif,
 					  line->fmt[MSM_ISPIF_PAD_SINK].code,
 					  intf, cid, vfe, 1);
@@ -850,7 +886,8 @@ static int ispif_set_stream(struct v4l2_subdev *sd, int enable)
 		mutex_lock(&ispif->config_lock);
 		if (camss->res->version == CAMSS_8x96 ||
 		    camss->res->version == CAMSS_8x53 ||
-		    camss->res->version == CAMSS_660)
+		    camss->res->version == CAMSS_660 ||
+		    camss->res->version == CAMSS_8998)
 			ispif_config_pack(ispif,
 					  line->fmt[MSM_ISPIF_PAD_SINK].code,
 					  intf, cid, vfe, 0);
@@ -1116,7 +1153,8 @@ int msm_ispif_subdev_init(struct camss *camss,
 		ispif->line_num = 3;
 	else if (camss->res->version == CAMSS_8x96 ||
 		 camss->res->version == CAMSS_8x53 ||
-		 camss->res->version == CAMSS_660)
+		 camss->res->version == CAMSS_660 ||
+		 camss->res->version == CAMSS_8998)
 		ispif->line_num = 4;
 	else
 		return -EINVAL;
@@ -1137,7 +1175,8 @@ int msm_ispif_subdev_init(struct camss *camss,
 					ARRAY_SIZE(ispif_formats_8x16);
 		} else if (camss->res->version == CAMSS_8x96 ||
 			   camss->res->version == CAMSS_8x53 ||
-			   camss->res->version == CAMSS_660) {
+			   camss->res->version == CAMSS_660 ||
+			   camss->res->version == CAMSS_8998) {
 			ispif->line[i].formats = ispif_formats_8x96;
 			ispif->line[i].nformats =
 					ARRAY_SIZE(ispif_formats_8x96);
@@ -1171,7 +1210,8 @@ int msm_ispif_subdev_init(struct camss *camss,
 			       IRQF_TRIGGER_RISING, ispif->irq_name, ispif);
 	else if (camss->res->version == CAMSS_8x96 ||
 		 camss->res->version == CAMSS_8x53 ||
-		 camss->res->version == CAMSS_660)
+		 camss->res->version == CAMSS_660 ||
+		 camss->res->version == CAMSS_8998)
 		ret = devm_request_irq(dev, ispif->irq, ispif_isr_8x96,
 			       IRQF_TRIGGER_RISING, ispif->irq_name, ispif);
 	else
diff --git a/drivers/media/platform/qcom/camss/camss-vfe-4-8.c b/drivers/media/platform/qcom/camss/camss-vfe-4-8.c
index b2f7d855d..1968e8fd4 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe-4-8.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe-4-8.c
@@ -9,6 +9,7 @@
  */
 
 #include <linux/device.h>
+#include <linux/dma-mapping.h>
 #include <linux/interrupt.h>
 #include <linux/io.h>
 #include <linux/iopoll.h>
@@ -29,6 +30,9 @@
 #define VFE_0_GLOBAL_RESET_CMD_DSP	BIT(8)
 #define VFE_0_GLOBAL_RESET_CMD_IDLE_CGC	BIT(9)
 
+#define VFE_0_CGC_OVERRIDE_1		0x03c
+#define VFE_0_CGC_OVERRIDE_1_IMAGE_Mx_CGC_OVERRIDE(x)	BIT(x)
+
 #define VFE_0_MODULE_LENS_EN		0x040
 #define VFE_0_MODULE_LENS_EN_DEMUX		BIT(2)
 #define VFE_0_MODULE_LENS_EN_CHROMA_UPSAMPLE	BIT(3)
@@ -104,6 +108,17 @@
 #define VFE_0_BUS_IMAGE_MASTER_n_WR_CFG_WR_PATH_SHIFT	0
 #define VFE_0_BUS_IMAGE_MASTER_n_WR_PING_ADDR(n)	(0x0a4 + 0x2c * (n))
 #define VFE_0_BUS_IMAGE_MASTER_n_WR_PONG_ADDR(n)	(0x0ac + 0x2c * (n))
+/*
+ * VFE 4.7/4.8 added a per-buffer address limit beside each address register --
+ * that is why the write-master stride grew from 0x24 (4.0/4.4/4.6) to 0x2c.
+ * Downstream writes both, the limit as (addr + buf_size) & 0xffffffe0. The
+ * 4.7/4.8 ports bumped the stride but kept the 4.1 register list, so these two
+ * are never written and read zero -- and a write master whose address limit is
+ * zero cannot emit a single beat: it takes data in, fills its unified-buffer
+ * slice, raises BUS_OVERFLOW and never completes a burst.
+ */
+#define VFE_0_BUS_IMAGE_MASTER_n_WR_PING_ADDR_LIMIT(n)	(0x0a8 + 0x2c * (n))
+#define VFE_0_BUS_IMAGE_MASTER_n_WR_PONG_ADDR_LIMIT(n)	(0x0b0 + 0x2c * (n))
 #define VFE_0_BUS_IMAGE_MASTER_n_WR_ADDR_CFG(n)		(0x0b4 + 0x2c * (n))
 #define VFE_0_BUS_IMAGE_MASTER_n_WR_ADDR_CFG_FRM_BASED_SHIFT	1
 #define VFE_0_BUS_IMAGE_MASTER_n_WR_ADDR_CFG_FRM_DROP_PER_SHIFT	2
@@ -259,6 +274,14 @@ static inline void vfe_reg_set(struct vfe_device *vfe, u32 reg, u32 set_bits)
 	writel_relaxed(bits | set_bits, vfe->base + reg);
 }
 
+/*
+ * VFE 4.8 does not reset the AXI bus bridge along with the rest of the core:
+ * the vendor driver picks 0x3f7 here where 4.7 uses 0x3ff, the one bit of
+ * difference being BUS_BDG. A bridge reset issued while its clocks and the
+ * VBIF are up comes back refusing grants, so the write masters latch their
+ * configuration and take pixel data but never issue a beat and never
+ * acknowledge a halt.
+ */
 static void vfe_global_reset(struct vfe_device *vfe)
 {
 	u32 reset_bits = VFE_0_GLOBAL_RESET_CMD_IDLE_CGC	|
@@ -267,7 +290,6 @@ static void vfe_global_reset(struct vfe_device *vfe)
 			 VFE_0_GLOBAL_RESET_CMD_BUS_MISR	|
 			 VFE_0_GLOBAL_RESET_CMD_PM		|
 			 VFE_0_GLOBAL_RESET_CMD_REGISTER	|
-			 VFE_0_GLOBAL_RESET_CMD_BUS_BDG		|
 			 VFE_0_GLOBAL_RESET_CMD_BUS		|
 			 VFE_0_GLOBAL_RESET_CMD_CAMIF		|
 			 VFE_0_GLOBAL_RESET_CMD_CORE;
@@ -437,12 +459,16 @@ static void vfe_wm_set_ping_addr(struct vfe_device *vfe, u8 wm, u32 addr)
 {
 	writel_relaxed(addr,
 		       vfe->base + VFE_0_BUS_IMAGE_MASTER_n_WR_PING_ADDR(wm));
+	writel_relaxed(addr ? (addr + vfe->sizeimage) & 0xffffffe0 : 0,
+		       vfe->base + VFE_0_BUS_IMAGE_MASTER_n_WR_PING_ADDR_LIMIT(wm));
 }
 
 static void vfe_wm_set_pong_addr(struct vfe_device *vfe, u8 wm, u32 addr)
 {
 	writel_relaxed(addr,
 		       vfe->base + VFE_0_BUS_IMAGE_MASTER_n_WR_PONG_ADDR(wm));
+	writel_relaxed(addr ? (addr + vfe->sizeimage) & 0xffffffe0 : 0,
+		       vfe->base + VFE_0_BUS_IMAGE_MASTER_n_WR_PONG_ADDR_LIMIT(wm));
 }
 
 static int vfe_wm_get_ping_pong_status(struct vfe_device *vfe, u8 wm)
@@ -854,7 +880,15 @@ static void vfe_set_clamp_cfg(struct vfe_device *vfe)
 
 static void vfe_set_cgc_override(struct vfe_device *vfe, u8 wm, u8 enable)
 {
-	/* empty */
+	u32 val = VFE_0_CGC_OVERRIDE_1_IMAGE_Mx_CGC_OVERRIDE(wm);
+
+	if (enable)
