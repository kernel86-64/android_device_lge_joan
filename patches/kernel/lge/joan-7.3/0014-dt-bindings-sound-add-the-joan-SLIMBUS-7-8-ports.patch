From 1f00e63e3a5107303caa8070b9b978a95600f051 Mon Sep 17 00:00:00 2001
From: kernel86-64 <87580651+kernel86-64@users.noreply.github.com>
Date: Sun, 22 Nov 2026 14:09:18 +0300
Subject: [PATCH 14/59] dt-bindings: sound: add the joan SLIMBUS 7/8 ports

The joan audio graph uses SLIMBUS_7_RX/TX and SLIMBUS_8_TX. The 7.3 upstream header only defines SLIMBUS_0..6; add the three port IDs (153/154/155) carried by the joan sound support.
---
 include/dt-bindings/sound/qcom,q6dsp-lpass-ports.h | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/include/dt-bindings/sound/qcom,q6dsp-lpass-ports.h b/include/dt-bindings/sound/qcom,q6dsp-lpass-ports.h
index 3a99703db..796b447cc 100644
--- a/include/dt-bindings/sound/qcom,q6dsp-lpass-ports.h
+++ b/include/dt-bindings/sound/qcom,q6dsp-lpass-ports.h
@@ -18,6 +18,9 @@
 #define SLIMBUS_5_TX    13
 #define SLIMBUS_6_RX    14
 #define SLIMBUS_6_TX    15
+#define SLIMBUS_7_RX    153
+#define SLIMBUS_7_TX    154
+#define SLIMBUS_8_TX    155
 #define PRIMARY_MI2S_RX		16
 #define PRIMARY_MI2S_TX		17
 #define SECONDARY_MI2S_RX	18
