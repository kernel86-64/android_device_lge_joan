From 3789efde680fbe5ccac2d55147245e05e224c189 Mon Sep 17 00:00:00 2001
From: kernel86-64 <87580651+kernel86-64@users.noreply.github.com>
Date: Tue, 24 Nov 2026 00:25:30 +0300
Subject: [PATCH 51/59] arm64: dts: qcom: msm8998: drop sleep_1 CPU idle states

Remove little_cpu_sleep_1 and big_cpu_sleep_1 from CPU idle states,
matching the working 6.18 tree.
---
 arch/arm64/boot/dts/qcom/msm8998.dtsi | 16 ++++++++--------
 1 file changed, 8 insertions(+), 8 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/msm8998.dtsi b/arch/arm64/boot/dts/qcom/msm8998.dtsi
index f5ade4813..fbf57b7e9 100644
--- a/arch/arm64/boot/dts/qcom/msm8998.dtsi
+++ b/arch/arm64/boot/dts/qcom/msm8998.dtsi
@@ -1082,7 +1082,7 @@ cpu0: cpu@0 {
 			interconnects = <&gnoc MAS_APSS_PROC &bimc SLV_EBI>;
 			#cooling-cells = <2>;
 			capacity-dmips-mhz = <1024>;
-			cpu-idle-states = <&little_cpu_sleep_0 &little_cpu_sleep_1>;
+			cpu-idle-states = <&little_cpu_sleep_0>;
 			next-level-cache = <&l2_0>;
 			l2_0: l2-cache {
 				compatible = "cache";
@@ -1103,7 +1103,7 @@ cpu1: cpu@1 {
 			interconnects = <&gnoc MAS_APSS_PROC &bimc SLV_EBI>;
 			#cooling-cells = <2>;
 			capacity-dmips-mhz = <1024>;
-			cpu-idle-states = <&little_cpu_sleep_0 &little_cpu_sleep_1>;
+			cpu-idle-states = <&little_cpu_sleep_0>;
 			next-level-cache = <&l2_0>;
 		};
 
@@ -1119,7 +1119,7 @@ cpu2: cpu@2 {
 			interconnects = <&gnoc MAS_APSS_PROC &bimc SLV_EBI>;
 			#cooling-cells = <2>;
 			capacity-dmips-mhz = <1024>;
-			cpu-idle-states = <&little_cpu_sleep_0 &little_cpu_sleep_1>;
+			cpu-idle-states = <&little_cpu_sleep_0>;
 			next-level-cache = <&l2_0>;
 		};
 
@@ -1135,7 +1135,7 @@ cpu3: cpu@3 {
 			interconnects = <&gnoc MAS_APSS_PROC &bimc SLV_EBI>;
 			#cooling-cells = <2>;
 			capacity-dmips-mhz = <1024>;
-			cpu-idle-states = <&little_cpu_sleep_0 &little_cpu_sleep_1>;
+			cpu-idle-states = <&little_cpu_sleep_0>;
 			next-level-cache = <&l2_0>;
 		};
 
@@ -1151,7 +1151,7 @@ cpu4: cpu@100 {
 			interconnects = <&gnoc MAS_APSS_PROC &bimc SLV_EBI>;
 			#cooling-cells = <2>;
 			capacity-dmips-mhz = <1536>;
-			cpu-idle-states = <&big_cpu_sleep_0 &big_cpu_sleep_1>;
+			cpu-idle-states = <&big_cpu_sleep_0>;
 			next-level-cache = <&l2_1>;
 			l2_1: l2-cache {
 				compatible = "cache";
@@ -1172,7 +1172,7 @@ cpu5: cpu@101 {
 			interconnects = <&gnoc MAS_APSS_PROC &bimc SLV_EBI>;
 			#cooling-cells = <2>;
 			capacity-dmips-mhz = <1536>;
-			cpu-idle-states = <&big_cpu_sleep_0 &big_cpu_sleep_1>;
+			cpu-idle-states = <&big_cpu_sleep_0>;
 			next-level-cache = <&l2_1>;
 		};
 
@@ -1188,7 +1188,7 @@ cpu6: cpu@102 {
 			interconnects = <&gnoc MAS_APSS_PROC &bimc SLV_EBI>;
 			#cooling-cells = <2>;
 			capacity-dmips-mhz = <1536>;
-			cpu-idle-states = <&big_cpu_sleep_0 &big_cpu_sleep_1>;
+			cpu-idle-states = <&big_cpu_sleep_0>;
 			next-level-cache = <&l2_1>;
 		};
 
@@ -1204,7 +1204,7 @@ cpu7: cpu@103 {
 			interconnects = <&gnoc MAS_APSS_PROC &bimc SLV_EBI>;
 			#cooling-cells = <2>;
 			capacity-dmips-mhz = <1536>;
-			cpu-idle-states = <&big_cpu_sleep_0 &big_cpu_sleep_1>;
+			cpu-idle-states = <&big_cpu_sleep_0>;
 			next-level-cache = <&l2_1>;
 		};
 
