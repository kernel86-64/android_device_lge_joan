+		.pixel_rate = 175971840,
+		.link_freq = HI553_LINK_FREQ_440MHZ,
+		.regs = hi553_mode_2560x1920,
+		.num_regs = ARRAY_SIZE(hi553_mode_2560x1920),
+	},
+	{
+		.width = 2560,
+		.height = 1440,
+		.crop = { .left = 0, .top = 0, .width = 2560, .height = 1920 },
+		.line_length = 2816,
+		.frame_length = 2083,
+		.pixel_rate = 175971840,
+		.link_freq = HI553_LINK_FREQ_440MHZ,
+		.regs = hi553_mode_2560x1440,
+		.num_regs = ARRAY_SIZE(hi553_mode_2560x1440),
+	},
+	{
+		.width = 1280,
+		.height = 720,
+		.crop = { .left = 0, .top = 0, .width = 2560, .height = 1920 },
+		.line_length = 2816,
+		.frame_length = 2083,
+		.pixel_rate = 175971840,
+		.link_freq = HI553_LINK_FREQ_220MHZ,
+		.regs = hi553_mode_1280x720,
+		.num_regs = ARRAY_SIZE(hi553_mode_1280x720),
+	},
+};
+
+static bool hi553_mode_usable(struct hi553 *hi553,
+			      const struct hi553_mode *mode)
+{
+	return hi553->link_freq_bitmap & BIT(mode->link_freq);
+}
+
+static u32 hi553_mbus_code(struct hi553 *hi553)
+{
+	return hi553_mbus_codes[0];
+}
+
+static const struct hi553_mode *
+hi553_find_mode(struct hi553 *hi553, u32 width, u32 height)
+{
+	const struct hi553_mode *best = NULL;
+	unsigned int i;
+	u32 dist, best_dist = U32_MAX;
+
+	for (i = 0; i < ARRAY_SIZE(hi553_modes); i++) {
+		const struct hi553_mode *mode = &hi553_modes[i];
+
+		if (!hi553_mode_usable(hi553, mode))
+			continue;
+
+		dist = abs((int)mode->width - (int)width) +
+		       abs((int)mode->height - (int)height);
+		if (dist < best_dist) {
+			best_dist = dist;
+			best = mode;
+		}
+	}
+
+	return best;
+}
+
+static const struct hi553_mode *
+hi553_state_mode(struct hi553 *hi553, struct v4l2_subdev_state *state)
+{
+	const struct v4l2_mbus_framefmt *fmt =
+		v4l2_subdev_state_get_format(state, 0);
+
+	return hi553_find_mode(hi553, fmt->width, fmt->height);
+}
+
+static void hi553_update_limits(struct hi553 *hi553,
+				const struct hi553_mode *mode)
+{
+	u32 vblank_def = mode->frame_length - mode->height;
+	u32 hblank = mode->line_length - mode->width;
+
+	__v4l2_ctrl_s_ctrl_int64(hi553->pixel_rate, mode->pixel_rate);
+	__v4l2_ctrl_s_ctrl(hi553->link_freq, mode->link_freq);
+
+	/* Never run a mode faster than LG does */
+	__v4l2_ctrl_modify_range(hi553->vblank, vblank_def,
+				 HI553_FRAME_LENGTH_MAX - mode->height,
+				 1, vblank_def);
+	__v4l2_ctrl_s_ctrl(hi553->vblank, vblank_def);
+
+	__v4l2_ctrl_modify_range(hi553->hblank, hblank, hblank, 1, hblank);
+
+	__v4l2_ctrl_modify_range(hi553->exposure, HI553_EXPOSURE_MIN,
+				 mode->frame_length - HI553_EXPOSURE_OFFSET,
+				 1, HI553_EXPOSURE_DEFAULT);
+}
+
+static int hi553_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct hi553 *hi553 = container_of(ctrl->handler, struct hi553,
+					   ctrls);
+	struct v4l2_subdev_state *state =
+		v4l2_subdev_get_locked_active_state(&hi553->sd);
+	const struct hi553_mode *mode = hi553_state_mode(hi553, state);
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK && mode) {
+		u32 max = mode->height + ctrl->val - HI553_EXPOSURE_OFFSET;
+
+		__v4l2_ctrl_modify_range(hi553->exposure,
+					 hi553->exposure->minimum, max,
+					 hi553->exposure->step,
+					 min(hi553->exposure->default_value,
+					     (s64)max));
+	}
+
+	/* Only touch the hardware while it is powered */
+	if (!pm_runtime_get_if_active(hi553->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(hi553->regmap, HI553_REG_EXPOSURE, ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		cci_write(hi553->regmap, HI553_REG_ANALOG_GAIN, ctrl->val,
+			  &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		if (mode)
+			cci_write(hi553->regmap, HI553_REG_FRAME_LENGTH,
+				  mode->height + ctrl->val, &ret);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(hi553->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops hi553_ctrl_ops = {
+	.s_ctrl = hi553_set_ctrl,
+};
+
+static int hi553_init_controls(struct hi553 *hi553)
+{
+	struct v4l2_ctrl_handler *hdl = &hi553->ctrls;
+	const struct hi553_mode *mode = hi553_find_mode(hi553, 0, 0);
+	struct v4l2_fwnode_device_properties props;
+	int ret;
+
+	ret = v4l2_fwnode_device_parse(hi553->dev, &props);
+	if (ret)
+		return ret;
+
+	v4l2_ctrl_handler_init(hdl, 8);
+
+	hi553->pixel_rate = v4l2_ctrl_new_std(hdl, &hi553_ctrl_ops,
+					      V4L2_CID_PIXEL_RATE,
+					      mode->pixel_rate,
+					      mode->pixel_rate, 1,
+					      mode->pixel_rate);
+
+	hi553->link_freq = v4l2_ctrl_new_int_menu(hdl, &hi553_ctrl_ops,
+						  V4L2_CID_LINK_FREQ,
+						  ARRAY_SIZE(hi553_link_freqs) - 1,
+						  mode->link_freq,
+						  hi553_link_freqs);
+
+	hi553->vblank = v4l2_ctrl_new_std(hdl, &hi553_ctrl_ops,
+					  V4L2_CID_VBLANK,
+					  mode->frame_length - mode->height,
+					  HI553_FRAME_LENGTH_MAX - mode->height,
+					  1, mode->frame_length - mode->height);
+
+	hi553->hblank = v4l2_ctrl_new_std(hdl, &hi553_ctrl_ops,
+					  V4L2_CID_HBLANK,
+					  mode->line_length - mode->width,
+					  mode->line_length - mode->width, 1,
+					  mode->line_length - mode->width);
+
+	hi553->exposure = v4l2_ctrl_new_std(hdl, &hi553_ctrl_ops,
+					    V4L2_CID_EXPOSURE,
+					    HI553_EXPOSURE_MIN,
+					    mode->frame_length -
+					    HI553_EXPOSURE_OFFSET,
+					    1, HI553_EXPOSURE_DEFAULT);
+
+	v4l2_ctrl_new_std(hdl, &hi553_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  HI553_ANA_GAIN_MIN, HI553_ANA_GAIN_MAX, 1,
+			  HI553_ANA_GAIN_DEFAULT);
+
+	v4l2_ctrl_new_fwnode_properties(hdl, &hi553_ctrl_ops, &props);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		v4l2_ctrl_handler_free(hdl);
+		return ret;
+	}
+
+	hi553->pixel_rate->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	hi553->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	hi553->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	hi553->sd.ctrl_handler = hdl;
+
+	return 0;
+}
+
+static int hi553_enable_streams(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state, u32 pad,
+				u64 streams_mask)
+{
+	struct hi553 *hi553 = to_hi553(sd);
+	const struct hi553_mode *mode = hi553_state_mode(hi553, state);
+	int ret;
+
+	if (!mode)
+		return -EINVAL;
+
+	ret = pm_runtime_resume_and_get(hi553->dev);
+	if (ret)
+		return ret;
+
+	/*
+	 * LG's mm-camera order: the pre-init block, the three SRAM loads, the
+	 * init list, then the mode list.  LG's arrays carry a 1 ms delay after
+	 * each list, kept here.
+	 */
+	ret = cci_multi_reg_write(hi553->regmap, hi553_init_pre,
+				  ARRAY_SIZE(hi553_init_pre), NULL);
+	usleep_range(1000, 1100);
+	if (!ret)
+		ret = cci_multi_reg_write(hi553->regmap, hi553_init_ram_a,
+					  ARRAY_SIZE(hi553_init_ram_a), NULL);
+	if (!ret)
+		ret = cci_multi_reg_write(hi553->regmap, hi553_init_ram_b,
+					  ARRAY_SIZE(hi553_init_ram_b), NULL);
+	if (!ret)
+		ret = cci_multi_reg_write(hi553->regmap, hi553_init_ram_c,
+					  ARRAY_SIZE(hi553_init_ram_c), NULL);
+	usleep_range(1000, 1100);
+	if (!ret)
+		ret = cci_multi_reg_write(hi553->regmap, hi553_init,
+					  ARRAY_SIZE(hi553_init), NULL);
+	usleep_range(1000, 1100);
+	if (!ret)
+		ret = cci_multi_reg_write(hi553->regmap, mode->regs,
+					  mode->num_regs, NULL);
+	if (ret) {
+		dev_err(hi553->dev, "failed to program the sensor: %d\n", ret);
+		goto err_put;
+	}
+
+	ret = __v4l2_ctrl_handler_setup(&hi553->ctrls);
+	if (ret)
+		goto err_put;
+
+	ret = cci_write(hi553->regmap, HI553_REG_MODE_SELECT,
+			HI553_MODE_STREAMING, NULL);
+	if (ret)
+		goto err_put;
+
+	return 0;
+
+err_put:
+	pm_runtime_put(hi553->dev);
+	return ret;
+}
+
+static int hi553_disable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct hi553 *hi553 = to_hi553(sd);
+	int ret;
+
+	ret = cci_write(hi553->regmap, HI553_REG_MODE_SELECT,
+			HI553_MODE_STANDBY, NULL);
+
+	pm_runtime_put(hi553->dev);
+
+	return ret;
+}
+
+static void hi553_fill_format(struct hi553 *hi553,
+			      struct v4l2_mbus_framefmt *fmt,
+			      const struct hi553_mode *mode)
+{
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->code = hi553_mbus_code(hi553);
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int hi553_enum_mbus_code(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index >= ARRAY_SIZE(hi553_mbus_codes))
+		return -EINVAL;
+
+	code->code = hi553_mbus_codes[code->index];
+
+	return 0;
+}
+
+static int hi553_enum_frame_size(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct hi553 *hi553 = to_hi553(sd);
+	unsigned int i, n = 0;
+
+	if (fse->code != hi553_mbus_code(hi553))
+		return -EINVAL;
+
+	for (i = 0; i < ARRAY_SIZE(hi553_modes); i++) {
+		const struct hi553_mode *mode = &hi553_modes[i];
+
+		if (!hi553_mode_usable(hi553, mode))
+			continue;
+		if (n++ != fse->index)
+			continue;
+
+		fse->min_width = mode->width;
+		fse->max_width = mode->width;
+		fse->min_height = mode->height;
+		fse->max_height = mode->height;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int hi553_set_format(struct v4l2_subdev *sd,
+			    struct v4l2_subdev_state *state,
+			    struct v4l2_subdev_format *format)
+{
+	struct hi553 *hi553 = to_hi553(sd);
+	const struct hi553_mode *mode;
+
+	mode = hi553_find_mode(hi553, format->format.width,
+			       format->format.height);
+	if (!mode)
+		return -EINVAL;
+
+	hi553_fill_format(hi553, &format->format, mode);
+	*v4l2_subdev_state_get_format(state, 0) = format->format;
+	*v4l2_subdev_state_get_crop(state, 0) = mode->crop;
+
+	if (format->which == V4L2_SUBDEV_FORMAT_ACTIVE)
+		hi553_update_limits(hi553, mode);
+
+	return 0;
+}
+
+static int hi553_get_selection(struct v4l2_subdev *sd,
+			       struct v4l2_subdev_state *state,
+			       struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = HI553_NATIVE_WIDTH;
+		sel->r.height = HI553_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int hi553_init_state(struct v4l2_subdev *sd,
+			    struct v4l2_subdev_state *state)
+{
+	struct hi553 *hi553 = to_hi553(sd);
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.format = {
+			.width = hi553_modes[0].width,
+			.height = hi553_modes[0].height,
+		},
+	};
+
+	return hi553_set_format(&hi553->sd, state, &fmt);
+}
+
+static const struct v4l2_subdev_video_ops hi553_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops hi553_pad_ops = {
+	.enum_mbus_code = hi553_enum_mbus_code,
+	.enum_frame_size = hi553_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = hi553_set_format,
+	.get_selection = hi553_get_selection,
+	.enable_streams = hi553_enable_streams,
+	.disable_streams = hi553_disable_streams,
+};
+
+static const struct v4l2_subdev_ops hi553_subdev_ops = {
+	.video = &hi553_video_ops,
+	.pad = &hi553_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops hi553_internal_ops = {
+	.init_state = hi553_init_state,
+};
+
+static int hi553_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct hi553 *hi553 = to_hi553(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(hi553->supplies),
+				    hi553->supplies);
+	if (ret) {
+		dev_err(dev, "failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+
+	usleep_range(1000, 2000);
+
+	ret = clk_prepare_enable(hi553->xclk);
+	if (ret) {
+		dev_err(dev, "failed to enable clock: %d\n", ret);
+		goto err_regulators;
+	}
+
+	gpiod_set_value_cansleep(hi553->reset_gpio, 0);
+	usleep_range(10000, 11000);
+
+	return 0;
+
+err_regulators:
+	regulator_bulk_disable(ARRAY_SIZE(hi553->supplies), hi553->supplies);
+	return ret;
+}
+
+static int hi553_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct hi553 *hi553 = to_hi553(sd);
+
+	gpiod_set_value_cansleep(hi553->reset_gpio, 1);
+	clk_disable_unprepare(hi553->xclk);
+	regulator_bulk_disable(ARRAY_SIZE(hi553->supplies), hi553->supplies);
+
+	return 0;
+}
+
+static int hi553_parse_endpoint(struct hi553 *hi553)
+{
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *ep;
+	int ret;
+
+	ep = fwnode_graph_get_next_endpoint(dev_fwnode(hi553->dev), NULL);
+	if (!ep)
+		return dev_err_probe(hi553->dev, -ENXIO, "no endpoint\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return dev_err_probe(hi553->dev, ret,
+				     "failed to parse endpoint\n");
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != 2) {
+		ret = dev_err_probe(hi553->dev, -EINVAL,
+				    "only 2 data lanes are supported\n");
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(hi553->dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       hi553_link_freqs,
+				       ARRAY_SIZE(hi553_link_freqs),
+				       &hi553->link_freq_bitmap);
+
+out:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+	return ret;
+}
+
+static int hi553_identify(struct hi553 *hi553)
+{
+	u64 id;
+	int ret;
+
+	ret = cci_read(hi553->regmap, HI553_REG_CHIP_ID, &id, NULL);
+	if (ret)
+		return dev_err_probe(hi553->dev, ret,
+				     "failed to read the chip ID\n");
+
+	if (id != HI553_CHIP_ID)
+		return dev_err_probe(hi553->dev, -ENODEV,
+				     "unexpected chip ID 0x%04llx\n", id);
+
+	return 0;
+}
+
+static int hi553_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct hi553 *hi553;
+	unsigned int i;
+	int ret;
+
+	hi553 = devm_kzalloc(dev, sizeof(*hi553), GFP_KERNEL);
+	if (!hi553)
+		return -ENOMEM;
+
+	hi553->dev = dev;
+
+	ret = hi553_parse_endpoint(hi553);
+	if (ret)
+		return ret;
+
+	hi553->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(hi553->regmap))
+		return dev_err_probe(dev, PTR_ERR(hi553->regmap),
+				     "failed to initialize CCI\n");
+
+	hi553->xclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(hi553->xclk))
+		return dev_err_probe(dev, PTR_ERR(hi553->xclk),
+				     "failed to get the clock\n");
+
+	if (clk_get_rate(hi553->xclk) != HI553_XCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "the clock must run at %u Hz\n",
+				     HI553_XCLK_FREQ);
+
+	for (i = 0; i < ARRAY_SIZE(hi553_supply_names); i++)
+		hi553->supplies[i].supply = hi553_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(hi553->supplies),
+				      hi553->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	hi553->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						    GPIOD_OUT_HIGH);
+	if (IS_ERR(hi553->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(hi553->reset_gpio),
+				     "failed to get the reset GPIO\n");
+
+	v4l2_i2c_subdev_init(&hi553->sd, client, &hi553_subdev_ops);
+	hi553->sd.internal_ops = &hi553_internal_ops;
+
+	ret = hi553_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = hi553_identify(hi553);
+	if (ret)
+		goto err_power_off;
+
+	ret = hi553_init_controls(hi553);
+	if (ret)
+		goto err_power_off;
+
+	hi553->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	hi553->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	hi553->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&hi553->sd.entity, 1, &hi553->pad);
+	if (ret)
+		goto err_ctrls;
+
+	hi553->sd.state_lock = hi553->ctrls.lock;
+	ret = v4l2_subdev_init_finalize(&hi553->sd);
+	if (ret)
+		goto err_entity;
+
+	pm_runtime_set_active(dev);
+	/*
+	 * No autosuspend: like the IMX351, the sensor powers down as soon as
+	 * its stream stops.  Keeping it (and the CCI) powered across an idle
+	 * gap while the next stream is set up hangs the SoC.
+	 */
+	pm_runtime_enable(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&hi553->sd);
+	if (ret)
+		goto err_pm;
+
+	pm_runtime_idle(dev);
+
+	return 0;
+
+err_pm:
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+	v4l2_subdev_cleanup(&hi553->sd);
+err_entity:
+	media_entity_cleanup(&hi553->sd.entity);
+err_ctrls:
+	v4l2_ctrl_handler_free(&hi553->ctrls);
+err_power_off:
+	hi553_power_off(dev);
+	return ret;
+}
+
+static void hi553_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct hi553 *hi553 = to_hi553(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&hi553->ctrls);
+
+	pm_runtime_disable(hi553->dev);
+	if (!pm_runtime_status_suspended(hi553->dev))
+		hi553_power_off(hi553->dev);
+	pm_runtime_set_suspended(hi553->dev);
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(hi553_pm_ops, hi553_power_off,
+				 hi553_power_on, NULL);
+
+static const struct of_device_id hi553_of_match[] = {
+	{ .compatible = "hynix,hi553" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, hi553_of_match);
+
+static struct i2c_driver hi553_i2c_driver = {
+	.driver = {
+		.name = "hi553",
+		.of_match_table = hi553_of_match,
+		.pm = pm_ptr(&hi553_pm_ops),
+	},
+	.probe = hi553_probe,
+	.remove = hi553_remove,
+};
+module_i2c_driver(hi553_i2c_driver);
+
+MODULE_DESCRIPTION("Hynix HI553 image sensor driver");
+MODULE_LICENSE("GPL");
