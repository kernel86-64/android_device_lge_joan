 drivers/media/i2c/imx351.c        | 1251 +++++++++
 drivers/media/i2c/s5k3m3.c        | 1215 +++++++++
 7 files changed, 7324 insertions(+)
 create mode 100644 drivers/media/i2c/bu24235.c
 create mode 100644 drivers/media/i2c/hi553.c
 create mode 100644 drivers/media/i2c/imx351.c
 create mode 100644 drivers/media/i2c/s5k3m3.c

