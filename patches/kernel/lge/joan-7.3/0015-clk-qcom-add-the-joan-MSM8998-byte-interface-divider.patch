From 9df9eee91461609b2357d0c9a73307b7b45c9578 Mon Sep 17 00:00:00 2001
From: kernel86-64 <87580651+kernel86-64@users.noreply.github.com>
Date: Sun, 22 Nov 2026 14:17:39 +0300
Subject: [PATCH 15/57] clk: qcom: add the joan MSM8998 byte interface divider
 clocks

The donor MMCC driver selects MDSS_BYTE0/1_INTF_DIV_CLK (146/147), but the 7.3 upstream binding header ends at VMEM_AHB_CLK 145. Add the two port IDs carried by the joan clock support.
---
 include/dt-bindings/clock/qcom,mmcc-msm8998.h | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/include/dt-bindings/clock/qcom,mmcc-msm8998.h b/include/dt-bindings/clock/qcom,mmcc-msm8998.h
index ecbafdb93..e4b1f3fc2 100644
--- a/include/dt-bindings/clock/qcom,mmcc-msm8998.h
+++ b/include/dt-bindings/clock/qcom,mmcc-msm8998.h
@@ -152,6 +152,8 @@
 #define MNOC_MAXI_CLK					143
 #define VMEM_MAXI_CLK					144
 #define VMEM_AHB_CLK					145
+#define MDSS_BYTE0_INTF_DIV_CLK				146
+#define MDSS_BYTE1_INTF_DIV_CLK				147
 
 #define SPDM_BCR					0
 #define SPDM_RM_BCR					1
