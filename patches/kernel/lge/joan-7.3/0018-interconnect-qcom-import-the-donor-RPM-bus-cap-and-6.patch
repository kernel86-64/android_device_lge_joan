From c2a18ba8fee52c78d2ec6f7caf5e9d64e13e7301 Mon Sep 17 00:00:00 2001
From: kernel86-64 <87580651+kernel86-64@users.noreply.github.com>
Date: Sun, 22 Nov 2026 14:23:56 +0300
Subject: [PATCH 18/57] interconnect: qcom: import the donor RPM bus cap and
 64-bit bandwidth

Port the donor changes from 0086 (345e4ae6) and 0094 (c87d401f): send RPM bandwidth as a 64-bit value and add the per-provider bus_clk_max_rate cap used by MSM8998. The cap also limits the INT_MAX initial vote held until sync_state().
---
 drivers/interconnect/qcom/icc-rpm.c | 6 ++++++
 drivers/interconnect/qcom/icc-rpm.h | 9 ++++++++-
 drivers/interconnect/qcom/smd-rpm.c | 8 ++++----
 3 files changed, 18 insertions(+), 5 deletions(-)

diff --git a/drivers/interconnect/qcom/icc-rpm.c b/drivers/interconnect/qcom/icc-rpm.c
index ca4c8a944..76dc00cb8 100644
--- a/drivers/interconnect/qcom/icc-rpm.c
+++ b/drivers/interconnect/qcom/icc-rpm.c
@@ -396,6 +396,11 @@ static int qcom_icc_set(struct icc_node *src, struct icc_node *dst)
 	active_rate = min_t(u64, active_rate, INT_MAX);
 	sleep_rate = min_t(u64, sleep_rate, INT_MAX);
 
+	if (qp->bus_clk_max_rate) {
+		active_rate = min_t(u64, active_rate, qp->bus_clk_max_rate);
+		sleep_rate = min_t(u64, sleep_rate, qp->bus_clk_max_rate);
+	}
+
 	if (active_rate != qp->bus_clk_rate[QCOM_SMD_RPM_ACTIVE_STATE]) {
 		ret = qcom_icc_rpm_set_bus_rate(qp->bus_clk_desc, QCOM_SMD_RPM_ACTIVE_STATE,
 						active_rate);
@@ -484,6 +489,7 @@ int qnoc_probe(struct platform_device *pdev)
 		return -ENOMEM;
 
 	qp->num_intf_clks = cd_num;
+	qp->bus_clk_max_rate = desc->bus_clk_max_rate;
 
 	if (desc->bus_clk_desc) {
 		qp->bus_clk_desc = devm_kzalloc(dev, sizeof(*qp->bus_clk_desc),
diff --git a/drivers/interconnect/qcom/icc-rpm.h b/drivers/interconnect/qcom/icc-rpm.h
index cdd5f444b..fe874173d 100644
--- a/drivers/interconnect/qcom/icc-rpm.h
+++ b/drivers/interconnect/qcom/icc-rpm.h
@@ -61,6 +61,7 @@ struct qcom_icc_provider {
 	u16 ab_coeff;
 	u16 ib_coeff;
 	u32 bus_clk_rate[QCOM_SMD_RPM_STATE_NUM];
+	u32 bus_clk_max_rate;
 	const struct rpm_clk_resource *bus_clk_desc;
 	struct clk *bus_clk;
 	bool keep_alive;
@@ -133,6 +134,12 @@ struct qcom_icc_desc {
 	size_t num_intf_clocks;
 	bool keep_alive;
 	enum qcom_icc_type type;
+	/*
+	 * Highest bus clock (kHz) to request from the RPM, 0 for no limit:
+	 * keeps an unstable top step out of reach, including the INT_MAX
+	 * initial vote held until sync_state().
+	 */
+	u32 bus_clk_max_rate;
 	const struct regmap_config *regmap_cfg;
 	unsigned int qos_offset;
 	u16 ab_coeff;
@@ -167,7 +174,7 @@ int qnoc_probe(struct platform_device *pdev);
 void qnoc_remove(struct platform_device *pdev);
 
 bool qcom_icc_rpm_smd_available(void);
-int qcom_icc_rpm_smd_send(int ctx, int rsc_type, int id, u32 val);
+int qcom_icc_rpm_smd_send(int ctx, int rsc_type, int id, u64 val);
 int qcom_icc_rpm_set_bus_rate(const struct rpm_clk_resource *clk, int ctx, u32 rate);
 
 #endif
diff --git a/drivers/interconnect/qcom/smd-rpm.c b/drivers/interconnect/qcom/smd-rpm.c
index dbc7ae50b..6ac9aef94 100644
--- a/drivers/interconnect/qcom/smd-rpm.c
+++ b/drivers/interconnect/qcom/smd-rpm.c
@@ -20,7 +20,7 @@ static struct qcom_smd_rpm *icc_smd_rpm;
 struct icc_rpm_smd_req {
 	__le32 key;
 	__le32 nbytes;
-	__le32 value;
+	__le64 value;
 };
 
 bool qcom_icc_rpm_smd_available(void)
@@ -29,12 +29,12 @@ bool qcom_icc_rpm_smd_available(void)
 }
 EXPORT_SYMBOL_GPL(qcom_icc_rpm_smd_available);
 
-int qcom_icc_rpm_smd_send(int ctx, int rsc_type, int id, u32 val)
+int qcom_icc_rpm_smd_send(int ctx, int rsc_type, int id, u64 val)
 {
 	struct icc_rpm_smd_req req = {
 		.key = cpu_to_le32(RPM_KEY_BW),
-		.nbytes = cpu_to_le32(sizeof(u32)),
-		.value = cpu_to_le32(val),
+		.nbytes = cpu_to_le32(sizeof(u64)),
+		.value = cpu_to_le64(val),
 	};
 
 	return qcom_rpm_smd_write(icc_smd_rpm, ctx, rsc_type, id, &req,
