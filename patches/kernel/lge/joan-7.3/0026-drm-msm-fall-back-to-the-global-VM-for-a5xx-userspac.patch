From cb83c7486a01ce709fcf35e2f3b663d43370a292 Mon Sep 17 00:00:00 2001
From: scada <scada@noreply.codeberg.org>
Date: Sun, 22 Nov 2026 16:05:24 +0300
Subject: [PATCH 26/59] drm/msm: fall back to the global VM for a5xx userspace
 submits

A5XX has no create_private_vm callback. The 7.3 path returned NULL for non-kernel-managed submissions, while 6.18 always falls back to gpu->vm. The GPU then read buffers through an address space that had no mapping and raised translation faults.
---
 drivers/gpu/drm/msm/msm_gpu.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/msm/msm_gpu.c b/drivers/gpu/drm/msm/msm_gpu.c
index 0c2c35636..03c057856 100644
--- a/drivers/gpu/drm/msm/msm_gpu.c
+++ b/drivers/gpu/drm/msm/msm_gpu.c
@@ -879,7 +879,7 @@ msm_gpu_create_private_vm(struct msm_gpu *gpu, struct task_struct *task,
 			to_msm_vm(vm)->pid = get_pid(task_pid(task));
 	}
 
-	if (IS_ERR_OR_NULL(vm) && kernel_managed)
+	if (IS_ERR_OR_NULL(vm))
 		vm = drm_gpuvm_get(gpu->vm);
 
 	return vm;
