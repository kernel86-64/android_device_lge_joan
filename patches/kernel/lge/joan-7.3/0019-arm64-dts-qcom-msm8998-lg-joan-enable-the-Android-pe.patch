From 227dc03b71adc8c59632f5468eb2e58d9b9337e9 Mon Sep 17 00:00:00 2001
From: scada <scada@noreply.codeberg.org>
Date: Sun, 22 Nov 2026 14:51:08 +0300
Subject: [PATCH 19/57] arm64: dts: qcom: msm8998-lg-joan: enable the Android
 peripherals

Recovery used a minimal USB3-only, fixed-peripheral setup. For Android, restore the PMI8998 VBUS regulator and Type-C port, let DWC3 switch roles through the port, add the QMP orientation switch, enable the Adreno 540 GPU, and keep the ADSP on the joan_rprocs late-boot contract.
---
 arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts | 24 ++++++++++++++------
 1 file changed, 17 insertions(+), 7 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts b/arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts
index 258d28ca3..c66674f56 100644
--- a/arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts
+++ b/arch/arm64/boot/dts/qcom/msm8998-lg-joan.dts
@@ -599,12 +599,12 @@ &pm8998_resin {
 &pmi8998_vbus {
 	regulator-min-microamp = <1250000>;
 	regulator-max-microamp = <1250000>;
-	status = "disabled";
+	status = "okay";
 };
 
 &pmi8998_typec {
 	vdd-pdphy-supply = <&vreg_l24a_3p075>;
-	status = "disabled";
+	status = "okay";
 
 	connector {
 		compatible = "usb-c-connector";
@@ -1209,12 +1209,14 @@ &usb3 {
 
 &usb3_dwc3 {
 	/*
-	 * Recovery uses the base 7.3 USB3-only QMP PHY and a fixed peripheral
-	 * role. The donor's USB3+DP combo path and the PMI8998 Type-C role
-	 * switch are enabled separately for the Android port.
+	 * The data role comes from the PMI8998 Type-C port.  Whenever no role
+	 * is set -- nothing attached, or the port driver not loaded -- dwc3
+	 * stays a gadget, so the RAM-boot USB console does not depend on it.
 	 */
 	phys = <&qusb2phy>, <&usb3phy>;
-	dr_mode = "peripheral";
+	dr_mode = "otg";
+	usb-role-switch;
+	role-switch-default-mode = "peripheral";
 };
 
 &usb3_dwc3_hs {
@@ -1225,6 +1227,8 @@ &usb3phy {
 	vdda-phy-supply = <&vreg_l1a_0p875>;
 	vdda-pll-supply = <&vreg_l2a_1p2>;
 
+	orientation-switch;
+
 	status = "okay";
 };
 
@@ -1625,7 +1629,7 @@ &spss_mem {
  * early-probe images used here).
  */
 &adreno_gpu {
-	status = "disabled";
+	status = "okay";
 
 	vdd-supply = <&pm8005_s1>;
 
@@ -1887,6 +1891,12 @@ swm: soundwire@c85 {
 };
 
 &remoteproc_adsp {
+	/*
+	 * joan_rprocs.sh starts the ADSP once the filesystem services and
+	 * Wi-Fi are ready; the SLPI shares the driver and must boot early,
+	 * before the framework reads the sensor list.
+	 */
+	qcom,no-auto-boot;
 	firmware-name = "qcom/msm8998/joan/adsp.mdt";
 	status = "okay";
 };
