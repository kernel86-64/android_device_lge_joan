diff --git a/bluetooth/async/test/async_fd_watcher_unittest.cc b/bluetooth/async/test/async_fd_watcher_unittest.cc
index 6d75f10279..38d888312c 100644
--- a/bluetooth/async/test/async_fd_watcher_unittest.cc
+++ b/bluetooth/async/test/async_fd_watcher_unittest.cc
@@ -29,6 +29,8 @@
 
 #include <cstdint>
 #include <cstring>
+#include <future>
+#include <memory>
 #include <vector>
 
 namespace android::hardware::bluetooth::async_test {
@@ -374,4 +376,34 @@ TEST_F(AsyncFdWatcherSocketTest, RepeatedTimeOutTest) {
   CleanUpServer();
 }
 
+static void CheckEofStopAndRestart(bool owner_stops_before_restart) {
+  AsyncFdWatcher watcher;
+  for (int generation = 0; generation != 2; ++generation) {
+    int sockets[2];
+    ASSERT_EQ(0, socketpair(AF_LOCAL, SOCK_STREAM, 0, sockets));
+    auto stopped = std::make_shared<std::promise<void>>();
+    auto stopped_future = stopped->get_future();
+    ASSERT_EQ(0, watcher.WatchFdForNonBlockingReads(sockets[0], [&watcher, stopped](int fd) {
+      char value;
+      ASSERT_EQ(0, read(fd, &value, 1));
+      watcher.StopWatchingFileDescriptors();
+      stopped->set_value();
+    }));
+    close(sockets[1]);
+    ASSERT_EQ(std::future_status::ready,
+              stopped_future.wait_for(std::chrono::seconds(1)));
+    if (owner_stops_before_restart) watcher.StopWatchingFileDescriptors();
+    close(sockets[0]);
+  }
+  watcher.StopWatchingFileDescriptors();
+}
+
+TEST(AsyncFdWatcherLifecycleTest, EofCallbackStopThenOwnerCloseAndReopen) {
+  CheckEofStopAndRestart(true);
+}
+
+TEST(AsyncFdWatcherLifecycleTest, EofCallbackStopThenOwnerReopen) {
+  CheckEofStopAndRestart(false);
+}
+
 }  // namespace android::hardware::bluetooth::async_test
