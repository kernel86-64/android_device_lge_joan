-ndk::ScopedAStatus CameraDevice::turnOnTorchWithStrengthLevel(int32_t) {
-    return fromStatus(Status::OPERATION_NOT_SUPPORTED);
+/*
+ * camera_module_t has no torch strength entry; modules that support it
+ * export camera_module_{set,get}_torch_strength() from their DSO.
+ */
+ndk::ScopedAStatus CameraDevice::turnOnTorchWithStrengthLevel(int32_t torchStrength) {
+    using SetFn = int (*)(const char*, int);
+    auto set = reinterpret_cast<SetFn>(
+            dlsym(mModule->getDso(), "camera_module_set_torch_strength"));
+    if (!set) {
+        return fromStatus(Status::OPERATION_NOT_SUPPORTED);
+    }
+
+    Status status = initStatus();
+    if (status == Status::OK) {
+        status = getAidlStatus(set(mCameraId.c_str(), torchStrength));
+    }
+    return fromStatus(status);
 }
 
-ndk::ScopedAStatus CameraDevice::getTorchStrengthLevel(int32_t*) {
-    return fromStatus(Status::OPERATION_NOT_SUPPORTED);
+ndk::ScopedAStatus CameraDevice::getTorchStrengthLevel(int32_t* _aidl_return) {
+    using GetFn = int (*)(const char*, int*);
+    auto get = reinterpret_cast<GetFn>(
+            dlsym(mModule->getDso(), "camera_module_get_torch_strength"));
+    if (!get) {
+        return fromStatus(Status::OPERATION_NOT_SUPPORTED);
+    }
+
+    Status status = initStatus();
+    if (status == Status::OK) {
+        status = getAidlStatus(get(mCameraId.c_str(), _aidl_return));
+    }
+    return fromStatus(status);
 }
 
