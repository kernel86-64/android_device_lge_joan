UsbService: instantiate the device manager for configfs UDC gadgets

Mainline configfs gadgets expose a UDC (sys.usb.controller) without the
android_usb compatibility class, so the USB device manager never started.

diff --git a/services/usb/java/com/android/server/usb/UsbService.java b/services/usb/java/com/android/server/usb/UsbService.java
index ce7ae67..7b3b97c 100644
--- a/services/usb/java/com/android/server/usb/UsbService.java
+++ b/services/usb/java/com/android/server/usb/UsbService.java
@@ -239,7 +239,13 @@ public class UsbService extends IUsbManager.Stub {
             mAuthManager = new UsbAuthManager(context, mUserManager, mHostManager);
             mHostManager.setAuthManager(mAuthManager);
         }
-        if (new File("/sys/class/android_usb").exists()) {
+        // Mainline configfs gadgets expose a UDC, without the android_usb
+        // compatibility class. Instantiate the manager for that controller
+        // too, otherwise function requests and UDC monitoring never start.
+        final String usbController = SystemProperties.get("sys.usb.controller", "");
+        final boolean hasUdc = !usbController.isEmpty()
+                && new File("/sys/class/udc", usbController).isDirectory();
+        if (new File("/sys/class/android_usb").exists() || hasUdc) {
             mDeviceManager = new UsbDeviceManager(context, mAlsaManager, mSettingsManager,
                     mPermissionManager);
         }
