cc_library_shared {
    name: "audio.primary.joan",
    relative_install_path: "hw",
    vendor: true,
    srcs: ["audio_hw.c"],
    header_libs: ["libhardware_headers"],
    shared_libs: [
        "libaudioroute",
        "libcutils",
        "liblog",
        "libtinyalsa",
    ],
    cflags: ["-Wall", "-Werror"],
}
