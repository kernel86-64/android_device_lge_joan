type tqftpserv, domain;
type tqftpserv_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(tqftpserv)

type tqftpserv_data_file, file_type, data_file_type;

allow tqftpserv self:qipcrtr_socket create_socket_perms_no_ioctl;
allow tqftpserv firmware_file:dir r_dir_perms;
allow tqftpserv firmware_file:file r_file_perms;
allow tqftpserv tqftpserv_data_file:dir create_dir_perms;
allow tqftpserv tqftpserv_data_file:file create_file_perms;
