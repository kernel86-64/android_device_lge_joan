type joan_btaddr, domain;
type joan_btaddr_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(joan_btaddr)

allow joan_btaddr self:bluetooth_socket create_socket_perms_no_ioctl;
allow joan_btaddr self:capability net_admin;
allow joan_btaddr sysfs:dir r_dir_perms;
allow joan_btaddr sysfs:file r_file_perms;
