type netmgrd, domain;
type netmgrd_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(netmgrd)

net_domain(netmgrd)
allow netmgrd self:qipcrtr_socket create_socket_perms_no_ioctl;
allow netmgrd self:capability { net_admin net_raw setuid setgid };
allow netmgrd self:netlink_route_socket { create_socket_perms_no_ioctl nlmsg_write };
