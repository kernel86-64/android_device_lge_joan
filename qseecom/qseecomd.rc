on post-fs
    exec u:r:su:s0 root root -- /system/bin/sh /vendor/bin/joan_tz_boot.sh

on post-fs-data
    mkdir /data/vendor/tzstorage 0770 system system
    start vendor.qseecomd

service vendor.qseecomd /vendor/bin/qseecomd
    class core
    user root
    group root
    seclabel u:r:su:s0
    disabled
