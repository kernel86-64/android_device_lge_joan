# SPDX-License-Identifier: Apache-2.0
#
# LG V30 (joan) on the mainline kernel.
#

import /vendor/etc/init/hw/init.joan.usb.rc

on early-init
    # joan has no metadata partition. aconfigd keeps its flag storage under
    # /metadata/aconfig (rebuilt from the system images every boot); without
    # it every read-write flag reads false and system_server dies on flag-
    # gated permissions (android.permission.RANGING). A tmpfs is enough.
    mount tmpfs tmpfs /metadata nosuid nodev noexec mode=0771,uid=0,gid=1000
    restorecon /metadata
    # The in-kernel QRTR name service and pd-mapper come up with the kernel;
    # the remoteprocs that need them are started from init below.
    write /sys/block/zram0/comp_algorithm lz4

on init
    # Kernel HCI firmware setup/close can exceed Android's default budgets.
    # Set both native and outer BLE deadlines before framework startup.
    setprop bluetooth.gd.start_timeout 30000
    setprop bluetooth.gd.stop_timeout 30000
    setprop ro.bluetooth.ble_start_timeout_delay 40000
    setprop ro.bluetooth.ble_stop_timeout_delay 40000
    # Faster boot: large readahead and expedited RCU until boot_completed
    write /sys/block/sda/queue/read_ahead_kb 2048
    write /sys/kernel/rcu_expedited 1
    # Drivers that load firmware at probe are modules (see joan_defconfig).
    # The modem (qcom_q6v5_mss) and the ADSP (qcom_q6v5_pas) are NOT loaded
    # here: started at ~5-13 s, before rmtfs/tqftpserv are running, both stall
    # in their own init and their watchdogs reset them in a loop for minutes
    # (see rootdir/bin/joan_rprocs.sh). joan_rprocs loads them, and the QMI
    # clients that need them (ath10k, SLIMbus NGD), after boot_completed.
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -a -d /vendor/lib/modules \
        venus_core venus_dec venus_enc ipa hci_uart
    write /dev/cpuset/foreground/cpus 0-7
    write /dev/cpuset/background/cpus 0-3
    write /dev/cpuset/system-background/cpus 0-3
    write /dev/cpuset/top-app/cpus 0-7
    write /dev/cpuset/restricted/cpus 0-3

on fs
    mount_all /vendor/etc/fstab.joan --early
    swapon_all /vendor/etc/fstab.joan
    mkdir /mnt/vendor/persist/rmtfs 0770 system system

on late-fs
    mount_all /vendor/etc/fstab.joan --late

on post-fs-data
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    mkdir /data/vendor/tmp 0770 system system
    mkdir /data/vendor/tmp/tqftpserv 0770 system system
    mkdir /data/vendor/time 0770 system system
    # Start only after /data is mounted; capture existing log buffers as well.
    start joan_bootlog

on early-boot
    # GPU fences for drm_hwcomposer / Mesa.
    mount debugfs debugfs /sys/kernel/debug
    chmod 0755 /sys/kernel/debug
    # The dynamic_debug control file exists only after mounting debugfs.
    start joan_dyndbg
    # The power HAL waits for this signal before starting its hint worker.
    # CPU and GPU frequency nodes exist by this point in the boot sequence.
    setprop vendor.powerhal.init 1
    chown graphics graphics /sys/kernel/debug/sync/sw_sync
    chmod 0777 /sys/kernel/debug/sync/sw_sync

on boot
    # Backlight for the lights HAL.
    chown system system /sys/class/backlight/c994000.dsi.0/brightness
    chmod 0664 /sys/class/backlight/c994000.dsi.0/brightness
    # Start the modem: rmtfs serves its EFS from modemst1/modemst2/fsg.
    # rmtfs -s is deliberately not used: it would start the modem here, long
    # before it can be served; joan_rprocs starts it after boot_completed.
    start rmtfs
    start tqftpserv
    # The SLPI must be up before the framework reads the sensor list, and it
    # asks for its registry while it boots: publish the registry, then load
    # the PAS driver. The ADSP opts out of auto-boot (qcom,no-auto-boot in
    # the DT); joan_rprocs starts it later.
    start vendor.sns-reg
    exec_background u:r:vendor_modprobe:s0 root root -- /vendor/bin/modprobe -d /vendor/lib/modules qcom_q6v5_pas
    # Modem, ADSP and their QMI clients, once userspace is up.
    start joan_rprocs
    # Bluetooth: give the address-less WCN3990 a public BD address.
    start joan_btaddr

on property:sys.boot_completed=1
    # Mirroring logcat into the kernel log costs a lot of CPU; only boot needs it.
    stop logcat_kmsg
    write /dev/cpuset/background/cpus 0-1
    write /dev/cpuset/system-background/cpus 0-3
    swapon_all /vendor/etc/fstab.joan
    start joan_zram
    # Performance: zram-friendly swap readahead, faster schedutil ramps,
    # small UFS readahead once boot is done, no block I/O accounting.
    write /proc/sys/vm/page-cluster 0
    write /proc/sys/vm/swappiness 100
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/rate_limit_us 500
    # The big cluster's switches also move its DDR floor: no faster than 2 ms.
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/rate_limit_us 2000
    write /sys/block/sda/queue/read_ahead_kb 128
    write /sys/block/sdb/queue/read_ahead_kb 128
    write /sys/block/sdc/queue/read_ahead_kb 128
    write /sys/block/sdd/queue/read_ahead_kb 128
    write /sys/block/sde/queue/read_ahead_kb 128
    write /sys/block/sdf/queue/read_ahead_kb 128
    write /sys/block/sda/queue/iostats 0
    write /sys/block/sdb/queue/iostats 0
    write /sys/block/sdc/queue/iostats 0
    write /sys/block/sdd/queue/iostats 0
    write /sys/block/sde/queue/iostats 0
    write /sys/block/sdf/queue/iostats 0
    write /sys/kernel/rcu_expedited 0
    write /proc/sys/vm/watermark_boost_factor 0
    write /sys/block/sda/queue/add_random 0
    write /sys/block/sde/queue/add_random 0

on charger
    setprop vendor.powerhal.init 1

# Remote filesystem service for the modem (EFS on modemst1/modemst2/fsg).
service rmtfs /vendor/bin/rmtfs -o /dev/block/by-name -P -r
    class core
    user root
    group system
    disabled

# TFTP server the modem uses to read its config files.
service tqftpserv /vendor/bin/tqftpserv
    class core
    user root
    group system
    disabled

# The WCN3990 has no factory BD address; see btaddr/joan_btaddr.c.
service joan_btaddr /vendor/bin/joan_btaddr
    class core
    user root
    group bluetooth net_admin
    capabilities NET_ADMIN
    disabled
    oneshot

service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
        -Dnl80211 -O/data/vendor/wifi/wpa/sockets -g@android:wpa_wlan0
    interface aidl android.hardware.wifi.supplicant.ISupplicant/default
    socket wpa_wlan0 dgram 660 wifi wifi
    class main
    disabled
    oneshot

# Refresh a HAL that may have been requested before the late netdev appeared.
on property:vendor.joan.wlan.ready=1
    restart vendor.wifi_hal_legacy

# Late, traced bring-up of the modem, the ADSP and their QMI clients.
service joan_zram /system/bin/sh /vendor/bin/joan_zram.sh
    seclabel u:r:su:s0
    user root
    group root
    disabled
    oneshot

service joan_rprocs /system/bin/sh /vendor/bin/joan_rprocs.sh
    seclabel u:r:su:s0
    user root
    group root system net_admin net_raw
    disabled
    oneshot

# Bring-up debugging: mirror userspace logs to the kernel console.
service joan_dyndbg /system/bin/sh /vendor/bin/joan_dyndbg.sh
    seclabel u:r:su:s0
    user root
    disabled
    oneshot

service logcat_kmsg /system/bin/logcat -b main -b system -b crash -v brief -f /dev/kmsg *:I
    seclabel u:r:su:s0
    user root
    disabled
    oneshot

on property:init.svc.logd=running && property:ro.boot.joan.logcat_kmsg=1
    start logcat_kmsg

# Bring-up debugging: keep the kernel log and logcat on /data so a boot that
# wedges can be read afterwards. There is no /cache partition on joan, so the
# old /cache copy never wrote anything. Each boot gets its own directory named
# after boot_id, so a reset does not overwrite the log of the boot that wedged.
# pstore (ramoops) is copied out before anything else can clear it. Wait for
# /data, then run for an hour so a freeze minutes in is still captured.
#
# A hard reset loses whatever ext4 had not written back yet, which used to be
# the interesting last few seconds, so sync every minute. The directory is made
# world-readable immediately (not after an hour) so `adb shell` can read it
# without root, including from recovery.
service joan_bootlog /system/bin/sh /vendor/bin/joan_bootlog.sh
    seclabel u:r:su:s0
    user root
    disabled
    oneshot

# The PM8998 RTC is read-only; keep a wall-clock offset (timekeep/).
service joan_timekeep /vendor/bin/joan_timekeep
    class core
    user system
    group system
    capabilities SYS_TIME
    oneshot
