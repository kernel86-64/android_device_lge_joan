#
# LG V30 (joan) on the mainline kernel.
#

import /vendor/etc/init/hw/init.joan.usb.rc

on early-init
    # The in-kernel QRTR name service and pd-mapper come up with the kernel;
    # the remoteprocs that need them are started from init below.
    write /sys/block/zram0/comp_algorithm lz4

on init
    # Drivers that load firmware at probe are modules (see joan_defconfig):
    # remote processors first, then what talks to them.
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -a -d /vendor/lib/modules \
        qcom_q6v5_mss qcom_q6v5_pas venus_core venus_dec venus_enc ipa \
        hci_uart ath10k_snoc
    write /dev/cpuset/foreground/cpus 0-7
    write /dev/cpuset/background/cpus 0-3
    write /dev/cpuset/system-background/cpus 0-3
    write /dev/cpuset/top-app/cpus 0-7
    write /dev/cpuset/restricted/cpus 0-3

on fs
    mount_all /vendor/etc/fstab.joan --early
    swapon_all /vendor/etc/fstab.joan
    mkdir /mnt/vendor/persist/rmtfs 0770 system system

on late-fs
    mount_all /vendor/etc/fstab.joan --late

on post-fs-data
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    mkdir /data/vendor/tmp 0770 system system
    mkdir /data/vendor/tmp/tqftpserv 0770 system system

on early-boot
    # GPU fences for drm_hwcomposer / Mesa.
    mount debugfs debugfs /sys/kernel/debug
    chmod 0755 /sys/kernel/debug
    chown graphics graphics /sys/kernel/debug/sync/sw_sync
    chmod 0777 /sys/kernel/debug/sync/sw_sync

on boot
    # Backlight for the lights HAL.
    chown system system /sys/class/backlight/panel@0/brightness
    chmod 0664 /sys/class/backlight/panel@0/brightness
    # Start the modem: rmtfs serves its EFS from modemst1/modemst2/fsg.
    start rmtfs
    start tqftpserv

on property:sys.boot_completed=1
    write /dev/cpuset/background/cpus 0-1
    write /dev/cpuset/system-background/cpus 0-3
    swapon_all /vendor/etc/fstab.joan

# Remote filesystem service for the modem (EFS on modemst1/modemst2/fsg).
service rmtfs /vendor/bin/rmtfs -o /dev/block/by-name -P -r -s
    class core
    user root
    group system
    disabled

# TFTP server the modem uses to read its config files.
service tqftpserv /vendor/bin/tqftpserv
    class core
    user root
    group system
    disabled

service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
        -Dnl80211 -g@android:wpa_wlan0
    interface aidl android.hardware.wifi.supplicant.ISupplicant/default
    socket wpa_wlan0 dgram 660 wifi wifi
    class main
    disabled
    oneshot

# Bring-up debugging: mirror userspace logs to the kernel console.
service logcat_kmsg /system/bin/logcat -b main -b system -b crash -v brief -f /dev/kmsg *:I
    seclabel u:r:su:s0
    user root
    disabled
    oneshot

on property:init.svc.logd=running && property:ro.boot.joan.logcat_kmsg=1
    start logcat_kmsg
