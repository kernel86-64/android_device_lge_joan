// Firmware signed for the device comes from its read-only modem partition.
install_symlink {
    name: "joan_remoteproc_firmware",
    vendor: true,
    installed_location: "firmware/qcom/msm8998/joan",
    symlink_target: "/vendor/firmware_mnt/image",
}

install_symlink {
    name: "joan_wlan_dsp_firmware",
    vendor: true,
    installed_location: "firmware/wlanmdsp.mbn",
    symlink_target: "/vendor/firmware_mnt/image/wlanmdsp.mbn",
}

install_symlink {
    name: "joan_wlan_board_data",
    vendor: true,
    installed_location: "firmware/ath10k/WCN3990/hw1.0/board.bin",
    symlink_target: "/vendor/firmware_mnt/image/bdwlan.bin",
}

